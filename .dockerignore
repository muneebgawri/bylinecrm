# Build context for deploy/docker/*.Dockerfile. Keep it to what a build needs: no local
# state, no secrets, no test artefacts.
.git
**/node_modules
**/dist
**/.turbo
**/coverage
**/*.tsbuildinfo
**/.env
**/.env.*
.data
storybook-static
test-results
playwright-report
apps/web/e2e/__snapshots__
packages/ui/__snapshots__
apps/web/src/api/schema.gen.ts
apps/api/contract/generated
docs
parity
