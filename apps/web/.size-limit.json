[
    {
        "name": "initial JS (everything index.html loads before first paint, gzip)",
        "path": [
            "dist/assets/index-*.js",
            "dist/assets/vendor-*.js",
            "dist/assets/ui-*.js",
            "dist/assets/rolldown-runtime-*.js"
        ],
        "limit": "190 kB",
        "gzip": true
    },
    {
        "name": "stylesheet (gzip)",
        "path": "dist/assets/*.css",
        "limit": "40 kB",
        "gzip": true
    }
]
