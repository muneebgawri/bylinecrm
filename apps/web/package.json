{
    "name": "web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "generate:api": "openapi-typescript ../api/openapi.json -o src/api/schema.gen.ts",
        "build": "pnpm run generate:api && vite build",
        "dev": "vite",
        "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" --max-warnings 0",
        "typecheck": "pnpm run generate:api && tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "size": "size-limit",
        "test:routes": "playwright test -c e2e/playwright.config.ts",
        "test:routes:update": "playwright test -c e2e/playwright.config.ts --project phone-light --project phone-dark --update-snapshots",
        "routes:baseline": "node ../../scripts/visual-baseline.mjs --job routes-baseline --artifact routes-baselines --dir apps/web/e2e/__snapshots__"
    },
    "dependencies": {
        "@bylinecrm/shared": "workspace:*",
        "@bylinecrm/ui": "workspace:*",
        "@dnd-kit/core": "^6",
        "@dnd-kit/sortable": "^10",
        "@dnd-kit/utilities": "^3",
        "@tanstack/react-query": "^5.104.1",
        "@tanstack/react-table": "^8",
        "@tanstack/react-virtual": "^3",
        "@tiptap/extension-link": "^3",
        "@tiptap/react": "^3",
        "@tiptap/starter-kit": "^3",
        "lucide-react": "^1.53.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^7.18.4"
    },
    "devDependencies": {
        "@bylinecrm/eslint-config": "workspace:*",
        "@playwright/test": "^1.64.0",
        "@size-limit/file": "^14.2.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.19.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.2",
        "axe-playwright": "^2.2.2",
        "eslint": "^9.39.4",
        "jsdom": "^28.1.0",
        "openapi-typescript": "^7.13.0",
        "playwright": "^1.64.0",
        "size-limit": "^14.2.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.3.4",
        "vitest": "^4.1.11"
    }
}
