{
    "name": "api",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "nest build",
        "dev": "dotenv -e ../../.env -- nest start --watch",
        "start": "dotenv -e ../../.env -- node dist/main.js",
        "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"contract/*.ts\" \"*.mts\" --max-warnings 0",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cross-tenant": "dotenv -e ../../.env -- vitest run --config vitest.cross-tenant.config.mts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
        "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
        "db:ensure-role": "dotenv -e ../../.env -- node ../../scripts/db-ensure-app-role.mjs",
        "db:setup": "pnpm db:ensure-role && pnpm prisma:migrate:deploy",
        "openapi:write": "nest build && node dist/openapi/write.js && prettier --write openapi.json",
        "contract:check": "openapi-typescript openapi.json -o contract/generated/schema.d.ts && tsc -p contract/tsconfig.json"
    },
    "dependencies": {
        "@bylinecrm/shared": "workspace:*",
        "@nestjs/bullmq": "^11.0.5",
        "@nestjs/common": "^11.2.7",
        "@nestjs/core": "^11.2.7",
        "@nestjs/platform-express": "^11.2.7",
        "@nestjs/swagger": "^12.0.2",
        "@node-rs/argon2": "^2.2.2",
        "@prisma/client": "^6.19.3",
        "addressparser": "^1",
        "bullmq": "^6.3.11",
        "busboy": "1.6.0",
        "cookie-parser": "^1.4.7",
        "disposable-email-domains": "1.0.62",
        "express": "5.2.1",
        "htmlparser2": "^12",
        "ioredis": "^5.10.1",
        "jpeg-js": "^0.4",
        "libmime": "^5",
        "nestjs-zod": "^5.5.0",
        "openid-client": "^6.8.8",
        "pg": "^8.16.3",
        "pngjs": "^7",
        "prisma": "^6.19.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sanitize-html": "^2",
        "undici": "^7",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@bylinecrm/eslint-config": "workspace:*",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.7",
        "@swc/core": "^1.16.13",
        "@types/busboy": "^1.5.4",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/node": "^22.19.0",
        "@types/pngjs": "^6.0.5",
        "@types/sanitize-html": "^2",
        "@types/supertest": "^6.0.3",
        "dotenv-cli": "^10",
        "eslint": "^9.39.4",
        "openapi-fetch": "^0.17.0",
        "openapi-typescript": "^7.13.0",
        "supertest": "^7.3.1",
        "typescript": "^5.9.3",
        "unplugin-swc": "^2.0.0",
        "vitest": "^4.1.11"
    }
}
