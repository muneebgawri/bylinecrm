// BylineCRM data model. Every tenant table carries `workspace_id` and is under row-level
// security (see the P0-2 migration); the policies are the backstop, the route guard is the gate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant. Global table: the app role reads the current workspace's row, or a workspace the
/// signed-in user is a member of.
model Workspace {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  /// ISO 4217, upper case (the database checks): what a deal takes when the caller names no currency.
  defaultCurrency String   @default("USD") @map("default_currency") @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  members WorkspaceMember[]
  roles   Role[]
  apiKeys ApiKey[]
  invites WorkspaceInvite[]

  people                 Person[]
  companies              Company[]
  customFieldDefinitions CustomFieldDefinition[]
  opportunities          Opportunity[]
  notes                  Note[]
  noteTargets            NoteTarget[]
  tasks                  Task[]
  taskTargets            TaskTarget[]
  attachments            Attachment[]
  savedViews             SavedView[]
  timelineActivities     TimelineActivity[]
  outboxEvents           OutboxEvent[]
  pipelines              Pipeline[]
  pipelineStages         PipelineStage[]
  stageHistory           OpportunityStageHistory[]
  stageRules             StageRule[]
  webhookEndpoints       WebhookEndpoint[]
  webhookDeliveries      WebhookDelivery[]
  googleOAuthClient      GoogleOAuthClient?
  mailboxes              Mailbox[]
  emailTemplates         EmailTemplate[]
  mailSettings           WorkspaceMailSettings?
  mailThreads            MailThread[]
  mailMessages           MailMessage[]
  mailboxThreads         MailboxThread[]
  mailMessageCopies      MailMessageCopy[]
  mailParticipants       MailParticipant[]
  mailboxSyncStates      MailboxSyncState[]
  blocklistEntries       BlocklistEntry[]

  mailOutbound MailOutbound[]
  mailOutbox   MailOutbox[]

  suppressions      Suppression[]
  unsubscribeTokens UnsubscribeToken[]

  sendingPoolSettings SendingPoolSettings?
  sendingDomains      SendingDomain[]
  mailBounces         MailBounce[]

  regionPolicies            RegionPolicy[]
  regionPolicyChanges       RegionPolicyChange[]
  emailVerifications        EmailVerification[]
  emailVerificationSettings EmailVerificationSettings?
  enrichmentAnswers         EnrichmentAnswer[]
  enrichmentSettings        EnrichmentSettings?
  outreachExclusions        OutreachExclusion[]
  sequences                 Sequence[]
  sequenceSteps             SequenceStep[]
  sequenceEnrolments        SequenceEnrolment[]

  twentyImportSettings TwentyImportSettings?
  twentyImportRuns     TwentyImportRun[]
  twentyImportLinks    TwentyImportLink[]

  trackingDomain TrackingDomain?
  trackingTokens TrackingToken[]
  trackingHits   TrackingHit[]

  @@map("workspaces")
}

/// A person who can sign in. Global table, written only by AuthService through the owner client.
/// `email` is stored lower-cased by the application and unique as stored. `passwordHash` is null
/// for a user who only ever signed in through an identity provider.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String?   @map("password_hash")
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz
  /// How the person is shown to other members, in every workspace; pickers read it, never the email.
  displayName        String?   @map("display_name")
  /// When the person confirmed their name (saved, or kept the suggestion); `null` asks once.
  profileCompletedAt DateTime? @map("profile_completed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships   WorkspaceMember[]
  sessions      Session[]
  identities    ExternalIdentity[]
  oneTimeTokens OneTimeToken[]

  platformWorkspaceInvites WorkspaceInvite[]      @relation("PlatformWorkspaceInvites")
  platformSignupInvites    PlatformSignupInvite[]

  @@map("users")
}

/// What a mailed single-use link is for (#93). #101 adds `set_password`.
enum OneTimeTokenPurpose {
  email_verification
  password_reset
}

/// A mailed single-use link (#93): verify an address, reset a password. Only the secret's hash is
/// stored. Global and owner-client only, like `sessions`: it is read before any workspace is known,
/// and the app role has no grant on it. One live link per user and purpose — issuing a new one
/// deletes the unspent ones.
model OneTimeToken {
  id        String              @id @default(uuid()) @db.Uuid
  purpose   OneTimeTokenPurpose
  userId    String              @map("user_id") @db.Uuid
  /// The address the link was mailed to; verification succeeds only while it is still the account's.
  email     String
  tokenHash String              @unique @map("token_hash")
  expiresAt DateTime            @map("expires_at") @db.Timestamptz
  usedAt    DateTime?           @map("used_at") @db.Timestamptz
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("one_time_tokens")
}

/// Transactional mail owed (#93): written in the transaction that makes the mail necessary, sent by
/// `MailOutboxRelay` after the commit, at least once (the provider's idempotency key makes it once).
/// `sealed` is the whole message sealed with `SecretBox` — it carries a single-use link — and is
/// wiped when the mail is sent or given up on. `workspace_id` is set for a workspace's own mail (an
/// invitation, written by the app role under RLS, INSERT only) and null for an account's (verify,
/// reset, written by the owner client). Delivery state is the relay's, as the owner.
model MailOutbox {
  id                String    @id @db.Uuid
  /// Insertion order, for the relay's scan.
  seq               BigInt    @unique @default(autoincrement())
  workspaceId       String?   @map("workspace_id") @db.Uuid
  kind              String
  /// The mail's identity; a second record of the same mail is dropped.
  idempotencyKey    String    @unique @map("idempotency_key")
  sealed            String
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  attempts          Int       @default(0)
  nextAttemptAt     DateTime? @map("next_attempt_at") @db.Timestamptz
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz
  lastError         String?   @map("last_error")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz
  providerMessageId String?   @map("provider_message_id")
  failedAt          DateTime? @map("failed_at") @db.Timestamptz

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sentAt])
  @@map("mail_outbox")
}

/// A signed-in browser. The cookie carries a random token; only its hash is stored. Global table
/// out of the app role's reach: sessions are read before any workspace is known, by the auth layer.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  /// The session this one replaced on rotation, kept for the audit trail.
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A user's account at an identity provider (Google, or any OIDC issuer the operator configured).
/// Global, owner-only, like sessions.
model ExternalIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// The issuer key from configuration (`google`, or the operator's name for an OIDC issuer).
  provider  String
  /// The provider's stable subject identifier for the user.
  subject   String
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("external_identities")
}

/// A user's seat in a workspace, with the role that decides what they may do there.
model WorkspaceMember {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id])

  createdApiKeys         ApiKey[]
  createdWebhooks        WebhookEndpoint[]
  sentInvites            WorkspaceInvite[]
  ownedPeople            Person[]
  ownedCompanies         Company[]
  ownedOpportunities     Opportunity[]
  authoredNotes          Note[]
  assignedTasks          Task[]
  authoredAttachments    Attachment[]
  savedViews             SavedView[]
  resumedMailboxes       Mailbox[]           @relation("MailboxResumedBy")
  configuredOAuthClients GoogleOAuthClient[]
  mailboxes              Mailbox[]
  mailParticipations     MailParticipant[]
  blocklistEntries       BlocklistEntry[]    @relation("BlocklistOwner")
  createdBlocklist       BlocklistEntry[]    @relation("BlocklistCreator")

  mailOutbound MailOutbound[] @relation("MailOutboundSender")

  createdSuppressions Suppression[] @relation("SuppressionCreator")
  removedSuppressions Suppression[] @relation("SuppressionRemover")

  updatedRegionPolicies            RegionPolicy[]
  regionPolicyChanges              RegionPolicyChange[]
  updatedEmailVerificationSettings EmailVerificationSettings[]
  updatedEnrichmentSettings        EnrichmentSettings[]

  configuredTwentyImports TwentyImportSettings[]
  startedTwentyImports    TwentyImportRun[]
  sequenceEnrolments      SequenceEnrolment[]    @relation("EnrolmentEnroller")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("workspace_members")
}

/// A named set of capabilities in a workspace. The two system roles (`admin`, `member`) exist from
/// creation and cannot be deleted; `admin` holds every capability by construction and has no
/// permission rows.
model Role {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  name        String
  isSystem    Boolean     @default(false) @map("is_system")
  /// Every record, or only the holder's own (doc 48 §5). The admin role is always `all`.
  recordScope RecordScope @default(all) @map("record_scope")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     WorkspaceMember[]
  apiKeys     ApiKey[]
  invites     WorkspaceInvite[]

  @@unique([workspaceId, name])
  @@map("roles")
}

/// One capability granted to one role. `capability` is a value from the shared catalogue; the
/// application validates it, the database stores the string.
model RolePermission {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  roleId      String @map("role_id") @db.Uuid
  capability  String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, capability])
  @@map("role_permissions")
}

/// A machine credential for one workspace, acting with one role. The secret is shown once and
/// only its hash is kept; `prefix` identifies the key without revealing it.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  prefix      String    @unique
  secretHash  String    @map("secret_hash")
  roleId      String    @map("role_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role            @relation(fields: [roleId], references: [id])
  createdBy WorkspaceMember @relation(fields: [createdById], references: [id])

  @@map("api_keys")
}

/// An invitation to join a workspace, sent to an email address with a role. The token is shown
/// once; only its hash is stored. Accepting it requires signing in as that email.
model WorkspaceInvite {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  email           String
  roleId          String    @map("role_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  /// The member who invited — or, for a workspace a platform admin created (P0-14), null with
  /// `invitedByUserId` set instead. Exactly one of the two (a CHECK constraint in the migration).
  invitedById     String?   @map("invited_by_id") @db.Uuid
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role          Role             @relation(fields: [roleId], references: [id])
  invitedBy     WorkspaceMember? @relation(fields: [invitedById], references: [id], onDelete: Restrict)
  invitedByUser User?            @relation("PlatformWorkspaceInvites", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@map("workspace_invites")
}

// ─────────────────────────────────────────────────────────────────────────────
// Records (P1-1a). Tenant tables under RLS like every other; `owner_id` tables also carry a
// RESTRICTIVE policy that narrows an own-scoped caller to their records. Two columns on each
// record table are generated by the database and therefore `Unsupported` here: the search
// vector, and on people the lower-cased primary email the uniqueness index is built on.
// ─────────────────────────────────────────────────────────────────────────────

/// What a role lets its holder reach: every record, or only their own.
enum RecordScope {
  all
  own

  @@map("record_scope")
}

/// The objects a workspace can add custom fields to.
enum RecordObject {
  person
  company
  opportunity

  @@map("record_object")
}

enum CustomFieldType {
  text
  number
  boolean
  date
  datetime
  select
  multiselect
  url
  email
  phone

  @@map("custom_field_type")
}

/// A company (PAR-005/006). `domain` is stored lower-cased (the database checks) and is unique
/// per workspace among non-null values, deleted rows included.
model Company {
  id            String                   @id @default(uuid()) @db.Uuid
  workspaceId   String                   @map("workspace_id") @db.Uuid
  name          String
  domain        String?
  /// The logo, as a URL; enrichment fills it from the website (P4-2).
  logoUrl       String?                  @map("logo_url")
  employeeCount Int?                     @map("employee_count")
  /// ARR in the currency's minor unit, with `arrCurrency`: both or neither (the database checks).
  arrMinor      BigInt?                  @map("arr_minor")
  arrCurrency   String?                  @map("arr_currency") @db.Char(3)
  /// `Address` from @bylinecrm/shared.
  address       Json                     @default("{\"street\":null,\"city\":null,\"state\":null,\"country\":null,\"postalCode\":null}")
  /// `Links` from @bylinecrm/shared.
  links         Json                     @default("{\"linkedin\":null,\"x\":null}")
  /// Ideal-customer-profile flag.
  icp           Boolean                  @default(false)
  /// Manual ordering in views (PAR-084); defaults to the creation instant.
  position      Float                    @default(dbgenerated("extract(epoch from clock_timestamp())"))
  ownerId       String?                  @map("owner_id") @db.Uuid
  /// `Actor` from @bylinecrm/shared: who created the record and how (PAR-003).
  createdBy     Json                     @map("created_by")
  /// Values of the workspace's custom fields, by key; validated against the definitions.
  custom        Json                     @default("{}")
  deletedAt     DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  /// Generated by the database (the expression is the migration's; Prisma only knows it exists).
  search        Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((COALESCE(name, ''::text) || ' '::text) || COALESCE(domain, ''::text)))"))

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         WorkspaceMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  people        Person[]
  opportunities Opportunity[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, ownerId])
  @@index([search], type: Gin)
  @@map("companies")
}

/// A person (PAR-001/002). The primary email is unique per workspace, case-insensitively,
/// deleted rows included; the generated `email_primary` column is what the index covers.
model Person {
  id           String                   @id @default(uuid()) @db.Uuid
  workspaceId  String                   @map("workspace_id") @db.Uuid
  nameFirst    String                   @default("") @map("name_first")
  nameLast     String                   @default("") @map("name_last")
  /// `Emails` from @bylinecrm/shared.
  emails       Json                     @default("{\"primary\":null,\"additional\":[]}")
  /// `Phones` from @bylinecrm/shared.
  phones       Json                     @default("{\"primary\":null,\"additional\":[]}")
  jobTitle     String?                  @map("job_title")
  /// FR-CRMS-11: where the person came from (a list, an import, a form). Required to enrol in outreach.
  source       String?
  /// FR-CRMS-11: ISO 3166-1 alpha-2, upper case (the database checks), when known.
  country      String?                  @db.Char(2)
  city         String?
  /// `Links` from @bylinecrm/shared.
  links        Json                     @default("{\"linkedin\":null,\"x\":null}")
  avatarUrl    String?                  @map("avatar_url")
  position     Float                    @default(dbgenerated("extract(epoch from clock_timestamp())"))
  companyId    String?                  @map("company_id") @db.Uuid
  ownerId      String?                  @map("owner_id") @db.Uuid
  createdBy    Json                     @map("created_by")
  custom       Json                     @default("{}")
  deletedAt    DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  /// Generated by the database from `emails`: the uniqueness index is built on it. Readable, never written.
  emailPrimary String?                  @default(dbgenerated("lower(NULLIF((emails ->> 'primary'::text), ''::text))")) @map("email_primary")
  /// Generated by the database (the expression is the migration's; Prisma only knows it exists).
  search       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((((((COALESCE(name_first, ''::text) || ' '::text) || COALESCE(name_last, ''::text)) || ' '::text) || COALESCE((emails ->> 'primary'::text), ''::text)) || ' '::text) || COALESCE(job_title, ''::text)))"))

  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company            Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner              WorkspaceMember?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contactFor         Opportunity[]
  mailParticipations MailParticipant[]

  mailOutbound MailOutbound[]

  suppressions       Suppression[]
  unsubscribeTokens  UnsubscribeToken[]
  trackingHits       TrackingHit[]
  sequenceEnrolments SequenceEnrolment[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, companyId])
  @@index([search], type: Gin)
  @@map("people")
}

/// A field a workspace added to one of its objects (PAR-073/074). Values live in each record's
/// `custom` column under `key`. A definition is never deleted while a record may hold its value:
/// it is archived, and an archived key is unknown to the validator from then on.
model CustomFieldDefinition {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  object      RecordObject
  key         String
  label       String
  type        CustomFieldType
  /// For `select`/`multiselect`: the allowed values, as strings. Empty otherwise.
  options     Json            @default("[]")
  required    Boolean         @default(false)
  position    Float           @default(dbgenerated("extract(epoch from clock_timestamp())"))
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, object, key])
  @@map("custom_field_definitions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Deals, notes, tasks, attachments (P1-1b). `opportunities` is owner-bearing like people and
// companies. Notes, tasks and attachments are attached to records through polymorphic targets
// (`target_type` + `target_id`, no foreign key — records are only ever soft-deleted); who may
// see one follows from its targets and is decided in the service.
// ─────────────────────────────────────────────────────────────────────────────

enum TaskStatus {
  todo
  in_progress
  done

  @@map("task_status")
}

/// A deal (PAR-007). The amount is exact, in the currency's minor unit. Stage and pipeline arrive
/// with P1-2, which adds its columns and the stage history beside this table.
model Opportunity {
  id               String                   @id @default(uuid()) @db.Uuid
  workspaceId      String                   @map("workspace_id") @db.Uuid
  name             String
  amountMinor      BigInt?                  @map("amount_minor")
  currency         String                   @db.Char(3)
  closeDate        DateTime?                @map("close_date") @db.Date
  /// 0–100 (the database checks).
  probability      Int?                     @db.SmallInt
  position         Float                    @default(dbgenerated("extract(epoch from clock_timestamp())"))
  ownerId          String?                  @map("owner_id") @db.Uuid
  pointOfContactId String?                  @map("point_of_contact_id") @db.Uuid
  companyId        String?                  @map("company_id") @db.Uuid
  /// The pipeline the deal moves through and the stage it is in now (P1-2). When it entered the
  /// stage is the latest `stageHistory` row, never a column.
  pipelineId       String                   @map("pipeline_id") @db.Uuid
  stageId          String                   @map("stage_id") @db.Uuid
  /// Written by a close (a move into a won or lost stage), cleared by a reopen.
  closedAt         DateTime?                @map("closed_at") @db.Timestamptz
  lostReason       String?                  @map("lost_reason")
  createdBy        Json                     @map("created_by")
  custom           Json                     @default("{}")
  deletedAt        DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  search           Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, COALESCE(name, ''::text))"))

  workspace      Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          WorkspaceMember?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  pointOfContact Person?                   @relation(fields: [pointOfContactId], references: [id], onDelete: SetNull)
  company        Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pipeline       Pipeline                  @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          PipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  stageHistory   OpportunityStageHistory[]

  mailOutbound       MailOutbound[]
  sequenceEnrolments SequenceEnrolment[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, pointOfContactId])
  @@index([workspaceId, pipelineId, stageId])
  @@index([search], type: Gin)
  @@map("opportunities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pipelines, stages, stage history and stage rules (P1-2).
// ─────────────────────────────────────────────────────────────────────────────

enum StageKind {
  open
  won
  lost

  @@map("stage_kind")
}

enum StageHistoryReason {
  manual
  rule
  import
  close
  stage_deleted

  @@map("stage_history_reason")
}

/// The events a rule may react to; the database value is the event type's own spelling.
enum StageRuleEvent {
  email_replied  @map("email.replied")
  meeting_booked @map("meeting.booked")
  /// A tracked link clicked (P3-4). An open is never here: opens are indicative (FR-CRMS-8).
  email_clicked  @map("email.clicked")

  @@map("stage_rule_event")
}

model Pipeline {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  /// The pipeline a new deal goes into when none is named; exactly one per workspace (partial unique index).
  isDefault   Boolean  @default(false) @map("is_default")
  position    Float    @default(dbgenerated("extract(epoch from clock_timestamp())"))
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]
  rules         StageRule[]
  sequences     Sequence[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("pipelines")
}

model PipelineStage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  pipelineId    String    @map("pipeline_id") @db.Uuid
  name          String
  /// 1-based order in the pipeline; unique per pipeline, checked at the end of the transaction so a reorder can swap.
  position      Int
  /// The probability a deal in this stage takes when none of its own is set (0–100, the database checks).
  probability   Int       @db.SmallInt
  kind          StageKind @default(open)
  /// A deal here longer than this many days is flagged; `null` means never.
  daysThreshold Int?      @map("days_threshold")
  /// A semantic colour token name (STAGE_COLOURS in @bylinecrm/shared), never a colour value.
  colour        String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  rules         StageRule[]

  @@unique([pipelineId, position])
  @@index([workspaceId, pipelineId])
  @@map("pipeline_stages")
}

/// One row per stage a deal entered, in order. The latest row's `enteredAt` is when the deal
/// entered its current stage; days-in-stage is computed from it, never stored.
model OpportunityStageHistory {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String             @map("workspace_id") @db.Uuid
  opportunityId String             @map("opportunity_id") @db.Uuid
  /// The stage ids this row recorded. Not foreign keys: history outlives the stages it names (P1-2b).
  fromStageId   String?            @map("from_stage_id") @db.Uuid
  toStageId     String             @map("to_stage_id") @db.Uuid
  /// The stage names when the row was written, so a deleted stage still reads as itself.
  fromStageName String?            @map("from_stage_name")
  toStageName   String             @map("to_stage_name")
  enteredAt     DateTime           @default(now()) @map("entered_at") @db.Timestamptz
  actor         Json
  reason        StageHistoryReason

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([workspaceId, opportunityId, enteredAt(sort: Desc)])
  @@map("opportunity_stage_history")
}

/// "When this happens to a deal's person or company, move the deal to that stage" — forward only
/// unless `allowBackward`, and never twice for the same event.
model StageRule {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  pipelineId    String         @map("pipeline_id") @db.Uuid
  event         StageRuleEvent
  toStageId     String         @map("to_stage_id") @db.Uuid
  allowBackward Boolean        @default(false) @map("allow_backward")
  enabled       Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  toStage   PipelineStage @relation(fields: [toStageId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, event])
  @@index([workspaceId, event])
  @@map("stage_rules")
}

/// A note (PAR-010): a rich-text document attached to any number of records.
model Note {
  id          String                   @id @default(uuid()) @db.Uuid
  workspaceId String                   @map("workspace_id") @db.Uuid
  title       String                   @default("")
  /// `RichText` from @bylinecrm/shared, stored as the editor produced it.
  body        Json                     @default("{\"type\":\"doc\",\"content\":[]}")
  /// Derived from `body` by the application on every write; the search vector is built on it.
  bodyText    String                   @default("") @map("body_text")
  authorId    String?                  @map("author_id") @db.Uuid
  createdBy   Json                     @map("created_by")
  deletedAt   DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  search      Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(body_text, ''::text)))"))

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    WorkspaceMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  targets   NoteTarget[]

  @@index([workspaceId, deletedAt])
  @@index([search], type: Gin)
  @@map("notes")
}

/// One record a note is attached to. `RecordObject` names the table; `targetId` the row.
model NoteTarget {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  noteId      String       @map("note_id") @db.Uuid
  targetType  RecordObject @map("target_type")
  targetId    String       @map("target_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, targetType, targetId])
  @@index([workspaceId, targetType, targetId])
  @@map("note_targets")
}

/// A task (PAR-011). `completedAt` is set exactly when `status` is `done` (the database checks).
model Task {
  id          String                   @id @default(uuid()) @db.Uuid
  workspaceId String                   @map("workspace_id") @db.Uuid
  title       String
  body        Json                     @default("{\"type\":\"doc\",\"content\":[]}")
  bodyText    String                   @default("") @map("body_text")
  status      TaskStatus               @default(todo)
  dueAt       DateTime?                @map("due_at") @db.Timestamptz
  assigneeId  String?                  @map("assignee_id") @db.Uuid
  completedAt DateTime?                @map("completed_at") @db.Timestamptz
  createdBy   Json                     @map("created_by")
  deletedAt   DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  search      Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(body_text, ''::text)))"))

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  WorkspaceMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  targets   TaskTarget[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, status])
  @@index([search], type: Gin)
  @@map("tasks")
}

model TaskTarget {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  taskId      String       @map("task_id") @db.Uuid
  targetType  RecordObject @map("target_type")
  targetId    String       @map("target_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, targetType, targetId])
  @@index([workspaceId, targetType, targetId])
  @@map("task_targets")
}

/// A file on one record (PAR-016). The bytes are behind `FileStorage` under `storageKey`.
model Attachment {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  name        String
  storageKey  String       @unique @map("storage_key")
  mime        String
  sizeBytes   BigInt       @map("size_bytes")
  targetType  RecordObject @map("target_type")
  targetId    String       @map("target_id") @db.Uuid
  authorId    String?      @map("author_id") @db.Uuid
  createdBy   Json         @map("created_by")
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    WorkspaceMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, deletedAt])
  @@map("attachments")
}

/// A saved view (PAR-056): a filter, sorts, columns and grouping over one object, kept by a member
/// for themselves or shared with the workspace. P1-4.
model SavedView {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  object        RecordObject
  name          String
  icon          String?
  /// The member who made it; `null` once that seat is gone (a shared view outlives its author).
  ownerMemberId String?      @map("owner_member_id") @db.Uuid
  isShared      Boolean      @default(false) @map("is_shared")
  /// `FilterGroup` from @bylinecrm/shared, or `null` for "everything".
  filter        Json?
  /// `ViewSort[]` from @bylinecrm/shared.
  sorts         Json         @default("[]")
  /// `ViewColumn[]` from @bylinecrm/shared.
  columns       Json         @default("[]")
  groupBy       String?      @map("group_by")
  position      Float        @default(dbgenerated("extract(epoch from clock_timestamp())"))
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     WorkspaceMember? @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, object])
  @@index([workspaceId, ownerMemberId])
  @@map("saved_views")
}

// ─────────────────────────────────────────────────────────────────────────────
// Timeline (P1-3). One append-only list per record of what happened to it: its own domain
// events, the notes/tasks/files attached to it (one entry per record the thing is on), and
// what integrations report. Tenant table under RLS; the app role may read and insert, never
// update or delete — the migration grants exactly that.
// ─────────────────────────────────────────────────────────────────────────────

/// The things that attach to a record and leave `linked-…` entries on its timeline.
enum LinkedObject {
  note
  task
  attachment
  email
  suppression

  @@map("linked_object")
}

/// One thing that happened to one record (PAR-013). `kind` is `<object>.<action>`,
/// `linked-<thing>.<action>` or `external.<kind>` (see `@bylinecrm/shared` timeline.ts).
model TimelineActivity {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  targetType     RecordObject  @map("target_type")
  targetId       String        @map("target_id") @db.Uuid
  kind           String
  happenedAt     DateTime      @map("happened_at") @db.Timestamptz
  /// `TimelineActor` from @bylinecrm/shared: who did it, or which rule or integration.
  actor          Json
  /// The field diff of an update, the linked thing's id and name, an external event's payload.
  properties     Json          @default("{}")
  linkedType     LinkedObject? @map("linked_type")
  linkedId       String?       @map("linked_id") @db.Uuid
  /// External entries only: the integration's name and its key, unique together per workspace.
  source         String?
  idempotencyKey String?       @map("idempotency_key")
  /// Domain-event entries only: the outbox event that wrote it. One entry per (event, record), so a
  /// redelivered event writes nothing new (P1-6).
  eventId        String?       @map("event_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source, idempotencyKey])
  @@unique([workspaceId, eventId, targetType, targetId])
  @@index([workspaceId, targetType, targetId, happenedAt(sort: Desc)])
  @@index([workspaceId, linkedType, linkedId])
  @@map("timeline_activities")
}

/// Where a delivery stands. `pending` is queued; `delivering` is in an attempt; `failed` is between
/// attempts; `succeeded` and `dead` are final (dead = every attempt failed).
enum WebhookDeliveryStatus {
  pending
  delivering
  succeeded
  failed
  dead

  @@map("webhook_delivery_status")
}

/// An outbound webhook endpoint (P1-5): a URL the workspace wants its events POSTed to, with the
/// secret the deliveries are signed with. The secret is held encrypted (it has to be used to sign,
/// so a hash would not do) and shown once; `secret_prefix` is what a list shows afterwards. During
/// a rotation the previous secret stays valid until `previous_secret_expires_at`, and deliveries
/// carry both signatures.
model WebhookEndpoint {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String    @map("workspace_id") @db.Uuid
  url                      String
  description              String    @default("")
  secretCiphertext         String    @map("secret_ciphertext")
  secretPrefix             String    @map("secret_prefix")
  previousSecretCiphertext String?   @map("previous_secret_ciphertext")
  previousSecretExpiresAt  DateTime? @map("previous_secret_expires_at") @db.Timestamptz
  /// Catalogue event types, or `*` for all of them.
  events                   String[]
  enabled                  Boolean   @default(true)
  /// Why the endpoint was switched off by the system (consecutive dead deliveries); null when a person did it or it is on.
  disabledReason           String?   @map("disabled_reason")
  /// Dead deliveries in a row; a success resets it. The auto-disable threshold reads it.
  consecutiveFailures      Int       @default(0) @map("consecutive_failures")
  createdById              String    @map("created_by_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  WorkspaceMember   @relation(fields: [createdById], references: [id])
  deliveries WebhookDelivery[]

  @@index([workspaceId, deletedAt])
  @@map("webhook_endpoints")
}

/// One event sent to one endpoint, and how that went. The payload is the envelope as sent, so a
/// redelivery resends exactly what the receiver was meant to get.
model WebhookDelivery {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                @map("workspace_id") @db.Uuid
  endpointId       String                @map("endpoint_id") @db.Uuid
  /// The outbox event's id: one per published event, shared by every endpoint's delivery of it, and
  /// unique with the endpoint among automatic deliveries (partial unique index), so a redelivered event
  /// finds its deliveries instead of adding more (P1-6).
  eventId          String                @map("event_id") @db.Uuid
  /// A person's manual redelivery: the delivery it repeats. Outside the one-per-event rule; not a
  /// foreign key, since retention removes rows on its own schedule.
  redeliveryOfId   String?               @map("redelivery_of_id") @db.Uuid
  eventName        String                @map("event_name")
  payload          Json
  status           WebhookDeliveryStatus @default(pending)
  attempts         Int                   @default(0)
  nextAttemptAt    DateTime?             @map("next_attempt_at") @db.Timestamptz
  /// When the current or last attempt began; the sweep frees a `delivering` row stuck past the threshold.
  attemptStartedAt DateTime?             @map("attempt_started_at") @db.Timestamptz
  lastStatusCode   Int?                  @map("last_status_code")
  lastError        String?               @map("last_error")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  deliveredAt      DateTime?             @map("delivered_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([workspaceId, endpointId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("webhook_deliveries")
}

enum MailboxPurpose {
  personal
  pool

  @@map("mailbox_purpose")
}

enum MailboxStatus {
  connected
  reconnect_needed
  disconnected

  @@map("mailbox_status")
}

/// The Google OAuth client a workspace's admin created in their own Google Cloud project (P2-1,
/// D-237): one per workspace. Mailboxes are connected through it, so their refresh tokens belong
/// to it. The secret is held encrypted (it is presented to Google, so a hash would not do) and only
/// its last four characters are ever shown.
model GoogleOAuthClient {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String    @unique @map("workspace_id") @db.Uuid
  clientId               String    @map("client_id")
  clientSecretCiphertext String    @map("client_secret_ciphertext")
  clientSecretLast4      String    @map("client_secret_last4")
  configuredById         String    @map("configured_by_id") @db.Uuid
  /// When a mailbox first connected through this client — the only end-to-end proof it works.
  verifiedAt             DateTime? @map("verified_at") @db.Timestamptz
  /// The last check's per-step outcomes and when it ran.
  lastCheck              Json?     @map("last_check")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuredBy WorkspaceMember @relation(fields: [configuredById], references: [id])

  @@map("google_oauth_clients")
}

/// A Google mailbox connected to the workspace (P2-1). Its purpose is fixed when it connects. Tokens
/// are held encrypted and never leave the API; a disconnected mailbox keeps its row (history, the
/// email's uniqueness) and loses its tokens.
model Mailbox {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String         @map("workspace_id") @db.Uuid
  ownerMemberId          String         @map("owner_member_id") @db.Uuid
  /// Lower case; unique in the workspace.
  email                  String
  label                  String?
  purpose                MailboxPurpose
  status                 MailboxStatus
  grantedScopes          String[]       @default([]) @map("granted_scopes")
  refreshTokenCiphertext String?        @map("refresh_token_ciphertext")
  accessTokenCiphertext  String?        @map("access_token_ciphertext")
  accessExpiresAt        DateTime?      @map("access_expires_at") @db.Timestamptz
  /// Why the mailbox last stopped working: `{ code, message, at }`; null while it works.
  lastError              Json?          @map("last_error")
  connectedAt            DateTime?      @map("connected_at") @db.Timestamptz
  /// A pool mailbox's own daily cap (P3-2); null takes the workspace's.
  poolDailyCap           Int?           @map("pool_daily_cap")
  /// Day 1 of a pool mailbox's warm-up: when it first connected as a pool mailbox (P3-2).
  warmupStartedAt        DateTime?      @map("warmup_started_at") @db.Timestamptz
  /// Set while the mailbox is paused for its bounce or complaint rate (FR-CRMS-6, -13).
  pausedAt               DateTime?      @map("paused_at") @db.Timestamptz
  /// Why it was paused: `{ code, message, rate, threshold, at }`; null while it is not.
  pauseReason            Json?          @map("pause_reason")
  /// The last time an admin resumed it, who and why (P3-2).
  resumedAt              DateTime?      @map("resumed_at") @db.Timestamptz
  resumedByMemberId      String?        @map("resumed_by_member_id") @db.Uuid
  resumeNote             String?        @map("resume_note")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     WorkspaceMember   @relation(fields: [ownerMemberId], references: [id])
  resumedBy WorkspaceMember?  @relation("MailboxResumedBy", fields: [resumedByMemberId], references: [id], onDelete: SetNull)
  bounces   MailBounce[]
  threads   MailboxThread[]
  copies    MailMessageCopy[]
  syncState MailboxSyncState?

  outbound MailOutbound[]

  @@unique([workspaceId, email])
  @@index([workspaceId, ownerMemberId])
  @@map("mailboxes")
}

enum TemplateKind {
  personal
  outreach

  @@map("template_kind")
}

/// An email template (P2-4). `body` is the editor's rich-text document restricted to the template
/// subset (`TEMPLATE_BODY_NODES`); variables are `variable` nodes in it and `{{path}}` tokens in
/// `subject`. `version` is the optimistic-concurrency counter a PATCH must name.
model EmailTemplate {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  name        String
  kind        TemplateKind
  subject     String       @default("")
  /// `RichText` from @bylinecrm/shared.
  body        Json
  version     Int          @default(1)
  /// `Actor` from @bylinecrm/shared.
  createdBy   Json         @map("created_by")
  /// `Actor` from @bylinecrm/shared.
  updatedBy   Json         @map("updated_by")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  mailOutbound  MailOutbound[]
  sequenceSteps SequenceStep[]

  @@index([workspaceId, deletedAt, updatedAt(sort: Desc)])
  @@map("email_templates")
}

/// The workspace's mail settings (P2-4): one row per workspace, absent until first saved — a
/// workspace without one reads the defaults in @bylinecrm/shared.
model WorkspaceMailSettings {
  workspaceId           String   @id @map("workspace_id") @db.Uuid
  /// `PostalAddress` from @bylinecrm/shared, or null.
  postalAddress         Json?    @map("postal_address")
  defaultSenderName     String?  @map("default_sender_name")
  unsubscribeFooterText String   @map("unsubscribe_footer_text")
  /// `Actor` from @bylinecrm/shared.
  updatedBy             Json     @map("updated_by")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_mail_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Mail sync (P2-2): what a connected Gmail mailbox holds, matched to the records it concerns.
// ─────────────────────────────────────────────────────────────────────────────

enum MailDirection {
  inbound
  outbound

  @@map("mail_direction")
}

enum MailParticipantRole {
  from
  to
  cc
  bcc

  @@map("mail_participant_role")
}

enum MailSyncStatus {
  idle
  syncing
  failed

  @@map("mail_sync_status")
}

enum MailOutboundStatus {
  scheduled
  queued
  sending
  sent
  failed
  cancelled

  @@map("mail_outbound_status")
}

/// A message the CRM sends (P2-3), from its sender's own personal mailbox. Built once — `mime` is
/// exactly what goes to Gmail — then sent by a queued job. `rfc822MessageId` is ours (`<uuid>@bylinecrm`);
/// once sent, `providerMessageId` / `providerThreadId` are Gmail's and `mailMessageId` the stored copy
/// sync's writer made of it. Gmail rewrites the Message-ID we set (#87), so `providerRfc822MessageId`
/// holds Gmail's once known; every MIME also carries `X-BylineCRM-Id: <id>`, which Gmail keeps.
/// Replies are recognised against these.
model MailOutbound {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String             @map("workspace_id") @db.Uuid
  mailboxId               String             @map("mailbox_id") @db.Uuid
  senderMemberId          String             @map("sender_member_id") @db.Uuid
  /// The person the message is to and about (the template's context).
  personId                String?            @map("person_id") @db.Uuid
  dealId                  String?            @map("deal_id") @db.Uuid
  templateId              String?            @map("template_id") @db.Uuid
  /// The stored message this one answers.
  replyToMessageId        String?            @map("reply_to_message_id") @db.Uuid
  status                  MailOutboundStatus @default(queued)
  rfc822MessageId         String             @unique @map("rfc822_message_id")
  toAddresses             String[]           @map("to_addresses")
  ccAddresses             String[]           @default([]) @map("cc_addresses")
  bccAddresses            String[]           @default([]) @map("bcc_addresses")
  subject                 String
  /// Exactly what goes to Gmail. Null while `scheduled` (it is built when the send's time comes), and
  /// on a scheduled send cancelled, or failed by a check at its time, before it was built.
  mime                    String?
  /// When a scheduled send goes (UTC); null for a send made at once.
  sendAt                  DateTime?          @map("send_at") @db.Timestamptz
  /// The sender's IANA time zone as they scheduled it — echoed back, never used to compute `sendAt`.
  senderTimeZone          String?            @map("sender_time_zone")
  /// What a scheduled send was asked to be (`SendInput` without `sendAt`): built and checked again at
  /// `sendAt`, as its sender's role and the person stand then.
  request                 Json?
  cancelledAt             DateTime?          @map("cancelled_at") @db.Timestamptz
  /// When a failed send was last sent again by hand (#134); null if never.
  retriedAt               DateTime?          @map("retried_at") @db.Timestamptz
  providerMessageId       String?            @map("provider_message_id")
  providerThreadId        String?            @map("provider_thread_id")
  /// Gmail's own Message-ID for the sent message, once known (from the stored copy). Not ours: Gmail
  /// replaces the one we set.
  providerRfc822MessageId String?            @map("provider_rfc822_message_id")
  mailMessageId           String?            @map("mail_message_id") @db.Uuid
  attempts                Int                @default(0)
  lastAttemptAt           DateTime?          @map("last_attempt_at") @db.Timestamptz
  /// `{ code, message, at }` while the last attempt failed; null after a clean one.
  lastError               Json?              @map("last_error")
  sentAt                  DateTime?          @map("sent_at") @db.Timestamptz
  /// The sequence step this send is (P3-3); null for 1:1 mail.
  sequenceEnrolmentId     String?            @map("sequence_enrolment_id") @db.Uuid
  sequenceStepId          String?            @map("sequence_step_id") @db.Uuid
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox     Mailbox         @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  sender      WorkspaceMember @relation("MailOutboundSender", fields: [senderMemberId], references: [id])
  person      Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  deal        Opportunity?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  template    EmailTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  replyTo     MailMessage?    @relation("MailOutboundReplyTo", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  mailMessage MailMessage?    @relation("MailOutboundStored", fields: [mailMessageId], references: [id], onDelete: SetNull)

  suppressions      Suppression[]
  unsubscribeTokens UnsubscribeToken[]
  bounces           MailBounce[]
  trackingTokens    TrackingToken[]
  trackingHits      TrackingHit[]

  sequenceEnrolment SequenceEnrolment? @relation("EnrolmentSends", fields: [sequenceEnrolmentId], references: [id], onDelete: SetNull)
  sequenceStep      SequenceStep?      @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)
  waitingEnrolment  SequenceEnrolment? @relation("EnrolmentWaitingSend")

  @@index([workspaceId, senderMemberId, createdAt(sort: Desc)])
  @@index([mailboxId, providerThreadId])
  @@index([workspaceId, mailMessageId])
  @@index([status, sendAt])
  @@index([providerRfc822MessageId])
  @@index([sequenceEnrolmentId])
  @@map("mail_outbound")
}

/// A conversation, once per workspace however many mailboxes hold it (#107). `subject` is its first
/// message's; the count and last message follow the messages (one writer, `recountThread`). Each
/// mailbox's Gmail thread maps to it through `MailboxThread`.
model MailThread {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  subject       String   @default("")
  lastMessageAt DateTime @map("last_message_at") @db.Timestamptz
  messageCount  Int      @default(0) @map("message_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages       MailMessage[]
  mailboxThreads MailboxThread[]

  @@index([workspaceId, lastMessageAt(sort: Desc)])
  @@map("mail_threads")
}

/// A mailbox's Gmail thread, and the conversation it is part of (#107). A reply sent from a mailbox goes
/// into that mailbox's Gmail thread.
model MailboxThread {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  mailboxId        String   @map("mailbox_id") @db.Uuid
  providerThreadId String   @map("provider_thread_id")
  threadId         String   @map("thread_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox           @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  // Restrict: a thread goes only once no mailbox maps a Gmail thread to it (a mapping may hold copies of
  // messages another thread has, when Gmail threads them differently).
  thread    MailThread        @relation(fields: [threadId], references: [id], onDelete: Restrict)
  copies    MailMessageCopy[]

  @@unique([mailboxId, providerThreadId])
  @@index([threadId])
  @@map("mailbox_threads")
}

/// An email, once per workspace however many of its mailboxes hold it (#107): keyed by `identityKey` — its
/// RFC 822 Message-ID (Gmail's own, which replaces ours, #87), or `gmail:<mailbox>:<gmail id>` for a message
/// with none. Each mailbox holding it is a `MailMessageCopy`. The body is kept sanitised (HTML) and as text;
/// `snippet` is Gmail's. `direction` is the workspace's view: outbound when sent from one of its mailboxes.
model MailMessage {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  threadId          String        @map("thread_id") @db.Uuid
  identityKey       String        @map("identity_key")
  rfc822MessageId   String?       @map("rfc822_message_id")
  inReplyTo         String?       @map("in_reply_to")
  references        String[]      @default([])
  direction         MailDirection
  fromAddress       String        @map("from_address")
  sentAt            DateTime      @map("sent_at") @db.Timestamptz
  snippet           String        @default("")
  subject           String        @default("")
  bodyText          String        @default("") @map("body_text")
  bodyHtmlSanitized String?       @map("body_html_sanitized")
  bodyTruncated     Boolean       @default(false) @map("body_truncated")
  hasAttachments    Boolean       @default(false) @map("has_attachments")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread       MailThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  participants MailParticipant[]
  copies       MailMessageCopy[]

  repliedFrom MailOutbound[] @relation("MailOutboundReplyTo")
  outboundOf  MailOutbound[] @relation("MailOutboundStored")
  bounces     MailBounce[]

  @@unique([workspaceId, identityKey])
  @@index([workspaceId, threadId, sentAt])
  @@index([workspaceId, rfc822MessageId])
  @@map("mail_messages")
}

/// One mailbox's copy of a message (#107): Gmail's id for it there, the Gmail thread it is in there, its
/// labels, and its direction from that mailbox's view. Unique per mailbox and Gmail id — sync's dedupe key.
model MailMessageCopy {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  messageId         String        @map("message_id") @db.Uuid
  mailboxId         String        @map("mailbox_id") @db.Uuid
  mailboxThreadId   String        @map("mailbox_thread_id") @db.Uuid
  providerMessageId String        @map("provider_message_id")
  direction         MailDirection
  labelIds          String[]      @default([]) @map("label_ids")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message       MailMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mailbox       Mailbox       @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  mailboxThread MailboxThread @relation(fields: [mailboxThreadId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, providerMessageId])
  @@index([messageId])
  @@index([mailboxThreadId])
  @@map("mail_message_copies")
}

/// One address on one message, matched to a person and/or a member of the workspace when it can be.
model MailParticipant {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  messageId   String              @map("message_id") @db.Uuid
  role        MailParticipantRole
  /// Lower case (the database checks).
  address     String
  displayName String              @default("") @map("display_name")
  personId    String?             @map("person_id") @db.Uuid
  memberId    String?             @map("member_id") @db.Uuid

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   MailMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  person    Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, address])
  @@index([workspaceId, personId])
  @@index([messageId])
  @@map("mail_participants")
}

/// Where a mailbox's sync stands: Gmail's history cursor, the last run and why it stopped, if it did.
model MailboxSyncState {
  mailboxId           String         @id @map("mailbox_id") @db.Uuid
  workspaceId         String         @map("workspace_id") @db.Uuid
  historyId           String?        @map("history_id")
  status              MailSyncStatus @default(idle)
  lastSyncedAt        DateTime?      @map("last_synced_at") @db.Timestamptz
  /// `{ code, message, at }` while the last run failed or was skipped; null after a clean run.
  lastError           Json?          @map("last_error")
  fullSyncCompletedAt DateTime?      @map("full_sync_completed_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("mailbox_sync_states")
}

/// An address or `@domain` whose mail is not imported: the member's own (personal) or everyone's.
model BlocklistEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Null for a workspace-wide entry; the member's id for a personal one.
  memberId    String?  @map("member_id") @db.Uuid
  /// Lower case: `someone@example.com` or `@example.com`.
  value       String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember? @relation("BlocklistOwner", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember? @relation("BlocklistCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, memberId])
  @@map("blocklist_entries")
}

/// A platform sign-up invitation (P0-14): in `invite` sign-up mode, the only way to create an account
/// with a workspace of one's own. Global, operator-level: the app role has no grant on it; the
/// platform service writes it through the owner client. Only the token's hash is stored.
model PlatformSignupInvite {
  id              String    @id @default(uuid()) @db.Uuid
  email           String
  tokenHash       String    @unique @map("token_hash")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("platform_signup_invites")
}

/// Every platform action, appended in the transaction that made it (P0-14). Append-only: a trigger
/// refuses UPDATE and DELETE for every role, the owner included; the app role has no grant at all.
model PlatformAudit {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  subject     Json     @default("{}")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([occurredAt])
  @@map("platform_audit")
}

// ─────────────────────────────────────────────────────────────────────────────
// Outbox (P1-6). A mutation records its domain event here in the same transaction as the change;
// the relay delivers each row to the in-process consumers at least once. Tenant table under RLS;
// the app role may read and insert, never update or delete — delivery state is the relay's, which
// runs as the owner. The relay's scan uses a partial index on open rows (see the migration).
// ─────────────────────────────────────────────────────────────────────────────

/// One domain event, recorded with the change that caused it.
model OutboxEvent {
  id                 String    @id @db.Uuid
  /// Insertion order, for the relay's scan; not commit order.
  seq                BigInt    @unique @default(autoincrement())
  workspaceId        String    @map("workspace_id") @db.Uuid
  type               String
  /// The `DomainEvent` from @bylinecrm/shared, as published.
  payload            Json
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// The consumers that have handled the event; a retry runs only the others.
  completedConsumers String[]  @default([]) @map("completed_consumers")
  attempts           Int       @default(0)
  /// When a failed delivery may be retried; null means now.
  nextAttemptAt      DateTime? @map("next_attempt_at") @db.Timestamptz
  /// A relay has claimed the row until then; past it, any relay may claim it again.
  leaseUntil         DateTime? @map("lease_until") @db.Timestamptz
  lastError          String?   @map("last_error")
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  /// Every attempt failed; kept for inspection, never retried.
  failedAt           DateTime? @map("failed_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([completedAt])
  @@map("outbox_events")
}

/// Why an address is suppressed (P3-1, FR-CRMS-7). `unsubscribe` and `complaint` are never lifted in the CRM.
enum SuppressionReason {
  unsubscribe
  hard_bounce
  complaint
  manual

  @@map("suppression_reason")
}

/// What put an address on the list: the person (the unsubscribe link), a member, or a provider's report (P3-2).
enum SuppressionSource {
  recipient
  member
  provider

  @@map("suppression_source")
}

/// An address the workspace never mails (P3-1, FR-CRMS-7): every send and every enrolment checks the
/// live entries. One live entry per address; lifting one records who, when and why (`removed_*`) and
/// keeps the row, so the history of an address stays on record.
model Suppression {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  /// Lower case (the database checks).
  address           String
  reason            SuppressionReason
  source            SuppressionSource
  /// The person the address belonged to when it was suppressed, when known.
  personId          String?           @map("person_id") @db.Uuid
  /// The message that led to it (the one whose link was used, or that bounced), when known.
  outboundId        String?           @map("outbound_id") @db.Uuid
  note              String?
  createdByMemberId String?           @map("created_by_member_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  removedAt         DateTime?         @map("removed_at") @db.Timestamptz
  removedByMemberId String?           @map("removed_by_member_id") @db.Uuid
  removalNote       String?           @map("removal_note")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  outbound  MailOutbound?    @relation(fields: [outboundId], references: [id], onDelete: SetNull)
  createdBy WorkspaceMember? @relation("SuppressionCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  removedBy WorkspaceMember? @relation("SuppressionRemover", fields: [removedByMemberId], references: [id], onDelete: SetNull)

  // One live entry per address — the partial unique index `suppressions_live_address_key` in the
  // migration (`removed_at IS NULL`), which is also what every check reads.
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("suppressions")
}

/// The secret behind one unsubscribe link (P3-1): one per (workspace, recipient, message). Only its
/// SHA-256 is stored; the token names nothing. It does not expire — an unsubscribe link keeps working.
model UnsubscribeToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  /// Lower case (the database checks).
  address     String
  personId    String?   @map("person_id") @db.Uuid
  outboundId  String?   @map("outbound_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// The last time it unsubscribed its address; a used token keeps working.
  usedAt      DateTime? @map("used_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  outbound  MailOutbound? @relation(fields: [outboundId], references: [id], onDelete: SetNull)

  @@index([workspaceId, address])
  @@map("unsubscribe_tokens")
}

/// A workspace's sending-pool settings (P3-2, FR-CRMS-6, -13); defaults in docs/design-notes/P3-2.md.
/// Rates are in basis points (1/100 of a percent): 500 = 5%.
model SendingPoolSettings {
  workspaceId       String   @id @map("workspace_id") @db.Uuid
  dailyCap          Int      @default(40) @map("daily_cap")
  warmupStartPerDay Int      @default(5) @map("warmup_start_per_day")
  warmupDays        Int      @default(21) @map("warmup_days")
  jitterMinSeconds  Int      @default(60) @map("jitter_min_seconds")
  jitterMaxSeconds  Int      @default(300) @map("jitter_max_seconds")
  bouncePauseBps    Int      @default(500) @map("bounce_pause_bps")
  complaintPauseBps Int      @default(20) @map("complaint_pause_bps")
  rateMinSample     Int      @default(20) @map("rate_min_sample")
  rateWindowDays    Int      @default(7) @map("rate_window_days")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sending_pool_settings")
}

enum SendingDomainStatus {
  unchecked
  pass
  fail

  @@map("sending_domain_status")
}

/// A pool mailbox's sending domain and its last DNS check (FR-CRMS-13). One row per domain per workspace.
model SendingDomain {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String              @map("workspace_id") @db.Uuid
  /// Lower case.
  domain       String
  /// The DKIM selector checked: `<selector>._domainkey.<domain>`.
  dkimSelector String              @default("google") @map("dkim_selector")
  status       SendingDomainStatus @default(unchecked)
  /// The last check's per-step results: `{ spf, dkim, dmarc }`, each `{ outcome, message }`.
  lastCheck    Json?               @map("last_check")
  checkedAt    DateTime?           @map("checked_at") @db.Timestamptz
  nextCheckAt  DateTime            @default(now()) @map("next_check_at") @db.Timestamptz
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
  @@index([nextCheckAt])
  @@map("sending_domains")
}

/// A delivery failure a pool mailbox was told about (P3-2): one row per bounce report and failed address.
model MailBounce {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  mailboxId   String   @map("mailbox_id") @db.Uuid
  /// The bounce report as stored (the message the mailbox received).
  messageId   String   @map("message_id") @db.Uuid
  /// The address that failed; lower case.
  address     String
  /// A 5.x.x status: the address will never take mail. A 4.x.x one is recorded, never counted.
  permanent   Boolean
  /// The enhanced status code the report gave (`5.1.1`), when it gave one.
  status      String?
  /// The send that bounced, when the report names it.
  outboundId  String?  @map("outbound_id") @db.Uuid
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox       @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  message   MailMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  outbound  MailOutbound? @relation(fields: [outboundId], references: [id], onDelete: SetNull)

  @@unique([mailboxId, messageId, address])
  @@index([mailboxId, occurredAt])
  @@map("mail_bounces")
}

// ── Sequences (P3-3, FR-CRMS-5, -10, -11, -12) — docs/design-notes/P3-3.md ─────────────────────

enum RegionCode {
  eu
  uk
  ca
  us
  other
  unknown

  @@map("region_code")
}

/// A workspace's outreach policy for one region (FR-CRMS-12): an override of `DEFAULT_REGION_POLICY`.
/// Allowing a region blocked by default needs a lawful basis (the database checks).
model RegionPolicy {
  workspaceId       String     @map("workspace_id") @db.Uuid
  region            RegionCode
  allowed           Boolean
  lawfulBasis       String?    @map("lawful_basis")
  updatedByMemberId String?    @map("updated_by_member_id") @db.Uuid
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy WorkspaceMember? @relation(fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@id([workspaceId, region])
  @@map("region_policies")
}

/// Every change to a region's policy (#141): append-only, written in the same transaction as the change.
model RegionPolicyChange {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String     @map("workspace_id") @db.Uuid
  region            RegionCode
  allowed           Boolean
  lawfulBasis       String?    @map("lawful_basis")
  changedByMemberId String?    @map("changed_by_member_id") @db.Uuid
  changedAt         DateTime   @default(now()) @map("changed_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  changedBy WorkspaceMember? @relation(fields: [changedByMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, changedAt])
  @@map("region_policy_changes")
}

enum ExclusionReason {
  customer
  account_managed

  @@map("exclusion_reason")
}

/// Someone outreach must never reach (FR-CRMS-10): a customer, or a contact an account manager works.
/// By address or by domain (exactly one; lower case). Removing keeps the row. One live entry per
/// address and per domain (partial unique indexes, in the migration).
model OutreachExclusion {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String          @map("workspace_id") @db.Uuid
  address            String?
  domain             String?
  reason             ExclusionReason
  accountManagerName String?         @map("account_manager_name")
  /// An integration's key (`newswireos`), or `manual`.
  source             String
  externalRef        String?         @map("external_ref")
  note               String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  removedAt          DateTime?       @map("removed_at") @db.Timestamptz
  removedNote        String?         @map("removed_note")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("outreach_exclusions")
}

enum SequenceStatus {
  draft
  active
  paused
  archived

  @@map("sequence_status")
}

enum SequenceStepKind {
  email
  wait
  task

  @@map("sequence_step_kind")
}

enum EnrolmentStatus {
  active
  held
  finished
  stopped

  @@map("enrolment_status")
}

enum EnrolmentStopReason {
  reply
  bounce
  unsubscribe
  complaint
  suppressed
  manual
  pipeline_exit
  excluded
  sequence_archived
  person_deleted
  region_blocked
  invalid_address

  @@map("enrolment_stop_reason")
}

/// A drip (FR-CRMS-5): ordered steps run per enrolled person, inside a send window in the recipient's
/// local time. Workspace-wide, not a member's.
model Sequence {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String         @map("workspace_id") @db.Uuid
  name               String
  status             SequenceStatus @default(draft)
  /// A deal leaving this pipeline (or closing) stops its enrolment, when `stopOnPipelineExit`.
  pipelineId         String?        @map("pipeline_id") @db.Uuid
  stopOnPipelineExit Boolean        @default(true) @map("stop_on_pipeline_exit")
  /// The zone used when a recipient's cannot be inferred.
  timeZone           String         @map("time_zone")
  windowStartMinute  Int            @default(540) @map("window_start_minute")
  windowEndMinute    Int            @default(1020) @map("window_end_minute")
  /// Monday-first bitmask (bit 0 Monday … bit 6 Sunday).
  windowDays         Int            @default(31) @map("window_days")
  createdBy          Json           @map("created_by")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt         DateTime?      @map("archived_at") @db.Timestamptz

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline   Pipeline?           @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  steps      SequenceStep[]
  enrolments SequenceEnrolment[]

  @@index([workspaceId, status])
  @@map("sequences")
}

/// One step: an email from an outreach template, or a wait. Positions are 0..n-1.
model SequenceStep {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  sequenceId    String           @map("sequence_id") @db.Uuid
  position      Int
  kind          SequenceStepKind
  templateId    String?          @map("template_id") @db.Uuid
  /// Sent as a reply in the previous email step's thread, from the same mailbox.
  replyInThread Boolean          @default(false) @map("reply_in_thread")
  waitDays      Int?             @map("wait_days")
  businessDays  Boolean          @default(true) @map("business_days")
  /// `task` steps (#136): the title of the task created on the person.
  taskTitle     String?          @map("task_title")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence  Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template  EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sends     MailOutbound[]
  trackingHits TrackingHit[]

  @@unique([sequenceId, position])
  @@map("sequence_steps")
}

/// A person in a sequence: the truth the runner reads (FR-CRMS-5). One per (sequence, person).
model SequenceEnrolment {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String               @map("workspace_id") @db.Uuid
  sequenceId            String               @map("sequence_id") @db.Uuid
  personId              String               @map("person_id") @db.Uuid
  dealId                String?              @map("deal_id") @db.Uuid
  status                EnrolmentStatus      @default(active)
  stepIndex             Int                  @default(0) @map("step_index")
  /// When the next step runs; null while a step's send is out (`waitingOutboundId`) or once ended.
  nextRunAt             DateTime?            @map("next_run_at") @db.Timestamptz
  waitingOutboundId     String?              @unique @map("waiting_outbound_id") @db.Uuid
  heldReason            String?              @map("held_reason")
  stopReason            EnrolmentStopReason? @map("stop_reason")
  stopDetail            String?              @map("stop_detail")
  enrolledBy            Json                 @map("enrolled_by")
  /// No country was known at enrolment (D-251): enrolled and flagged; stopped if one later falls in a
  /// blocked region.
  countryUnknownAtEnrol Boolean              @default(false) @map("country_unknown_at_enrol")
  /// The member who enrolled the person (#144): the sender of every step's send — the pool mailbox
  /// only carries it. An API key's enrolment is its creator's.
  enrolledByMemberId    String               @map("enrolled_by_member_id") @db.Uuid
  enrolledAt            DateTime             @default(now()) @map("enrolled_at") @db.Timestamptz
  finishedAt            DateTime?            @map("finished_at") @db.Timestamptz
  stoppedAt             DateTime?            @map("stopped_at") @db.Timestamptz
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence         Sequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  person           Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  deal             Opportunity?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  enrolledByMember WorkspaceMember @relation("EnrolmentEnroller", fields: [enrolledByMemberId], references: [id])
  waitingSend      MailOutbound?   @relation("EnrolmentWaitingSend", fields: [waitingOutboundId], references: [id], onDelete: SetNull)
  sends            MailOutbound[]  @relation("EnrolmentSends")
  trackingHits     TrackingHit[]

  @@unique([sequenceId, personId])
  @@index([status, nextRunAt])
  @@index([workspaceId, personId])
  @@map("sequence_enrolments")
}

// ─────────────────────────────────────────────────────────────────────────────
// The Twenty importer (P4-4, doc 48 §11): the connection to a Twenty workspace, the runs that read
// it, and the links that make a run repeatable — one row per Twenty record, saying what it became.
// docs/design-notes/P4-4.md.
// ─────────────────────────────────────────────────────────────────────────────

/// The Twenty workspace an import reads: its REST base URL and an API key, sealed with `SecretBox`.
/// One per workspace; absent until an admin connects one.
model TwentyImportSettings {
  workspaceId      String   @id @map("workspace_id") @db.Uuid
  baseUrl          String   @map("base_url")
  apiKeyCiphertext String   @map("api_key_ciphertext")
  apiKeyLast4      String   @map("api_key_last4")
  configuredById   String?  @map("configured_by_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuredBy WorkspaceMember? @relation(fields: [configuredById], references: [id], onDelete: SetNull)

  @@map("twenty_import_settings")
}

enum TwentyImportRunStatus {
  queued
  running
  succeeded
  failed
  cancelled

  @@map("twenty_import_run_status")
}

enum TwentyImportMode {
  full
  changes

  @@map("twenty_import_mode")
}

/// One run of the importer. The row is the truth the worker resumes from: `phase` and `cursor`
/// say where it is, `report` what it did per object (`TwentyImportObjectReport[]` from
/// @bylinecrm/shared). At most one queued or running run per workspace (partial unique index).
model TwentyImportRun {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String                @map("workspace_id") @db.Uuid
  status          TwentyImportRunStatus @default(queued)
  mode            TwentyImportMode
  /// `changes` mode: records Twenty updated at or after this instant are read.
  since           DateTime?             @db.Timestamptz
  /// The object being read, while running; null before and after.
  phase           String?
  /// Per object, the cursor to continue from: `{ [object]: string | null }`; an object not present has not started, one mapped to `null` is done.
  cursor          Json                  @default("{}")
  report          Json                  @default("[]")
  error           String?
  cancelRequested Boolean               @default(false) @map("cancel_requested")
  startedById     String?               @map("started_by_id") @db.Uuid
  queuedAt        DateTime              @default(now()) @map("queued_at") @db.Timestamptz
  startedAt       DateTime?             @map("started_at") @db.Timestamptz
  finishedAt      DateTime?             @map("finished_at") @db.Timestamptz
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedBy WorkspaceMember? @relation(fields: [startedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, queuedAt(sort: Desc)])
  @@map("twenty_import_runs")
}

/// What one Twenty record became here: `object` is the Twenty object (`people`, `leadLookups`, …),
/// `localType` what it maps to (`person`, `exclusion`, `member`, …) and `localId` that row. Two
/// Twenty records may map to one row (a journalist and a person with one address). `label` names
/// a local thing that has no row of its own (a message list's name on the Lists field).
model TwentyImportLink {
  workspaceId       String    @map("workspace_id") @db.Uuid
  object            String
  externalId        String    @map("external_id")
  localType         String    @map("local_type")
  localId           String    @map("local_id") @db.Uuid
  label             String?
  /// Twenty's `updatedAt` when the record was last read.
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz
  importedAt        DateTime  @default(now()) @map("imported_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, object, externalId])
  @@index([workspaceId, localType, localId])
  @@map("twenty_import_links")
}

/// What verification found about an address (P3-5, FR-CRMS-14); `@bylinecrm/shared` says what each means.
enum EmailVerificationResult {
  valid
  invalid
  risky
  unknown

  @@map("email_verification_result")
}

/// The workspace's stored answer about an address (lower case): one per (workspace, address), found
/// again once older than the workspace's age (FR-CRMS-16) or whenever it is `unknown`.
model EmailVerification {
  workspaceId String                  @map("workspace_id") @db.Uuid
  address     String
  result      EmailVerificationResult
  /// `EmailVerificationReason` from @bylinecrm/shared.
  reason      String
  message     String
  /// The verifier that answered (`free`, or a vendor adapter's name).
  source      String
  verifiedAt  DateTime                @map("verified_at") @db.Timestamptz
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, address])
  @@map("email_verifications")
}

/// How long a result stands (FR-CRMS-16): a row is an override; no row means 90 days.
model EmailVerificationSettings {
  workspaceId       String   @id @map("workspace_id") @db.Uuid
  maxAgeDays        Int      @default(90) @map("max_age_days")
  updatedByMemberId String?  @map("updated_by_member_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy WorkspaceMember? @relation(fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@map("email_verification_settings")
}

/// How an ask went for one fact (P4-2, FR-CRMS-15): answered; looked and found nothing; could not look.
enum EnrichmentAnswerStatus {
  answered
  no_answer
  failed

  @@map("enrichment_answer_status")
}

/// One answer a source gave about one fact of a record: kept with its source and the time it was
/// asked, whether it was written to the record, and — never a zero or an empty string — `value`
/// only when answered. The record's panel reads them newest first; the re-ask age is dated from them.
model EnrichmentAnswer {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                 @map("workspace_id") @db.Uuid
  object      RecordObject
  recordId    String                 @map("record_id") @db.Uuid
  /// `EnrichmentFactKey` from @bylinecrm/shared.
  field       String
  /// `EnrichmentSource` from @bylinecrm/shared.
  source      String
  status      EnrichmentAnswerStatus
  value       String?
  rank        Int                    @default(0)
  note        String?
  applied     Boolean                @default(false)
  askedAt     DateTime               @map("asked_at") @db.Timestamptz
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, object, recordId, askedAt(sort: Desc)])
  @@index([workspaceId, askedAt])
  @@map("enrichment_answers")
}

/// Which sources a workspace asks and how long an answer stands (P4-2): a row is an override; no row
/// means every free source on and 90 days.
model EnrichmentSettings {
  workspaceId       String   @id @map("workspace_id") @db.Uuid
  reaskAfterDays    Int      @default(90) @map("reask_after_days")
  /// `EnrichmentSource` keys the workspace turned off.
  disabledSources   String[] @default([]) @map("disabled_sources")
  updatedByMemberId String?  @map("updated_by_member_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy WorkspaceMember? @relation(fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@map("enrichment_settings")
}

/// A workspace's short-link domain (P3-4, FR-CRMS-8): the host its tracked links and open pixels
/// live on, a CNAME to the API. One per workspace, and one workspace per domain. Links are rewritten
/// only while `status` is `pass`; the status is the same vocabulary as a sending domain's.
model TrackingDomain {
  workspaceId String              @id @map("workspace_id") @db.Uuid
  /// Lower case; a host names one workspace's links.
  domain      String              @unique
  status      SendingDomainStatus @default(unchecked)
  /// The last check: `{ outcome, message }`.
  lastCheck   Json?               @map("last_check")
  checkedAt   DateTime?           @map("checked_at") @db.Timestamptz
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("tracking_domains")
}

/// What a tracking token stands for: a link in the mail, or the mail's open pixel.
enum TrackingKind {
  click
  open

  @@map("tracking_kind")
}

/// One opaque token in one sent message (P3-4): a `click` token per distinct link, one `open` token
/// per send. Stored hashed, like an unsubscribe token; the public routes resolve it to its workspace
/// first and read everything else inside that workspace.
model TrackingToken {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  outboundId  String       @map("outbound_id") @db.Uuid
  kind        TrackingKind
  tokenHash   String       @unique @map("token_hash")
  /// The link's original URL; null for the open pixel.
  url         String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outbound  MailOutbound @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  hits      TrackingHit[]

  @@index([outboundId])
  @@map("tracking_tokens")
}

/// One request to a tracking token (P3-4). A hit with a `botReason` is a scanner's: kept, so the rule
/// can be audited, and counted nowhere; every other hit is a click or an (indicative) open, announced
/// as `email.clicked` / `email.opened`. Never deleted by the app role.
model TrackingHit {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  tokenId        String       @map("token_id") @db.Uuid
  outboundId     String       @map("outbound_id") @db.Uuid
  kind           TrackingKind
  personId       String?      @map("person_id") @db.Uuid
  sequenceStepId String?      @map("sequence_step_id") @db.Uuid
  enrolmentId    String?      @map("enrolment_id") @db.Uuid
  happenedAt     DateTime     @map("happened_at") @db.Timestamptz
  userAgent      String?      @map("user_agent")
  /// `TrackingBotReason` from @bylinecrm/shared; null for a person's hit.
  botReason      String?      @map("bot_reason")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token     TrackingToken      @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  outbound  MailOutbound       @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  person    Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  step      SequenceStep?      @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)
  enrolment SequenceEnrolment? @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)

  @@index([outboundId, kind])
  @@index([sequenceStepId, kind])
  @@index([tokenId])
  @@map("tracking_hits")
}
