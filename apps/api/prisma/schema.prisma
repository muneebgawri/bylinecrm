// BylineCRM data model. Every tenant table carries `workspace_id` and is under row-level
// security (see the P0-2 migration); the policies are the backstop, the route guard is the gate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant. Global table: the app role reads the current workspace's row, or a workspace the
/// signed-in user is a member of.
model Workspace {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  /// ISO 4217, upper case (the database checks): what a deal takes when the caller names no currency.
  defaultCurrency String   @default("USD") @map("default_currency") @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  /// The lead pool this workspace shares leads with (`link-lead-pool`); null for none.
  leadPoolId      String?  @map("lead_pool_id") @db.Uuid

  leadPool          LeadPool?         @relation(fields: [leadPoolId], references: [id], onDelete: SetNull)
  leadPoolAddresses LeadPoolAddress[]

  members WorkspaceMember[]
  roles   Role[]
  apiKeys ApiKey[]
  invites WorkspaceInvite[]

  people                         Person[]
  companies                      Company[]
  customFieldDefinitions         CustomFieldDefinition[]
  opportunities                  Opportunity[]
  notes                          Note[]
  noteTargets                    NoteTarget[]
  tasks                          Task[]
  taskTargets                    TaskTarget[]
  attachments                    Attachment[]
  savedViews                     SavedView[]
  timelineActivities             TimelineActivity[]
  outboxEvents                   OutboxEvent[]
  pipelines                      Pipeline[]
  pipelineStages                 PipelineStage[]
  stageHistory                   OpportunityStageHistory[]
  stageRules                     StageRule[]
  webhookEndpoints               WebhookEndpoint[]
  webhookDeliveries              WebhookDelivery[]
  googleOAuthClient              GoogleOAuthClient?
  googleWorkspaceDelegation      GoogleWorkspaceDelegation?
  googleWorkspaceDelegationAudit GoogleWorkspaceDelegationAudit[]
  mailboxes                      Mailbox[]
  emailTemplates                 EmailTemplate[]
  mailSettings                   WorkspaceMailSettings?
  signatureSettings              WorkspaceSignatureSettings?
  logos                          WorkspaceLogo[]
  mailAssets                     MailAsset[]
  mailDrafts                     MailDraft[]
  mailThreads                    MailThread[]
  mailMessages                   MailMessage[]
  mailboxThreads                 MailboxThread[]
  mailMessageCopies              MailMessageCopy[]
  mailParticipants               MailParticipant[]
  mailboxSyncStates              MailboxSyncState[]
  blocklistEntries               BlocklistEntry[]

  mailOutbound MailOutbound[]
  mailOutbox   MailOutbox[]

  suppressions      Suppression[]
  unsubscribeTokens UnsubscribeToken[]

  sendingPoolSettings  SendingPoolSettings?
  reputationSettings   ReputationSettings?
  sendingDomains       SendingDomain[]
  sendingDomainStats   SendingDomainStat[]
  postmasterConnection PostmasterConnection?
  mailBounces          MailBounce[]

  regionPolicies            RegionPolicy[]
  regionPolicyChanges       RegionPolicyChange[]
  emailVerifications        EmailVerification[]
  emailVerificationSettings EmailVerificationSettings?
  enrichmentAnswers         EnrichmentAnswer[]
  enrichmentSettings        EnrichmentSettings?
  outreachExclusions        OutreachExclusion[]
  sequences                 Sequence[]
  notifications             Notification[]
  sequenceSteps             SequenceStep[]
  sequenceEnrolments        SequenceEnrolment[]

  twentyImportSettings TwentyImportSettings?
  twentyImportRuns     TwentyImportRun[]
  twentyImportLinks    TwentyImportLink[]
  biginImportSettings  BiginImportSettings?
  biginImportRuns      BiginImportRun[]
  biginImportLinks     BiginImportLink[]
  biginContactReuses   BiginContactReuse[]
  biginStageMappings   BiginStageMapping[]

  trackingDomain TrackingDomain?
  trackingTokens TrackingToken[]
  trackingHits   TrackingHit[]

  calendarEvents                CalendarEvent[]
  calendarEventCopies           CalendarEventCopy[]
  calendarParticipants          CalendarEventParticipant[]
  calendarSyncStates            CalendarSyncState[]
  slotlineSettings              SlotlineSettings?
  newswireosSettings            NewswireosSettings?
  newswireosOwnershipDeliveries NewswireosOwnershipDelivery[]
  newswireosDealWonDeliveries   NewswireosDealWonDelivery[]
  newswireosTimelineEvents      NewswireosTimelineEvent[]
  bylineSettings                BylineSettings?
  bylineLeads                   BylineLead[]
  dealInvoices                  DealInvoice[]
  ownershipTransfers            OwnershipTransfer[]
  guardrailEvents               GuardrailEvent[]
  companyDomains                CompanyDomain[]
  customerExclusionSettings     CustomerExclusionSettings?
  ownershipSettings             OwnershipSettings?
  guardrailSettings             GuardrailSettings?
  rotationSettings              RotationSettings?
  rotationMembers               RotationMember[]
  cadenceLapses                 CadenceLapse[]

  @@map("workspaces")
}

/// A person who can sign in. Global table, written only by AuthService through the owner client.
/// `email` is stored lower-cased by the application and unique as stored. `passwordHash` is null
/// for a user who only ever signed in through an identity provider.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String?   @map("password_hash")
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.Timestamptz
  /// How the person is shown to other members, in every workspace; pickers read it, never the email.
  displayName        String?   @map("display_name")
  /// When the person confirmed their name (saved, or kept the suggestion); `null` asks once.
  profileCompletedAt DateTime? @map("profile_completed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships   WorkspaceMember[]
  sessions      Session[]
  identities    ExternalIdentity[]
  oneTimeTokens OneTimeToken[]

  platformWorkspaceInvites WorkspaceInvite[]      @relation("PlatformWorkspaceInvites")
  platformSignupInvites    PlatformSignupInvite[]

  @@map("users")
}

/// What a mailed single-use link is for (#93). #101 adds `set_password`.
enum OneTimeTokenPurpose {
  email_verification
  password_reset
}

/// A mailed single-use link (#93): verify an address, reset a password. Only the secret's hash is
/// stored. Global and owner-client only, like `sessions`: it is read before any workspace is known,
/// and the app role has no grant on it. One live link per user and purpose — issuing a new one
/// deletes the unspent ones.
model OneTimeToken {
  id        String              @id @default(uuid()) @db.Uuid
  purpose   OneTimeTokenPurpose
  userId    String              @map("user_id") @db.Uuid
  /// The address the link was mailed to; verification succeeds only while it is still the account's.
  email     String
  tokenHash String              @unique @map("token_hash")
  expiresAt DateTime            @map("expires_at") @db.Timestamptz
  usedAt    DateTime?           @map("used_at") @db.Timestamptz
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("one_time_tokens")
}

/// Transactional mail owed (#93): written in the transaction that makes the mail necessary, sent by
/// `MailOutboxRelay` after the commit, at least once (the provider's idempotency key makes it once).
/// `sealed` is the whole message sealed with `SecretBox` — it carries a single-use link — and is
/// wiped when the mail is sent or given up on. `workspace_id` is set for a workspace's own mail (an
/// invitation, written by the app role under RLS, INSERT only) and null for an account's (verify,
/// reset, written by the owner client). Delivery state is the relay's, as the owner.
model MailOutbox {
  id                String    @id @db.Uuid
  /// Insertion order, for the relay's scan.
  seq               BigInt    @unique @default(autoincrement())
  workspaceId       String?   @map("workspace_id") @db.Uuid
  kind              String
  /// The mail's identity; a second record of the same mail is dropped.
  idempotencyKey    String    @unique @map("idempotency_key")
  sealed            String
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  attempts          Int       @default(0)
  nextAttemptAt     DateTime? @map("next_attempt_at") @db.Timestamptz
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz
  lastError         String?   @map("last_error")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz
  providerMessageId String?   @map("provider_message_id")
  failedAt          DateTime? @map("failed_at") @db.Timestamptz

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sentAt])
  @@map("mail_outbox")
}

/// A signed-in browser. The cookie carries a random token; only its hash is stored. Global table
/// out of the app role's reach: sessions are read before any workspace is known, by the auth layer.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz
  /// The session this one replaced on rotation, kept for the audit trail.
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A user's account at an identity provider (Google, or any OIDC issuer the operator configured).
/// Global, owner-only, like sessions.
model ExternalIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// The issuer key from configuration (`google`, or the operator's name for an OIDC issuer).
  provider  String
  /// The provider's stable subject identifier for the user.
  subject   String
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("external_identities")
}

/// A user's seat in a workspace, with the role that decides what they may do there.
model WorkspaceMember {
  id                       String    @id @default(uuid()) @db.Uuid
  workspaceId              String    @map("workspace_id") @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  roleId                   String    @map("role_id") @db.Uuid
  /// When the member was removed (#147): the row stays, so their sends, enrolments and timeline rows keep
  /// their name; their access ended at this moment. Null for a member in the workspace.
  leftAt                   DateTime? @map("left_at") @db.Timestamptz
  /// How the seat came to be: `signup` (the workspace's first admin), `invite` (an accepted invitation),
  /// `twenty-import` (#184, an account the importer made for a Twenty member). Null for seats from before the column.
  source                   String?
  /// What a signature's `{{sender.title}}` and `{{sender.phone}}` read (#193), in this workspace.
  jobTitle                 String?   @map("job_title")
  phone                    String?
  /// The member's Slotline page is `{baseUrl}/{slotlineUsername}` (#193): set by them or an admin, never guessed.
  slotlineUsername         String?   @map("slotline_username")
  /// The member's own Slotline API key (#196), encrypted (`SecretBox`); only its last four are ever shown.
  slotlineApiKeyCiphertext String?   @map("slotline_api_key_ciphertext")
  slotlineApiKeyLast4      String?   @map("slotline_api_key_last4")
  /// The event type "Book a quick meeting" opens (#196): its slug and title on Slotline; null opens the member's page.
  slotlineEventSlug        String?   @map("slotline_event_slug")
  slotlineEventTitle       String?   @map("slotline_event_title")
  /// The member's profiles a signature shows as icons (#193): `SocialLinks` from @bylinecrm/shared.
  socialLinks              Json      @default("{}") @map("social_links")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id])

  createdApiKeys         ApiKey[]
  createdWebhooks        WebhookEndpoint[]
  sentInvites            WorkspaceInvite[]
  ownedPeople            Person[]
  ownedCompanies         Company[]
  ownedOpportunities     Opportunity[]
  authoredNotes          Note[]
  assignedTasks          Task[]
  authoredAttachments    Attachment[]
  savedViews             SavedView[]
  resumedMailboxes       Mailbox[]              @relation("MailboxResumedBy")
  configuredOAuthClients GoogleOAuthClient[]
  postmasterConnections  PostmasterConnection[]
  mailboxes              Mailbox[]
  mailParticipations     MailParticipant[]
  blocklistEntries       BlocklistEntry[]       @relation("BlocklistOwner")
  createdBlocklist       BlocklistEntry[]       @relation("BlocklistCreator")

  mailOutbound MailOutbound[] @relation("MailOutboundSender")
  mailDrafts   MailDraft[]

  createdSuppressions Suppression[] @relation("SuppressionCreator")
  removedSuppressions Suppression[] @relation("SuppressionRemover")

  updatedRegionPolicies            RegionPolicy[]
  regionPolicyChanges              RegionPolicyChange[]
  updatedEmailVerificationSettings EmailVerificationSettings[]
  updatedEnrichmentSettings        EnrichmentSettings[]

  configuredTwentyImports TwentyImportSettings[]
  startedTwentyImports    TwentyImportRun[]
  configuredBiginImports  BiginImportSettings[]
  startedBiginImports     BiginImportRun[]
  sequenceEnrolments      SequenceEnrolment[]    @relation("EnrolmentEnroller")
  ownedSequences          Sequence[]             @relation("SequenceOwner")
  notifications           Notification[]

  hostedMeetings        CalendarEvent[]
  configuredSlotline    SlotlineSettings[]
  configuredNewswireos  NewswireosSettings[]
  configuredByline      BylineSettings[]
  invoicesCreated       DealInvoice[]              @relation("InvoiceCreator")
  invoicesDecided       DealInvoice[]              @relation("InvoiceDecider")
  uploadedLogos         WorkspaceLogo[]
  uploadedMailAssets    MailAsset[]
  calendarEventCopies   CalendarEventCopy[]
  meetingParticipations CalendarEventParticipant[] @relation("CalendarParticipantMember")
  leadsFromMeetings     CalendarEventParticipant[] @relation("CalendarParticipantLeadFor")
  suggestedLeads        CalendarEventParticipant[] @relation("CalendarParticipantLeadSuggestedFor")

  /// #192: the daily email of tasks due or overdue; the member turns it off.
  taskDigest Boolean @default(true) @map("task_digest")

  transfersFrom     OwnershipTransfer[] @relation("TransferFrom")
  transfersTo       OwnershipTransfer[] @relation("TransferTo")
  transfersProposed OwnershipTransfer[] @relation("TransferProposedBy")
  transfersDecided  OwnershipTransfer[] @relation("TransferDecidedBy")

  guardrailsTried    GuardrailEvent[] @relation("GuardrailActor")
  guardrailsOwned    GuardrailEvent[] @relation("GuardrailOwner")
  guardrailsReviewed GuardrailEvent[] @relation("GuardrailReviewer")

  rotationMembership RotationMember?
  cadenceLapses      CadenceLapse[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("workspace_members")
}

/// A named set of capabilities in a workspace. The two system roles (`admin`, `member`) exist from
/// creation and cannot be deleted; `admin` holds every capability by construction and has no
/// permission rows.
model Role {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  name        String
  isSystem    Boolean     @default(false) @map("is_system")
  /// Every record, or only the holder's own (doc 48 §5). The admin role is always `all`.
  recordScope RecordScope @default(all) @map("record_scope")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions          RolePermission[]
  members              WorkspaceMember[]
  apiKeys              ApiKey[]
  invites              WorkspaceInvite[]
  twentyImportRuns     TwentyImportRun[]
  twentyImportSettings TwentyImportSettings[] @relation("TwentyImportSettingsRole")
  biginImportRuns      BiginImportRun[]
  biginImportSettings  BiginImportSettings[]  @relation("BiginImportSettingsRole")

  @@unique([workspaceId, name])
  @@map("roles")
}

/// One capability granted to one role. `capability` is a value from the shared catalogue; the
/// application validates it, the database stores the string.
model RolePermission {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  roleId      String @map("role_id") @db.Uuid
  capability  String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, capability])
  @@map("role_permissions")
}

/// A machine credential for one workspace, acting with one role. The secret is shown once and
/// only its hash is kept; `prefix` identifies the key without revealing it.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  prefix      String    @unique
  secretHash  String    @map("secret_hash")
  roleId      String    @map("role_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role            @relation(fields: [roleId], references: [id])
  createdBy WorkspaceMember @relation(fields: [createdById], references: [id])

  @@map("api_keys")
}

/// An invitation to join a workspace, sent to an email address with a role. The token is shown
/// once; only its hash is stored. Accepting it requires signing in as that email.
model WorkspaceInvite {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  email           String
  roleId          String    @map("role_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  /// The member who invited — or, for a workspace a platform admin created (P0-14), null with
  /// `invitedByUserId` set instead. Exactly one of the two (a CHECK constraint in the migration).
  invitedById     String?   @map("invited_by_id") @db.Uuid
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role          Role             @relation(fields: [roleId], references: [id])
  invitedBy     WorkspaceMember? @relation(fields: [invitedById], references: [id], onDelete: Restrict)
  invitedByUser User?            @relation("PlatformWorkspaceInvites", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@map("workspace_invites")
}

// ─────────────────────────────────────────────────────────────────────────────
// Records (P1-1a). Tenant tables under RLS like every other; `owner_id` tables also carry a
// RESTRICTIVE policy that narrows an own-scoped caller to their records. Two columns on each
// record table are generated by the database and therefore `Unsupported` here: the search
// vector, and on people the lower-cased primary email the uniqueness index is built on.
// ─────────────────────────────────────────────────────────────────────────────

/// What a role lets its holder reach: every record, or only their own.
enum RecordScope {
  all
  own

  @@map("record_scope")
}

/// The objects a workspace can add custom fields to.
enum RecordObject {
  person
  company
  opportunity

  @@map("record_object")
}

enum CustomFieldType {
  text
  number
  boolean
  date
  datetime
  select
  multiselect
  url
  email
  phone

  @@map("custom_field_type")
}

/// A company (PAR-005/006). `domain` is stored lower-cased (the database checks) and is unique
/// per workspace among non-null values, deleted rows included.
model Company {
  id                   String                   @id @default(uuid()) @db.Uuid
  workspaceId          String                   @map("workspace_id") @db.Uuid
  name                 String
  domain               String?
  /// The logo, as a URL; enrichment fills it from the website (P4-2).
  logoUrl              String?                  @map("logo_url")
  employeeCount        Int?                     @map("employee_count")
  /// ARR in the currency's minor unit, with `arrCurrency`: both or neither (the database checks).
  arrMinor             BigInt?                  @map("arr_minor")
  arrCurrency          String?                  @map("arr_currency") @db.Char(3)
  /// `Address` from @bylinecrm/shared.
  address              Json                     @default("{\"street\":null,\"city\":null,\"state\":null,\"country\":null,\"postalCode\":null}")
  /// `Links` from @bylinecrm/shared.
  links                Json                     @default("{\"linkedin\":null,\"x\":null}")
  /// Ideal-customer-profile flag.
  icp                  Boolean                  @default(false)
  /// Manual ordering in views (PAR-084); defaults to the creation instant.
  position             Float                    @default(dbgenerated("extract(epoch from clock_timestamp())"))
  ownerId              String?                  @map("owner_id") @db.Uuid
  /// `Actor` from @bylinecrm/shared: who created the record and how (PAR-003).
  createdBy            Json                     @map("created_by")
  /// Values of the workspace's custom fields, by key; validated against the definitions.
  custom               Json                     @default("{}")
  /// PNW-766: the NewswireOS client a won deal at this company made or joined (a colleague's is its parent client).
  /// The first one stays: a company may hold several clients, one per contact, each kept on its person.
  newswireosCustomerId String?                  @map("newswireos_customer_id")
  deletedAt            DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  /// Generated by the database (the expression is the migration's; Prisma only knows it exists).
  search               Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((COALESCE(name, ''::text) || ' '::text) || COALESCE(domain, ''::text)))"))

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         WorkspaceMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  people        Person[]
  opportunities Opportunity[]
  otherDomains  CompanyDomain[]
  guardrails    GuardrailEvent[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, ownerId])
  @@index([search], type: Gin)
  @@map("companies")
}

/// A company's other domain (OWN-2, FR-CRMS-20): a person writing from it is at that company. Lower case; one
/// company per domain in a workspace, and never a domain another company has as its own (the service checks).
model CompanyDomain {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  domain      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
  @@index([companyId])
  @@map("company_domains")
}

/// A person (PAR-001/002). The primary email is unique per workspace, case-insensitively,
/// deleted rows included; the generated `email_primary` column is what the index covers.
model Person {
  id                    String                   @id @default(uuid()) @db.Uuid
  workspaceId           String                   @map("workspace_id") @db.Uuid
  nameFirst             String                   @default("") @map("name_first")
  nameLast              String                   @default("") @map("name_last")
  /// `Emails` from @bylinecrm/shared.
  emails                Json                     @default("{\"primary\":null,\"additional\":[]}")
  /// `Phones` from @bylinecrm/shared.
  phones                Json                     @default("{\"primary\":null,\"additional\":[]}")
  jobTitle              String?                  @map("job_title")
  /// FR-CRMS-11: where the person came from (a list, an import, a form). Required to enrol in outreach.
  source                String?
  /// FR-CRMS-11: ISO 3166-1 alpha-2, upper case (the database checks), when known.
  country               String?                  @db.Char(2)
  city                  String?
  /// `Links` from @bylinecrm/shared.
  links                 Json                     @default("{\"linkedin\":null,\"x\":null}")
  avatarUrl             String?                  @map("avatar_url")
  position              Float                    @default(dbgenerated("extract(epoch from clock_timestamp())"))
  companyId             String?                  @map("company_id") @db.Uuid
  ownerId               String?                  @map("owner_id") @db.Uuid
  createdBy             Json                     @map("created_by")
  custom                Json                     @default("{}")
  /// PNW-766: the NewswireOS client a won deal made or linked this person to (`customer_id`): its external id.
  newswireosCustomerId  String?                  @map("newswireos_customer_id")
  deletedAt             DateTime?                @map("deleted_at") @db.Timestamptz
  /// Set when this person was a duplicate merged into another (and trashed): the person kept.
  mergedIntoId          String?                  @map("merged_into_id") @db.Uuid
  /// #242: what `refresh_contact_status()` derived, or the override, or `do_not_contact` (a live suppression). Never written by Prisma.
  contactStatus         ContactStatus            @default(new) @map("contact_status")
  /// #242: a member's choice; never `do_not_contact` (the database checks; that one is the suppression list).
  contactStatusOverride ContactStatus?           @map("contact_status_override")
  /// #242, derived: messages sent to them, and when the last one was.
  contactAttempts       Int                      @default(0) @map("contact_attempts")
  lastContactedAt       DateTime?                @map("last_contacted_at") @db.Timestamptz
  /// CADENCE-1, derived by `refresh_cadence()`: the contact of an open deal whose follow-up cadence lapsed.
  cadenceOverdue        Boolean                  @default(false) @map("cadence_overdue")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  /// Generated by the database from `emails`: the uniqueness index is built on it. Readable, never written.
  emailPrimary          String?                  @default(dbgenerated("lower(NULLIF((emails ->> 'primary'::text), ''::text))")) @map("email_primary")
  /// Generated by the database (the expression is the migration's; Prisma only knows it exists).
  search                Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((((((COALESCE(name_first, ''::text) || ' '::text) || COALESCE(name_last, ''::text)) || ' '::text) || COALESCE((emails ->> 'primary'::text), ''::text)) || ' '::text) || COALESCE(job_title, ''::text)))"))

  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company            Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner              WorkspaceMember?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  mergedInto         Person?           @relation("PersonMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom         Person[]          @relation("PersonMerge")
  contactFor         Opportunity[]
  mailParticipations MailParticipant[]

  mailOutbound MailOutbound[]
  mailDrafts   MailDraft[]

  leadPoolAddress LeadPoolAddress?

  suppressions       Suppression[]
  unsubscribeTokens  UnsubscribeToken[]
  trackingHits       TrackingHit[]
  sequenceEnrolments SequenceEnrolment[]

  meetingParticipations CalendarEventParticipant[]
  guardrails            GuardrailEvent[]
  bylineLeads           BylineLead[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, contactStatus])
  @@index([workspaceId, cadenceOverdue])
  @@index([search], type: Gin)
  @@map("people")
}

/// #242: a person's contact status (`CONTACT_STATUSES` in @bylinecrm/shared).
enum ContactStatus {
  new
  attempted_contact
  contacted
  engaged
  unresponsive
  do_not_contact
  customer

  @@map("contact_status")
}

/// #242: why a deal was lost (`LOST_REASONS` in @bylinecrm/shared).
enum LostReasonCode {
  price_budget
  no_response
  chose_competitor
  not_ready
  service_not_suitable
  timing
  duplicate_opportunity
  other

  @@map("lost_reason_code")
}

/// A field a workspace added to one of its objects (PAR-073/074). Values live in each record's
/// `custom` column under `key`. A definition is never deleted while a record may hold its value:
/// it is archived, and an archived key is unknown to the validator from then on.
model CustomFieldDefinition {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  object      RecordObject
  key         String
  label       String
  type        CustomFieldType
  /// For `select`/`multiselect`: the allowed values, as strings. Empty otherwise.
  options     Json            @default("[]")
  required    Boolean         @default(false)
  /// Hidden from callers without `workspace:admin`: their definition list, record values and writes.
  adminOnly   Boolean         @default(false) @map("admin_only")
  position    Float           @default(dbgenerated("extract(epoch from clock_timestamp())"))
  archivedAt  DateTime?       @map("archived_at") @db.Timestamptz
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, object, key])
  @@map("custom_field_definitions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Deals, notes, tasks, attachments (P1-1b). `opportunities` is owner-bearing like people and
// companies. Notes, tasks and attachments are attached to records through polymorphic targets
// (`target_type` + `target_id`, no foreign key — records are only ever soft-deleted); who may
// see one follows from its targets and is decided in the service.
// ─────────────────────────────────────────────────────────────────────────────

enum TaskStatus {
  todo
  in_progress
  done

  @@map("task_status")
}

/// A deal (PAR-007). The amount is exact, in the currency's minor unit. Stage and pipeline arrive
/// with P1-2, which adds its columns and the stage history beside this table.
model Opportunity {
  id               String                   @id @default(uuid()) @db.Uuid
  workspaceId      String                   @map("workspace_id") @db.Uuid
  name             String
  amountMinor      BigInt?                  @map("amount_minor")
  currency         String                   @db.Char(3)
  closeDate        DateTime?                @map("close_date") @db.Date
  /// 0–100 (the database checks).
  probability      Int?                     @db.SmallInt
  position         Float                    @default(dbgenerated("extract(epoch from clock_timestamp())"))
  ownerId          String?                  @map("owner_id") @db.Uuid
  pointOfContactId String?                  @map("point_of_contact_id") @db.Uuid
  companyId        String?                  @map("company_id") @db.Uuid
  /// The pipeline the deal moves through and the stage it is in now (P1-2). When it entered the
  /// stage is the latest `stageHistory` row, never a column.
  pipelineId       String                   @map("pipeline_id") @db.Uuid
  stageId          String                   @map("stage_id") @db.Uuid
  /// Written by a close (a move into a won or lost stage), cleared by a reopen.
  closedAt         DateTime?                @map("closed_at") @db.Timestamptz
  lostReason       String?                  @map("lost_reason")
  /// #242: the picklist reason; set on every close into a lost stage, cleared on a reopen.
  lostReasonCode   LostReasonCode?          @map("lost_reason_code")
  /// #242: the next follow-up; setting it keeps one open task (`followUpTaskId`) due that day.
  nextFollowUpDate DateTime?                @map("next_follow_up_date") @db.Date
  followUpTaskId   String?                  @map("follow_up_task_id") @db.Uuid
  nextActivity     String?                  @map("next_activity")
  serviceInterest  String?                  @map("service_interest")
  leadSource       String?                  @map("lead_source")
  /// CADENCE-1, derived by `refresh_cadence()`: when the next touch is due (null: no cadence applies), and whether it lapsed.
  cadenceTouchedAt DateTime?                @map("cadence_touched_at") @db.Timestamptz
  cadenceDueAt     DateTime?                @map("cadence_due_at") @db.Timestamptz
  cadenceOverdue   Boolean                  @default(false) @map("cadence_overdue")
  createdBy        Json                     @map("created_by")
  custom           Json                     @default("{}")
  deletedAt        DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  search           Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, COALESCE(name, ''::text))"))

  workspace      Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          WorkspaceMember?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  pointOfContact Person?                   @relation(fields: [pointOfContactId], references: [id], onDelete: SetNull)
  company        Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pipeline       Pipeline                  @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          PipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  stageHistory   OpportunityStageHistory[]
  followUpTask   Task?                     @relation("DealFollowUpTask", fields: [followUpTaskId], references: [id], onDelete: SetNull)

  mailOutbound       MailOutbound[]
  mailDrafts         MailDraft[]
  sequenceEnrolments SequenceEnrolment[]
  invoices           DealInvoice[]
  cadenceLapses      CadenceLapse[]

  @@index([workspaceId, cadenceOverdue])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, pointOfContactId])
  @@index([workspaceId, pipelineId, stageId])
  @@index([search], type: Gin)
  @@map("opportunities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pipelines, stages, stage history and stage rules (P1-2).
// ─────────────────────────────────────────────────────────────────────────────

enum StageKind {
  open
  won
  lost

  @@map("stage_kind")
}

enum StageHistoryReason {
  manual
  rule
  import
  close
  stage_deleted

  @@map("stage_history_reason")
}

/// The events a rule may react to; the database value is the event type's own spelling.
enum StageRuleEvent {
  email_replied    @map("email.replied")
  meeting_booked   @map("meeting.booked")
  /// A tracked link clicked (P3-4). An open is never here: opens are indicative (FR-CRMS-8).
  email_clicked    @map("email.clicked")
  /// INV-1: a verified invoice that makes the deal's verified invoices cover its amount.
  invoice_verified @map("invoice.verified")

  @@map("stage_rule_event")
}

model Pipeline {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  /// The pipeline a new deal goes into when none is named; exactly one per workspace (partial unique index).
  isDefault   Boolean  @default(false) @map("is_default")
  position    Float    @default(dbgenerated("extract(epoch from clock_timestamp())"))
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]
  rules         StageRule[]
  sequences     Sequence[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("pipelines")
}

model PipelineStage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  pipelineId    String    @map("pipeline_id") @db.Uuid
  name          String
  /// 1-based order in the pipeline; unique per pipeline, checked at the end of the transaction so a reorder can swap.
  position      Int
  /// The probability a deal in this stage takes when none of its own is set (0–100, the database checks).
  probability   Int       @db.SmallInt
  kind          StageKind @default(open)
  /// A deal here longer than this many days is flagged; `null` means never.
  daysThreshold Int?      @map("days_threshold")
  /// CADENCE-1: an open deal here is due a touch this many days after its last; `null` (and every closed stage): none.
  cadenceDays   Int?      @map("cadence_days")
  /// A semantic colour token name (STAGE_COLOURS in @bylinecrm/shared), never a colour value.
  colour        String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline           Pipeline            @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities      Opportunity[]
  rules              StageRule[]
  biginStageMappings BiginStageMapping[]

  @@unique([pipelineId, position])
  @@index([workspaceId, pipelineId])
  @@map("pipeline_stages")
}

/// One row per stage a deal entered, in order. The latest row's `enteredAt` is when the deal
/// entered its current stage; days-in-stage is computed from it, never stored.
model OpportunityStageHistory {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String             @map("workspace_id") @db.Uuid
  opportunityId String             @map("opportunity_id") @db.Uuid
  /// The stage ids this row recorded. Not foreign keys: history outlives the stages it names (P1-2b).
  fromStageId   String?            @map("from_stage_id") @db.Uuid
  toStageId     String             @map("to_stage_id") @db.Uuid
  /// The stage names when the row was written, so a deleted stage still reads as itself.
  fromStageName String?            @map("from_stage_name")
  toStageName   String             @map("to_stage_name")
  enteredAt     DateTime           @default(now()) @map("entered_at") @db.Timestamptz
  actor         Json
  reason        StageHistoryReason

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([workspaceId, opportunityId, enteredAt(sort: Desc)])
  @@map("opportunity_stage_history")
}

/// "When this happens to a deal's person or company, move the deal to that stage" — forward only
/// unless `allowBackward`, and never twice for the same event.
model StageRule {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  pipelineId    String         @map("pipeline_id") @db.Uuid
  event         StageRuleEvent
  toStageId     String         @map("to_stage_id") @db.Uuid
  allowBackward Boolean        @default(false) @map("allow_backward")
  enabled       Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  toStage   PipelineStage @relation(fields: [toStageId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, event])
  @@index([workspaceId, event])
  @@map("stage_rules")
}

/// A note (PAR-010): a rich-text document attached to any number of records.
model Note {
  id          String                   @id @default(uuid()) @db.Uuid
  workspaceId String                   @map("workspace_id") @db.Uuid
  title       String                   @default("")
  /// `RichText` from @bylinecrm/shared, stored as the editor produced it.
  body        Json                     @default("{\"type\":\"doc\",\"content\":[]}")
  /// Derived from `body` by the application on every write; the search vector is built on it.
  bodyText    String                   @default("") @map("body_text")
  authorId    String?                  @map("author_id") @db.Uuid
  createdBy   Json                     @map("created_by")
  deletedAt   DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  search      Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(body_text, ''::text)))"))

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    WorkspaceMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  targets   NoteTarget[]

  @@index([workspaceId, deletedAt])
  @@index([search], type: Gin)
  @@map("notes")
}

/// One record a note is attached to. `RecordObject` names the table; `targetId` the row.
model NoteTarget {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  noteId      String       @map("note_id") @db.Uuid
  targetType  RecordObject @map("target_type")
  targetId    String       @map("target_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, targetType, targetId])
  @@index([workspaceId, targetType, targetId])
  @@map("note_targets")
}

/// A task (PAR-011). `completedAt` is set exactly when `status` is `done` (the database checks).
model Task {
  id                  String                   @id @default(uuid()) @db.Uuid
  workspaceId         String                   @map("workspace_id") @db.Uuid
  title               String
  body                Json                     @default("{\"type\":\"doc\",\"content\":[]}")
  bodyText            String                   @default("") @map("body_text")
  status              TaskStatus               @default(todo)
  dueAt               DateTime?                @map("due_at") @db.Timestamptz
  assigneeId          String?                  @map("assignee_id") @db.Uuid
  completedAt         DateTime?                @map("completed_at") @db.Timestamptz
  /// The sequence step that made it (#158): shown on the enrolment with its state; null for a member's task.
  sequenceEnrolmentId String?                  @map("sequence_enrolment_id") @db.Uuid
  sequenceStepId      String?                  @map("sequence_step_id") @db.Uuid
  createdBy           Json                     @map("created_by")
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  search              Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(body_text, ''::text)))"))

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee          WorkspaceMember?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  targets           TaskTarget[]
  sequenceEnrolment SequenceEnrolment? @relation(fields: [sequenceEnrolmentId], references: [id], onDelete: SetNull)
  sequenceStep      SequenceStep?      @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)
  notifications     Notification[]
  followUpFor       Opportunity[]      @relation("DealFollowUpTask")

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, status])
  @@index([sequenceEnrolmentId])
  @@index([search], type: Gin)
  @@map("tasks")
}

model TaskTarget {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  taskId      String       @map("task_id") @db.Uuid
  targetType  RecordObject @map("target_type")
  targetId    String       @map("target_id") @db.Uuid

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, targetType, targetId])
  @@index([workspaceId, targetType, targetId])
  @@map("task_targets")
}

/// A file on one record (PAR-016). The bytes are behind `FileStorage` under `storageKey`.
model Attachment {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  name        String
  storageKey  String       @unique @map("storage_key")
  mime        String
  sizeBytes   BigInt       @map("size_bytes")
  targetType  RecordObject @map("target_type")
  targetId    String       @map("target_id") @db.Uuid
  authorId    String?      @map("author_id") @db.Uuid
  createdBy   Json         @map("created_by")
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    WorkspaceMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, deletedAt])
  @@map("attachments")
}

/// A saved view (PAR-056): a filter, sorts, columns and grouping over one object, kept by a member
/// for themselves or shared with the workspace. P1-4.
model SavedView {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  object        RecordObject
  name          String
  icon          String?
  /// The member who made it; `null` once that seat is gone (a shared view outlives its author).
  ownerMemberId String?      @map("owner_member_id") @db.Uuid
  isShared      Boolean      @default(false) @map("is_shared")
  /// `FilterGroup` from @bylinecrm/shared, or `null` for "everything".
  filter        Json?
  /// `ViewSort[]` from @bylinecrm/shared.
  sorts         Json         @default("[]")
  /// `ViewColumn[]` from @bylinecrm/shared.
  columns       Json         @default("[]")
  groupBy       String?      @map("group_by")
  position      Float        @default(dbgenerated("extract(epoch from clock_timestamp())"))
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     WorkspaceMember? @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, object])
  @@index([workspaceId, ownerMemberId])
  @@map("saved_views")
}

// ─────────────────────────────────────────────────────────────────────────────
// Timeline (P1-3). One append-only list per record of what happened to it: its own domain
// events, the notes/tasks/files attached to it (one entry per record the thing is on), and
// what integrations report. Tenant table under RLS; the app role may read and insert, never
// update or delete — the migration grants exactly that.
// ─────────────────────────────────────────────────────────────────────────────

/// The things that attach to a record and leave `linked-…` entries on its timeline.
enum LinkedObject {
  note
  task
  attachment
  email
  suppression
  meeting
  transfer
  invoice

  @@map("linked_object")
}

/// One thing that happened to one record (PAR-013). `kind` is `<object>.<action>`,
/// `linked-<thing>.<action>` or `external.<kind>` (see `@bylinecrm/shared` timeline.ts).
model TimelineActivity {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  targetType     RecordObject  @map("target_type")
  targetId       String        @map("target_id") @db.Uuid
  kind           String
  happenedAt     DateTime      @map("happened_at") @db.Timestamptz
  /// `TimelineActor` from @bylinecrm/shared: who did it, or which rule or integration.
  actor          Json
  /// The field diff of an update, the linked thing's id and name, an external event's payload.
  properties     Json          @default("{}")
  linkedType     LinkedObject? @map("linked_type")
  linkedId       String?       @map("linked_id") @db.Uuid
  /// External entries only: the integration's name and its key, unique together per workspace.
  source         String?
  idempotencyKey String?       @map("idempotency_key")
  /// Domain-event entries only: the outbox event that wrote it. One entry per (event, record), so a
  /// redelivered event writes nothing new (P1-6).
  eventId        String?       @map("event_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source, idempotencyKey])
  @@unique([workspaceId, eventId, targetType, targetId])
  @@index([workspaceId, targetType, targetId, happenedAt(sort: Desc)])
  @@index([workspaceId, linkedType, linkedId])
  @@map("timeline_activities")
}

/// Where a delivery stands. `pending` is queued; `delivering` is in an attempt; `failed` is between
/// attempts; `succeeded` and `dead` are final (dead = every attempt failed).
enum WebhookDeliveryStatus {
  pending
  delivering
  succeeded
  failed
  dead

  @@map("webhook_delivery_status")
}

/// An outbound webhook endpoint (P1-5): a URL the workspace wants its events POSTed to, with the
/// secret the deliveries are signed with. The secret is held encrypted (it has to be used to sign,
/// so a hash would not do) and shown once; `secret_prefix` is what a list shows afterwards. During
/// a rotation the previous secret stays valid until `previous_secret_expires_at`, and deliveries
/// carry both signatures.
model WebhookEndpoint {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String    @map("workspace_id") @db.Uuid
  url                      String
  description              String    @default("")
  secretCiphertext         String    @map("secret_ciphertext")
  secretPrefix             String    @map("secret_prefix")
  previousSecretCiphertext String?   @map("previous_secret_ciphertext")
  previousSecretExpiresAt  DateTime? @map("previous_secret_expires_at") @db.Timestamptz
  /// Catalogue event types, or `*` for all of them.
  events                   String[]
  enabled                  Boolean   @default(true)
  /// Why the endpoint was switched off by the system (consecutive dead deliveries); null when a person did it or it is on.
  disabledReason           String?   @map("disabled_reason")
  /// Dead deliveries in a row; a success resets it. The auto-disable threshold reads it.
  consecutiveFailures      Int       @default(0) @map("consecutive_failures")
  createdById              String    @map("created_by_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  WorkspaceMember   @relation(fields: [createdById], references: [id])
  deliveries WebhookDelivery[]

  @@index([workspaceId, deletedAt])
  @@map("webhook_endpoints")
}

/// One event sent to one endpoint, and how that went. The payload is the envelope as sent, so a
/// redelivery resends exactly what the receiver was meant to get.
model WebhookDelivery {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String                @map("workspace_id") @db.Uuid
  endpointId       String                @map("endpoint_id") @db.Uuid
  /// The outbox event's id: one per published event, shared by every endpoint's delivery of it, and
  /// unique with the endpoint among automatic deliveries (partial unique index), so a redelivered event
  /// finds its deliveries instead of adding more (P1-6).
  eventId          String                @map("event_id") @db.Uuid
  /// A person's manual redelivery: the delivery it repeats. Outside the one-per-event rule; not a
  /// foreign key, since retention removes rows on its own schedule.
  redeliveryOfId   String?               @map("redelivery_of_id") @db.Uuid
  eventName        String                @map("event_name")
  payload          Json
  status           WebhookDeliveryStatus @default(pending)
  attempts         Int                   @default(0)
  nextAttemptAt    DateTime?             @map("next_attempt_at") @db.Timestamptz
  /// When the current or last attempt began; the sweep frees a `delivering` row stuck past the threshold.
  attemptStartedAt DateTime?             @map("attempt_started_at") @db.Timestamptz
  lastStatusCode   Int?                  @map("last_status_code")
  lastError        String?               @map("last_error")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  deliveredAt      DateTime?             @map("delivered_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([workspaceId, endpointId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("webhook_deliveries")
}

enum MailboxPurpose {
  personal
  pool
  /// SVC-1: a shared inbox read for an integration — mail only, no calendar or sending, on no record.
  service

  @@map("mailbox_purpose")
}

/// How a mailbox's mail leaves (TRANS-1): through its Gmail grant, or — a pool mailbox only — SMTP2Go's HTTP API.
enum MailboxTransport {
  gmail
  smtp2go

  @@map("mailbox_transport")
}

/// Where a Gmail mailbox's tokens come from (#225): its own OAuth grant, or the workspace's service account.
enum MailboxCredentialSource {
  oauth
  delegation

  @@map("mailbox_credential_source")
}

enum MailboxStatus {
  connected
  reconnect_needed
  disconnected

  @@map("mailbox_status")
}

/// The Google OAuth client a workspace's admin created in their own Google Cloud project (P2-1,
/// D-237): one per workspace. Mailboxes are connected through it, so their refresh tokens belong
/// to it. The secret is held encrypted (it is presented to Google, so a hash would not do) and only
/// its last four characters are ever shown.
model GoogleOAuthClient {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String    @unique @map("workspace_id") @db.Uuid
  clientId               String    @map("client_id")
  clientSecretCiphertext String    @map("client_secret_ciphertext")
  clientSecretLast4      String    @map("client_secret_last4")
  configuredById         String    @map("configured_by_id") @db.Uuid
  /// When a mailbox first connected through this client — the only end-to-end proof it works.
  verifiedAt             DateTime? @map("verified_at") @db.Timestamptz
  /// The last check's per-step outcomes and when it ran.
  lastCheck              Json?     @map("last_check")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuredBy WorkspaceMember @relation(fields: [configuredById], references: [id])

  @@map("google_oauth_clients")
}

/// The workspace's Google Workspace service account with domain-wide delegation (#225): one per workspace, an
/// admin's. The JSON key is sealed (`SecretBox`) and never returned; only the account's email and client ID are.
model GoogleWorkspaceDelegation {
  workspaceId       String   @id @map("workspace_id") @db.Uuid
  keyCiphertext     String   @map("key_ciphertext")
  clientEmail       String   @map("client_email")
  clientId          String   @map("client_id")
  privateKeyIdLast4 String   @map("private_key_id_last4")
  /// Lower case domains whose members' mailboxes and calendars are synced through the service account.
  allowedDomains    String[] @default([]) @map("allowed_domains")
  /// Members an admin excluded: never synced through the service account.
  excludedMemberIds String[] @default([]) @map("excluded_member_ids") @db.Uuid
  /// The scopes the last check found granted; delegation syncs only once it includes Gmail read.
  grantedScopes     String[] @default([]) @map("granted_scopes")
  /// The last check: `{ checkedAt, subject, scopes: [{ scope, granted, error }] }`.
  lastCheck         Json?    @map("last_check")
  updatedById       String?  @map("updated_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("google_workspace_delegations")
}

/// The delegation's audit log (#225): every key or setting change and every delegated sync start.
model GoogleWorkspaceDelegationAudit {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  action          String
  /// Who did it; null for the sync worker.
  actorMemberId   String?  @map("actor_member_id") @db.Uuid
  /// The member it concerns (an exclusion, a sync), when any.
  subjectMemberId String?  @map("subject_member_id") @db.Uuid
  mailboxId       String?  @map("mailbox_id") @db.Uuid
  /// Safe facts only (domains, scopes, an address) — never key material or a token.
  detail          Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("google_workspace_delegation_audit")
}

/// A Google mailbox connected to the workspace (P2-1). Its purpose is fixed when it connects. Tokens
/// are held encrypted and never leave the API; a disconnected mailbox keeps its row (history, the
/// email's uniqueness) and loses its tokens.
model Mailbox {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String                  @map("workspace_id") @db.Uuid
  ownerMemberId          String                  @map("owner_member_id") @db.Uuid
  /// Lower case; unique in the workspace.
  email                  String
  label                  String?
  purpose                MailboxPurpose
  /// TRANS-1: `smtp2go` only for a pool mailbox (the database checks); fixed when the mailbox is added.
  transport              MailboxTransport        @default(gmail)
  /// #225: `delegation` — tokens minted by the workspace's service account (no refresh token of its own); `oauth` otherwise.
  credentialSource       MailboxCredentialSource @default(oauth) @map("credential_source")
  /// #225: when this delegated mailbox's current run of syncing was audited; null until its next sync is.
  delegationAuditedAt    DateTime?               @map("delegation_audited_at") @db.Timestamptz
  status                 MailboxStatus
  grantedScopes          String[]                @default([]) @map("granted_scopes")
  refreshTokenCiphertext String?                 @map("refresh_token_ciphertext")
  accessTokenCiphertext  String?                 @map("access_token_ciphertext")
  accessExpiresAt        DateTime?               @map("access_expires_at") @db.Timestamptz
  /// Why the mailbox last stopped working: `{ code, message, at }`; null while it works.
  lastError              Json?                   @map("last_error")
  connectedAt            DateTime?               @map("connected_at") @db.Timestamptz
  /// A pool mailbox's own daily cap (P3-2); null takes the workspace's.
  poolDailyCap           Int?                    @map("pool_daily_cap")
  /// Day 1 of a pool mailbox's warm-up: when it first connected as a pool mailbox (P3-2).
  warmupStartedAt        DateTime?               @map("warmup_started_at") @db.Timestamptz
  /// Set while the mailbox is paused for its bounce or complaint rate (FR-CRMS-6, -13).
  pausedAt               DateTime?               @map("paused_at") @db.Timestamptz
  /// Why it was paused: `{ code, message, rate, threshold, at }`; null while it is not.
  pauseReason            Json?                   @map("pause_reason")
  /// The last time an admin resumed it, who and why (P3-2).
  resumedAt              DateTime?               @map("resumed_at") @db.Timestamptz
  resumedByMemberId      String?                 @map("resumed_by_member_id") @db.Uuid
  resumeNote             String?                 @map("resume_note")
  /// The mailbox's own signature (#193): `RichText` in the signature subset; null takes the workspace default.
  signature              Json?
  /// Off: the workspace default does not apply to this mailbox (#193).
  useDefaultSignature    Boolean                 @default(true) @map("use_default_signature")
  /// A pool mailbox's booking page, on the Slotline site, picked by an admin (#193); null for a personal mailbox.
  bookingLink            String?                 @map("booking_link")
  /// TRANS-1: an SMTP2Go mailbox's API key, sealed; never shown back. Null for a Gmail mailbox and once disconnected.
  transportKeyCiphertext String?                 @map("transport_key_ciphertext")
  /// TRANS-1: the bearer secret SMTP2Go's webhook sends in `Authorization`, sealed (an admin copies it into SMTP2Go).
  hookSecretCiphertext   String?                 @map("hook_secret_ciphertext")
  /// TRANS-1: when SMTP2Go's webhook last reached this mailbox, and what came of it.
  lastHookAt             DateTime?               @map("last_hook_at") @db.Timestamptz
  lastHookResult         String?                 @map("last_hook_result")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     WorkspaceMember   @relation(fields: [ownerMemberId], references: [id])
  resumedBy WorkspaceMember?  @relation("MailboxResumedBy", fields: [resumedByMemberId], references: [id], onDelete: SetNull)
  bounces   MailBounce[]
  threads   MailboxThread[]
  copies    MailMessageCopy[]
  syncState MailboxSyncState?

  outbound MailOutbound[]

  calendarCopies    CalendarEventCopy[]
  calendarSyncState CalendarSyncState?

  @@unique([workspaceId, email])
  @@index([workspaceId, ownerMemberId])
  @@map("mailboxes")
}

enum TemplateKind {
  personal
  outreach

  @@map("template_kind")
}

/// An email template (P2-4). `body` is the editor's rich-text document restricted to the template
/// subset (`TEMPLATE_BODY_NODES`); variables are `variable` nodes in it and `{{path}}` tokens in
/// `subject`. `version` is the optimistic-concurrency counter a PATCH must name.
model EmailTemplate {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  name        String
  kind        TemplateKind
  subject     String       @default("")
  /// `RichText` from @bylinecrm/shared.
  body        Json
  version     Int          @default(1)
  /// `Actor` from @bylinecrm/shared.
  createdBy   Json         @map("created_by")
  /// `Actor` from @bylinecrm/shared.
  updatedBy   Json         @map("updated_by")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  mailOutbound  MailOutbound[]
  sequenceSteps SequenceStep[]

  @@index([workspaceId, deletedAt, updatedAt(sort: Desc)])
  @@map("email_templates")
}

/// The workspace's mail settings (P2-4): one row per workspace, absent until first saved — a
/// workspace without one reads the defaults in @bylinecrm/shared.
model WorkspaceMailSettings {
  workspaceId           String   @id @map("workspace_id") @db.Uuid
  /// `PostalAddress` from @bylinecrm/shared, or null.
  postalAddress         Json?    @map("postal_address")
  defaultSenderName     String?  @map("default_sender_name")
  unsubscribeFooterText String   @map("unsubscribe_footer_text")
  /// `Actor` from @bylinecrm/shared.
  updatedBy             Json     @map("updated_by")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_mail_settings")
}

/// The workspace's signature settings (#193): its default signature and an admin's locks. Absent until first
/// saved — a workspace without one has no default and nothing locked.
model WorkspaceSignatureSettings {
  workspaceId      String   @id @map("workspace_id") @db.Uuid
  /// `RichText` in the signature subset, or null for no default.
  defaultSignature Json?    @map("default_signature")
  /// Every signature must carry `{{workspace.logo}}` / `{{sender.bookingLink}}`.
  lockLogo         Boolean  @default(false) @map("lock_logo")
  lockBookingLink  Boolean  @default(false) @map("lock_booking_link")
  /// `Actor` from @bylinecrm/shared.
  updatedBy        Json     @map("updated_by")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_signature_settings")
}

/// A workspace logo (#193), served publicly at `/api/public/logos/<token>.png` so recipients' mail clients show
/// it without a sign-in. The current logo has no `retiredAt`; a replaced one keeps answering for the grace
/// period, for mail already sent, and is removed after it.
model WorkspaceLogo {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  /// Unguessable, and public: it is in every email that shows the logo.
  token        String    @unique
  storageKey   String    @unique @map("storage_key")
  width        Int
  height       Int
  sizeBytes    Int       @map("size_bytes")
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  retiredAt    DateTime? @map("retired_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy WorkspaceMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, retiredAt])
  @@map("workspace_logos")
}

/// An image uploaded for mail: a template's or a composed email's body, or a signature. Served publicly at
/// an unguessable address so recipients' mail clients load it with no sign-in; kept for mail already sent.
model MailAsset {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  /// Unguessable, and public: it is in every email that shows the image.
  token        String   @unique
  storageKey   String   @unique @map("storage_key")
  /// `image/png` or `image/jpeg`: the bytes as stored, re-encoded on upload.
  contentType  String   @map("content_type")
  width        Int
  height       Int
  sizeBytes    Int      @map("size_bytes")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy WorkspaceMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("mail_assets")
}

/// A message being written in a composer, saved as its author goes (the composer's autosave) and on leaving it —
/// private to its author. One per composer: a person's (and deal's) record composer, or a reply to a message in a
/// thread (`replyToMessageId`); reopening that composer restores it. Sending or scheduling it deletes it. `content` is the composer's state as the API's
/// `MailDraftContent` (recipients, subject, body, template, signature, schedule, follow-ups), checked for shape
/// and size only: a draft may be unfinished. `version` guards every write — a write naming another version is a
/// `409`, never a silent overwrite of another tab's.
model MailDraft {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  authorMemberId   String   @map("author_member_id") @db.Uuid
  personId         String   @map("person_id") @db.Uuid
  dealId           String?  @map("deal_id") @db.Uuid
  /// A reply's draft: the message it answers (the thread's newest when it was started). Null for a new email.
  replyToMessageId String?  @map("reply_to_message_id") @db.Uuid
  content          Json
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    WorkspaceMember @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)
  person    Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  deal      Opportunity?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  replyTo   MailMessage?    @relation("MailDraftReplyTo", fields: [replyToMessageId], references: [id], onDelete: Cascade)

  // One draft per composer — (author, person, deal or none, reply-to or none): a unique index NULLS NOT DISTINCT,
  // in the migration.
  @@index([workspaceId, authorMemberId, personId])
  @@index([dealId])
  @@index([replyToMessageId])
  @@map("mail_drafts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Mail sync (P2-2): what a connected Gmail mailbox holds, matched to the records it concerns.
// ─────────────────────────────────────────────────────────────────────────────

enum MailDirection {
  inbound
  outbound

  @@map("mail_direction")
}

enum MailParticipantRole {
  from
  to
  cc
  bcc

  @@map("mail_participant_role")
}

enum MailSyncStatus {
  idle
  syncing
  failed

  @@map("mail_sync_status")
}

enum MailOutboundStatus {
  scheduled
  queued
  sending
  sent
  failed
  cancelled

  @@map("mail_outbound_status")
}

/// A message the CRM sends (P2-3), from its sender's own personal mailbox. Built once — `mime` is
/// exactly what goes to Gmail — then sent by a queued job. `rfc822MessageId` is ours (`<uuid>@bylinecrm`);
/// once sent, `providerMessageId` / `providerThreadId` are Gmail's and `mailMessageId` the stored copy
/// sync's writer made of it. Gmail rewrites the Message-ID we set (#87), so `providerRfc822MessageId`
/// holds Gmail's once known; every MIME also carries `X-BylineCRM-Id: <id>`, which Gmail keeps.
/// Replies are recognised against these.
model MailOutbound {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String             @map("workspace_id") @db.Uuid
  mailboxId               String             @map("mailbox_id") @db.Uuid
  senderMemberId          String             @map("sender_member_id") @db.Uuid
  /// The person the message is to and about (the template's context).
  personId                String?            @map("person_id") @db.Uuid
  dealId                  String?            @map("deal_id") @db.Uuid
  templateId              String?            @map("template_id") @db.Uuid
  /// The stored message this one answers.
  replyToMessageId        String?            @map("reply_to_message_id") @db.Uuid
  status                  MailOutboundStatus @default(queued)
  rfc822MessageId         String             @unique @map("rfc822_message_id")
  toAddresses             String[]           @map("to_addresses")
  ccAddresses             String[]           @default([]) @map("cc_addresses")
  bccAddresses            String[]           @default([]) @map("bcc_addresses")
  subject                 String
  /// REP-1: 64-bit simhash of the normalised body as built; null for a scheduled send not built yet.
  bodySimhash             BigInt?            @map("body_simhash")
  /// REP-1: the normalised subject.
  subjectKey              String?            @map("subject_key")
  /// Exactly what goes to Gmail. Null while `scheduled` (it is built when the send's time comes), and
  /// on a scheduled send cancelled, or failed by a check at its time, before it was built.
  mime                    String?
  /// When a scheduled send goes (UTC); null for a send made at once.
  sendAt                  DateTime?          @map("send_at") @db.Timestamptz
  /// The sender's IANA time zone as they scheduled it — echoed back, never used to compute `sendAt`.
  senderTimeZone          String?            @map("sender_time_zone")
  /// What a scheduled send was asked to be (`SendInput` without `sendAt`): built and checked again at
  /// `sendAt`, as its sender's role and the person stand then.
  request                 Json?
  cancelledAt             DateTime?          @map("cancelled_at") @db.Timestamptz
  /// When a failed send was last sent again by hand (#134); null if never.
  retriedAt               DateTime?          @map("retried_at") @db.Timestamptz
  providerMessageId       String?            @map("provider_message_id")
  providerThreadId        String?            @map("provider_thread_id")
  /// Gmail's own Message-ID for the sent message, once known (from the stored copy). Not ours: Gmail
  /// replaces the one we set.
  providerRfc822MessageId String?            @map("provider_rfc822_message_id")
  mailMessageId           String?            @map("mail_message_id") @db.Uuid
  attempts                Int                @default(0)
  lastAttemptAt           DateTime?          @map("last_attempt_at") @db.Timestamptz
  /// `{ code, message, at }` while the last attempt failed; null after a clean one.
  lastError               Json?              @map("last_error")
  sentAt                  DateTime?          @map("sent_at") @db.Timestamptz
  /// TRANS-1: when the recipient's server accepted it, as the provider reported (SMTP2Go's `delivered`; the first
  /// recipient's, for a send to several); null when not reported — Gmail reports nothing of the kind.
  deliveredAt             DateTime?          @map("delivered_at") @db.Timestamptz
  /// TRANS-1: an admin's "Send test" through an SMTP2Go pool mailbox, to themselves. Left out of the mailbox's
  /// allowance, spacing and rates, so a test never holds back a real send.
  isTest                  Boolean            @default(false) @map("is_test")
  /// The sequence step this send is (P3-3); null for 1:1 mail.
  sequenceEnrolmentId     String?            @map("sequence_enrolment_id") @db.Uuid
  sequenceStepId          String?            @map("sequence_step_id") @db.Uuid
  /// A queued follow-up: the send it follows in the same thread — built as a reply to that one's stored copy
  /// once it has gone; cancelled when that one fails or is cancelled, or when the person answers. Null otherwise.
  followsOutboundId       String?            @map("follows_outbound_id") @db.Uuid
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox     Mailbox         @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  sender      WorkspaceMember @relation("MailOutboundSender", fields: [senderMemberId], references: [id])
  person      Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  deal        Opportunity?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  template    EmailTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  replyTo     MailMessage?    @relation("MailOutboundReplyTo", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  mailMessage MailMessage?    @relation("MailOutboundStored", fields: [mailMessageId], references: [id], onDelete: SetNull)

  suppressions      Suppression[]
  unsubscribeTokens UnsubscribeToken[]
  bounces           MailBounce[]
  trackingTokens    TrackingToken[]
  trackingHits      TrackingHit[]

  sequenceEnrolment SequenceEnrolment? @relation("EnrolmentSends", fields: [sequenceEnrolmentId], references: [id], onDelete: SetNull)
  sequenceStep      SequenceStep?      @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)
  waitingEnrolment  SequenceEnrolment? @relation("EnrolmentWaitingSend")

  follows   MailOutbound?  @relation("MailOutboundFollowUps", fields: [followsOutboundId], references: [id], onDelete: SetNull)
  followUps MailOutbound[] @relation("MailOutboundFollowUps")

  @@index([workspaceId, senderMemberId, createdAt(sort: Desc)])
  @@index([mailboxId, providerThreadId])
  @@index([workspaceId, mailMessageId])
  @@index([status, sendAt])
  @@index([providerRfc822MessageId])
  @@index([sequenceEnrolmentId])
  @@index([followsOutboundId])
  @@map("mail_outbound")
}

/// A conversation, once per workspace however many mailboxes hold it (#107). `subject` is its first
/// message's; the count and last message follow the messages (one writer, `recountThread`). Each
/// mailbox's Gmail thread maps to it through `MailboxThread`.
model MailThread {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  subject       String   @default("")
  lastMessageAt DateTime @map("last_message_at") @db.Timestamptz
  messageCount  Int      @default(0) @map("message_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages       MailMessage[]
  mailboxThreads MailboxThread[]

  @@index([workspaceId, lastMessageAt(sort: Desc)])
  @@map("mail_threads")
}

/// A mailbox's Gmail thread, and the conversation it is part of (#107). A reply sent from a mailbox goes
/// into that mailbox's Gmail thread.
model MailboxThread {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  mailboxId        String   @map("mailbox_id") @db.Uuid
  providerThreadId String   @map("provider_thread_id")
  threadId         String   @map("thread_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox           @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  // Restrict: a thread goes only once no mailbox maps a Gmail thread to it (a mapping may hold copies of
  // messages another thread has, when Gmail threads them differently).
  thread    MailThread        @relation(fields: [threadId], references: [id], onDelete: Restrict)
  copies    MailMessageCopy[]

  @@unique([mailboxId, providerThreadId])
  @@index([threadId])
  @@map("mailbox_threads")
}

/// An email, once per workspace however many of its mailboxes hold it (#107): keyed by `identityKey` — its
/// RFC 822 Message-ID (Gmail's own, which replaces ours, #87), or `gmail:<mailbox>:<gmail id>` for a message
/// with none. Each mailbox holding it is a `MailMessageCopy`. The body is kept sanitised (HTML) and as text;
/// `snippet` is Gmail's. `direction` is the workspace's view: outbound when sent from one of its mailboxes.
model MailMessage {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  threadId          String        @map("thread_id") @db.Uuid
  identityKey       String        @map("identity_key")
  rfc822MessageId   String?       @map("rfc822_message_id")
  inReplyTo         String?       @map("in_reply_to")
  references        String[]      @default([])
  direction         MailDirection
  fromAddress       String        @map("from_address")
  sentAt            DateTime      @map("sent_at") @db.Timestamptz
  snippet           String        @default("")
  subject           String        @default("")
  bodyText          String        @default("") @map("body_text")
  bodyHtmlSanitized String?       @map("body_html_sanitized")
  bodyTruncated     Boolean       @default(false) @map("body_truncated")
  hasAttachments    Boolean       @default(false) @map("has_attachments")
  /// REP-1: 64-bit simhash of the normalised body (outbound only; filled when first judged).
  bodySimhash       BigInt?       @map("body_simhash")
  /// REP-1: the normalised subject (outbound only; filled with `bodySimhash`).
  subjectKey        String?       @map("subject_key")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread       MailThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  participants MailParticipant[]
  copies       MailMessageCopy[]

  repliedFrom  MailOutbound[] @relation("MailOutboundReplyTo")
  draftReplies MailDraft[]    @relation("MailDraftReplyTo")
  outboundOf   MailOutbound[] @relation("MailOutboundStored")
  bounces      MailBounce[]

  @@unique([workspaceId, identityKey])
  @@index([workspaceId, threadId, sentAt])
  @@index([workspaceId, rfc822MessageId])
  @@map("mail_messages")
}

/// One mailbox's copy of a message (#107): Gmail's id for it there, the Gmail thread it is in there, its
/// labels, and its direction from that mailbox's view. Unique per mailbox and Gmail id — sync's dedupe key.
model MailMessageCopy {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  messageId         String        @map("message_id") @db.Uuid
  mailboxId         String        @map("mailbox_id") @db.Uuid
  mailboxThreadId   String        @map("mailbox_thread_id") @db.Uuid
  providerMessageId String        @map("provider_message_id")
  direction         MailDirection
  labelIds          String[]      @default([]) @map("label_ids")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message       MailMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mailbox       Mailbox       @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  mailboxThread MailboxThread @relation(fields: [mailboxThreadId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, providerMessageId])
  @@index([messageId])
  @@index([mailboxThreadId])
  @@map("mail_message_copies")
}

/// One address on one message, matched to a person and/or a member of the workspace when it can be.
model MailParticipant {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  messageId   String              @map("message_id") @db.Uuid
  role        MailParticipantRole
  /// Lower case (the database checks).
  address     String
  displayName String              @default("") @map("display_name")
  personId    String?             @map("person_id") @db.Uuid
  memberId    String?             @map("member_id") @db.Uuid

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   MailMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  person    Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, address])
  @@index([workspaceId, personId])
  @@index([messageId])
  @@map("mail_participants")
}

/// Where a mailbox's sync stands: Gmail's history cursor, the last run and why it stopped, if it did.
model MailboxSyncState {
  mailboxId           String         @id @map("mailbox_id") @db.Uuid
  workspaceId         String         @map("workspace_id") @db.Uuid
  historyId           String?        @map("history_id")
  status              MailSyncStatus @default(idle)
  lastSyncedAt        DateTime?      @map("last_synced_at") @db.Timestamptz
  /// `{ code, message, at, rateLimitedRuns? }` while the last run failed or was skipped; null after a clean run.
  /// `rateLimitedRuns` counts consecutive runs that ended rate-limited — the tick's cool-down reads it.
  lastError           Json?          @map("last_error")
  fullSyncCompletedAt DateTime?      @map("full_sync_completed_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("mailbox_sync_states")
}

/// An address or `@domain` whose mail is not imported: the member's own (personal) or everyone's.
model BlocklistEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  /// Null for a workspace-wide entry; the member's id for a personal one.
  memberId    String?  @map("member_id") @db.Uuid
  /// Lower case: `someone@example.com` or `@example.com`.
  value       String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember? @relation("BlocklistOwner", fields: [memberId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember? @relation("BlocklistCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, memberId])
  @@map("blocklist_entries")
}

/// A platform sign-up invitation (P0-14): in `invite` sign-up mode, the only way to create an account
/// with a workspace of one's own. Global, operator-level: the app role has no grant on it; the
/// platform service writes it through the owner client. Only the token's hash is stored.
model PlatformSignupInvite {
  id              String    @id @default(uuid()) @db.Uuid
  email           String
  tokenHash       String    @unique @map("token_hash")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  usedAt          DateTime? @map("used_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("platform_signup_invites")
}

/// Every platform action, appended in the transaction that made it (P0-14). Append-only: a trigger
/// refuses UPDATE and DELETE for every role, the owner included; the app role has no grant at all.
model PlatformAudit {
  id          String   @id @default(uuid()) @db.Uuid
  action      String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  subject     Json     @default("{}")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([occurredAt])
  @@map("platform_audit")
}

// ─────────────────────────────────────────────────────────────────────────────
// Outbox (P1-6). A mutation records its domain event here in the same transaction as the change;
// the relay delivers each row to the in-process consumers at least once. Tenant table under RLS;
// the app role may read and insert, never update or delete — delivery state is the relay's, which
// runs as the owner. The relay's scan uses a partial index on open rows (see the migration).
// ─────────────────────────────────────────────────────────────────────────────

/// One domain event, recorded with the change that caused it.
model OutboxEvent {
  id                 String    @id @db.Uuid
  /// Insertion order, for the relay's scan; not commit order.
  seq                BigInt    @unique @default(autoincrement())
  workspaceId        String    @map("workspace_id") @db.Uuid
  type               String
  /// The `DomainEvent` from @bylinecrm/shared, as published.
  payload            Json
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// The consumers that have handled the event; a retry runs only the others.
  completedConsumers String[]  @default([]) @map("completed_consumers")
  attempts           Int       @default(0)
  /// When a failed delivery may be retried; null means now.
  nextAttemptAt      DateTime? @map("next_attempt_at") @db.Timestamptz
  /// A relay has claimed the row until then; past it, any relay may claim it again.
  leaseUntil         DateTime? @map("lease_until") @db.Timestamptz
  lastError          String?   @map("last_error")
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  /// Every attempt failed; kept for inspection, never retried.
  failedAt           DateTime? @map("failed_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([completedAt])
  @@map("outbox_events")
}

/// Why an address is suppressed (P3-1, FR-CRMS-7). `unsubscribe` and `complaint` are never lifted in the CRM.
enum SuppressionReason {
  unsubscribe
  hard_bounce
  complaint
  manual

  @@map("suppression_reason")
}

/// What put an address on the list: the person (the unsubscribe link), a member, or a provider's report (P3-2).
enum SuppressionSource {
  recipient
  member
  provider

  @@map("suppression_source")
}

/// An address the workspace never mails (P3-1, FR-CRMS-7): every send and every enrolment checks the
/// live entries. One live entry per address; lifting one records who, when and why (`removed_*`) and
/// keeps the row, so the history of an address stays on record.
model Suppression {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  /// Lower case (the database checks).
  address           String
  reason            SuppressionReason
  source            SuppressionSource
  /// The person the address belonged to when it was suppressed, when known.
  personId          String?           @map("person_id") @db.Uuid
  /// The message that led to it (the one whose link was used, or that bounced), when known.
  outboundId        String?           @map("outbound_id") @db.Uuid
  note              String?
  createdByMemberId String?           @map("created_by_member_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  removedAt         DateTime?         @map("removed_at") @db.Timestamptz
  removedByMemberId String?           @map("removed_by_member_id") @db.Uuid
  removalNote       String?           @map("removal_note")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  outbound  MailOutbound?    @relation(fields: [outboundId], references: [id], onDelete: SetNull)
  createdBy WorkspaceMember? @relation("SuppressionCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  removedBy WorkspaceMember? @relation("SuppressionRemover", fields: [removedByMemberId], references: [id], onDelete: SetNull)

  // One live entry per address — the partial unique index `suppressions_live_address_key` in the
  // migration (`removed_at IS NULL`), which is also what every check reads.
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("suppressions")
}

/// The secret behind one unsubscribe link (P3-1): one per (workspace, recipient, message). Only its
/// SHA-256 is stored; the token names nothing. It does not expire — an unsubscribe link keeps working.
model UnsubscribeToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  /// Lower case (the database checks).
  address     String
  personId    String?   @map("person_id") @db.Uuid
  outboundId  String?   @map("outbound_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// The last time it unsubscribed its address; a used token keeps working.
  usedAt      DateTime? @map("used_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  outbound  MailOutbound? @relation(fields: [outboundId], references: [id], onDelete: SetNull)

  @@index([workspaceId, address])
  @@map("unsubscribe_tokens")
}

/// A workspace's sending-pool settings (P3-2, FR-CRMS-6, -13); defaults in docs/design-notes/P3-2.md.
/// Rates are in basis points (1/100 of a percent): 500 = 5%.
/// REP-1 (FR-CRMS-23): the workspace's sender-reputation thresholds; absent = the defaults
/// (`REPUTATION_DEFAULTS`). Bounds are checked by the database as by the API.
model ReputationSettings {
  workspaceId            String   @id @map("workspace_id") @db.Uuid
  dailyNewRecipients     Int      @default(50) @map("daily_new_recipients")
  hourlyNewRecipients    Int      @default(20) @map("hourly_new_recipients")
  poolHourlyCap          Int      @default(12) @map("pool_hourly_cap")
  nearDuplicateThreshold Int      @default(10) @map("near_duplicate_threshold")
  nearDuplicateDistance  Int      @default(3) @map("near_duplicate_distance")
  subjectRepeatThreshold Int      @default(10) @map("subject_repeat_threshold")
  /// Lower case; null = not set (no primary-domain rule).
  primaryDomain          String?  @map("primary_domain")
  /// REP-2: reply-rate floor (basis points), on at least `replyRateMinSends` new-thread sends over the window.
  replyRateFloorBps      Int      @default(100) @map("reply_rate_floor_bps")
  replyRateMinSends      Int      @default(50) @map("reply_rate_min_sends")
  replyRateWindowDays    Int      @default(7) @map("reply_rate_window_days")
  /// REP-2: Postmaster spam-rate kill switch and warn line (basis points).
  spamPauseBps           Int      @default(30) @map("spam_pause_bps")
  spamWarnBps            Int      @default(10) @map("spam_warn_bps")
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("reputation_settings")
}

model SendingPoolSettings {
  workspaceId       String   @id @map("workspace_id") @db.Uuid
  dailyCap          Int      @default(40) @map("daily_cap")
  warmupStartPerDay Int      @default(5) @map("warmup_start_per_day")
  warmupDays        Int      @default(21) @map("warmup_days")
  jitterMinSeconds  Int      @default(60) @map("jitter_min_seconds")
  jitterMaxSeconds  Int      @default(300) @map("jitter_max_seconds")
  bouncePauseBps    Int      @default(500) @map("bounce_pause_bps")
  complaintPauseBps Int      @default(20) @map("complaint_pause_bps")
  rateMinSample     Int      @default(20) @map("rate_min_sample")
  rateWindowDays    Int      @default(7) @map("rate_window_days")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sending_pool_settings")
}

enum SendingDomainStatus {
  unchecked
  pass
  fail

  @@map("sending_domain_status")
}

/// What the last check learned from Postmaster Tools about a sending domain (#129).
enum PostmasterDomainStatus {
  not_connected
  not_verified
  ok
  /// #183: Google's quota said not now; the last reading stands.
  rate_limited
  /// #190: the project's Postmaster Tools API quota is spent (a 429, RESOURCE_EXHAUSTED naming it); an admin raises it.
  quota_exhausted
  /// #183: Google could not be reached or did not answer.
  unreachable
  failed

  @@map("postmaster_domain_status")
}

enum PostmasterConnectionStatus {
  connected
  reconnect_needed

  @@map("postmaster_connection_status")
}

/// A sending domain and its last DNS check (FR-CRMS-13): every connected mailbox's domain, pool or personal, and
/// every domain the connected Postmaster Tools account lists (#190). One row per domain per workspace; what uses it
/// is derived from the mailboxes, and only a pool mailbox's domain is gated.
model SendingDomain {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String                 @map("workspace_id") @db.Uuid
  /// Lower case.
  domain                 String
  /// The primary (Gmail) DKIM selector, `<selector>._domainkey.<domain>`: checked while a Gmail-transport mailbox
  /// sends from the domain, or when no other selector is known.
  dkimSelector           String                 @default("google") @map("dkim_selector")
  /// The other selectors the domain's senders sign with (each SMTP2Go mailbox's, TRANS-1); every one is checked.
  extraDkimSelectors     String[]               @default([]) @map("extra_dkim_selectors")
  status                 SendingDomainStatus    @default(unchecked)
  /// The last check's per-step results: `{ spf, dkim, dmarc }`, each `{ outcome, message }`.
  lastCheck              Json?                  @map("last_check")
  checkedAt              DateTime?              @map("checked_at") @db.Timestamptz
  nextCheckAt            DateTime               @default(now()) @map("next_check_at") @db.Timestamptz
  /// What the last check learned from Postmaster Tools (#129), and why when it is not `ok`.
  postmasterStatus       PostmasterDomainStatus @default(not_connected) @map("postmaster_status")
  postmasterMessage      String?                @map("postmaster_message")
  /// #183: when the check asks Postmaster Tools again; a check before then keeps the last reading. Null: ask now.
  postmasterNextReadAt   DateTime?              @map("postmaster_next_read_at") @db.Timestamptz
  /// #183: consecutive rate limits, for the backoff; reset by any other answer.
  postmasterLimitedTimes Int                    @default(0) @map("postmaster_limited_times")
  /// #190: when the check last asked Postmaster Tools, whatever it answered.
  postmasterReadAt       DateTime?              @map("postmaster_read_at") @db.Timestamptz
  /// #190: the connected Postmaster Tools account lists the domain (its daily `domains.list`).
  inPostmaster           Boolean                @default(false) @map("in_postmaster")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stats     SendingDomainStat[]

  @@unique([workspaceId, domain])
  @@index([nextCheckAt])
  @@map("sending_domains")
}

/// A day's statistics for a sending domain, as Postmaster Tools published them (#129, #190): the
/// user-reported spam rate and the delivery-error rate, either null when Google gave none that day.
/// One row per domain and day, replaced when the day is read again, never deleted by the app.
model SendingDomainStat {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  domainId         String   @map("domain_id") @db.Uuid
  /// The day the rate is for, UTC.
  day              DateTime @db.Date
  /// Basis points: 35 = 0.35%.
  spamRateBps      Int?     @map("spam_rate_bps")
  /// #190: rejects and temporary failures over what was sent, basis points.
  deliveryErrorBps Int?     @map("delivery_error_bps")
  fetchedAt        DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain    SendingDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, day])
  @@map("sending_domain_stats")
}

/// The one Google account a workspace connected for Postmaster Tools (#129), through its own OAuth
/// client: the account that verified the sending domains there. Tokens are held encrypted like a
/// mailbox's; `reconnect_needed` when Google refused the grant. Deleted when disconnected.
model PostmasterConnection {
  workspaceId            String                     @id @map("workspace_id") @db.Uuid
  /// Lower case: the Google account's address.
  email                  String
  status                 PostmasterConnectionStatus @default(connected)
  grantedScopes          String[]                   @default([]) @map("granted_scopes")
  refreshTokenCiphertext String                     @map("refresh_token_ciphertext")
  accessTokenCiphertext  String                     @map("access_token_ciphertext")
  accessExpiresAt        DateTime                   @map("access_expires_at") @db.Timestamptz
  /// Why it needs reconnecting; null while it works.
  lastError              String?                    @map("last_error")
  connectedByMemberId    String                     @map("connected_by_member_id") @db.Uuid
  connectedAt            DateTime                   @map("connected_at") @db.Timestamptz
  /// #190: when the account's domain list is read again (daily); null: at the next maintenance pass.
  domainsNextListAt      DateTime?                  @map("domains_next_list_at") @db.Timestamptz
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy WorkspaceMember @relation(fields: [connectedByMemberId], references: [id])

  @@map("postmaster_connections")
}

/// A delivery failure a pool mailbox was told about (P3-2): one row per bounce report and failed address.
model MailBounce {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  mailboxId       String   @map("mailbox_id") @db.Uuid
  /// The bounce report as stored (the message the mailbox received); null for one SMTP2Go reported (TRANS-1).
  messageId       String?  @map("message_id") @db.Uuid
  /// TRANS-1: SMTP2Go's report of it, as a key that makes a redelivered webhook change nothing.
  providerEventId String?  @map("provider_event_id")
  /// The address that failed; lower case.
  address         String
  /// A 5.x.x status: the address will never take mail. A 4.x.x one is recorded, never counted.
  permanent       Boolean
  /// The enhanced status code the report gave (`5.1.1`), when it gave one.
  status          String?
  /// The send that bounced, when the report names it.
  outboundId      String?  @map("outbound_id") @db.Uuid
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox       @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  message   MailMessage?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  outbound  MailOutbound? @relation(fields: [outboundId], references: [id], onDelete: SetNull)

  @@unique([mailboxId, messageId, address])
  @@unique([mailboxId, providerEventId])
  @@index([mailboxId, occurredAt])
  @@map("mail_bounces")
}

// ── Sequences (P3-3, FR-CRMS-5, -10, -11, -12) — docs/design-notes/P3-3.md ─────────────────────

enum RegionCode {
  eu
  uk
  ca
  us
  other
  unknown

  @@map("region_code")
}

/// A workspace's outreach policy for one region (FR-CRMS-12): an override of `DEFAULT_REGION_POLICY`.
/// Allowing a region blocked by default needs a lawful basis (the database checks).
model RegionPolicy {
  workspaceId       String     @map("workspace_id") @db.Uuid
  region            RegionCode
  allowed           Boolean
  lawfulBasis       String?    @map("lawful_basis")
  updatedByMemberId String?    @map("updated_by_member_id") @db.Uuid
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy WorkspaceMember? @relation(fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@id([workspaceId, region])
  @@map("region_policies")
}

/// Every change to a region's policy (#141): append-only, written in the same transaction as the change.
model RegionPolicyChange {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String     @map("workspace_id") @db.Uuid
  region            RegionCode
  allowed           Boolean
  lawfulBasis       String?    @map("lawful_basis")
  changedByMemberId String?    @map("changed_by_member_id") @db.Uuid
  changedAt         DateTime   @default(now()) @map("changed_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  changedBy WorkspaceMember? @relation(fields: [changedByMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, changedAt])
  @@map("region_policy_changes")
}

enum ExclusionReason {
  customer
  account_managed

  @@map("exclusion_reason")
}

/// Someone outreach must never reach (FR-CRMS-10): a customer, or a contact an account manager works.
/// By address or by domain (exactly one; lower case). Removing keeps the row. One live entry per
/// address and per domain (partial unique indexes, in the migration).
model OutreachExclusion {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String          @map("workspace_id") @db.Uuid
  address            String?
  domain             String?
  reason             ExclusionReason
  accountManagerName String?         @map("account_manager_name")
  /// An integration's key (`newswireos`), or `manual`.
  source             String
  externalRef        String?         @map("external_ref")
  note               String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  removedAt          DateTime?       @map("removed_at") @db.Timestamptz
  removedNote        String?         @map("removed_note")
  /// #242: why an automatic (`won_deal`) exclusion needs an admin's look: `deal_reopened` or `deal_refunded`.
  reviewReason       String?         @map("review_reason")
  reviewFlaggedAt    DateTime?       @map("review_flagged_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, source, externalRef])
  @@map("outreach_exclusions")
}

/// #242: how a won deal excludes its customer from outreach. No row means the defaults.
model CustomerExclusionSettings {
  workspaceId       String   @id @map("workspace_id") @db.Uuid
  /// `address` (the point of contact's primary address) or `domain` (their company's; checked by the database).
  wonExclusionScope String   @default("address") @map("won_exclusion_scope")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("customer_exclusion_settings")
}

/// OWN-1 (owner decision 2): Settings → Ownership. No row means the defaults.
model OwnershipSettings {
  workspaceId         String   @id @map("workspace_id") @db.Uuid
  /// Days a transferred record cannot go back to the member it left (0–90, checked by the database; 0 is off).
  transferCoolingDays Int      @default(14) @map("transfer_cooling_days")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ownership_settings")
}

/// GUARD-2: Settings → Guardrails. No row means the defaults (no email at once, no shared mailboxes).
model GuardrailSettings {
  workspaceId            String   @id @map("workspace_id") @db.Uuid
  /// A `high` poaching alert is also emailed at once (the bell and the digest always tell).
  poachEmailAtOnce       Boolean  @default(false) @map("poach_email_at_once")
  /// Members that are shared mailboxes (outreach@): leads they own count as nobody's to GUARD-1 and GUARD-2.
  sharedMailboxMemberIds String[] @default([]) @map("shared_mailbox_member_ids") @db.Uuid
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("guardrail_settings")
}

/// #192: who sees a sequence.
enum SequenceVisibility {
  shared
  private

  @@map("sequence_visibility")
}

enum SequenceStatus {
  draft
  active
  paused
  archived

  @@map("sequence_status")
}

enum SequenceStepKind {
  email
  wait
  task

  @@map("sequence_step_kind")
}

enum EnrolmentStatus {
  active
  held
  finished
  stopped

  @@map("enrolment_status")
}

enum EnrolmentStopReason {
  reply
  bounce
  unsubscribe
  complaint
  suppressed
  manual
  pipeline_exit
  excluded
  sequence_archived
  person_deleted
  region_blocked
  invalid_address

  @@map("enrolment_stop_reason")
}

/// A drip (FR-CRMS-5): ordered steps run per enrolled person, inside a send window in the recipient's
/// local time. Workspace-wide, not a member's.
model Sequence {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String             @map("workspace_id") @db.Uuid
  name               String
  status             SequenceStatus     @default(draft)
  /// A deal leaving this pipeline (or closing) stops its enrolment, when `stopOnPipelineExit`.
  pipelineId         String?            @map("pipeline_id") @db.Uuid
  stopOnPipelineExit Boolean            @default(true) @map("stop_on_pipeline_exit")
  /// The zone used when a recipient's cannot be inferred.
  timeZone           String             @map("time_zone")
  windowStartMinute  Int                @default(540) @map("window_start_minute")
  windowEndMinute    Int                @default(1020) @map("window_end_minute")
  /// Monday-first bitmask (bit 0 Monday … bit 6 Sunday).
  windowDays         Int                @default(31) @map("window_days")
  createdBy          Json               @map("created_by")
  /// #192: whose sequence it is — who made it, or whose API key did; null when neither is known.
  ownerMemberId      String?            @map("owner_member_id") @db.Uuid
  /// #192: `shared` (everyone who may enrol) or `private` (the owner and admins only).
  visibility         SequenceVisibility @default(shared)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt         DateTime?          @map("archived_at") @db.Timestamptz

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner      WorkspaceMember?    @relation("SequenceOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  pipeline   Pipeline?           @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  steps      SequenceStep[]
  enrolments SequenceEnrolment[]

  @@index([workspaceId, status])
  @@map("sequences")
}

/// One step: an email from an outreach template, or a wait. Positions are 0..n-1.
model SequenceStep {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String           @map("workspace_id") @db.Uuid
  sequenceId    String           @map("sequence_id") @db.Uuid
  position      Int
  kind          SequenceStepKind
  templateId    String?          @map("template_id") @db.Uuid
  /// Sent as a reply in the previous email step's thread, from the same mailbox.
  replyInThread Boolean          @default(false) @map("reply_in_thread")
  waitDays      Int?             @map("wait_days")
  businessDays  Boolean          @default(true) @map("business_days")
  /// `task` steps (#136): the title of the task created on the person.
  taskTitle     String?          @map("task_title")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence     Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template     EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sends        MailOutbound[]
  trackingHits TrackingHit[]
  tasks        Task[]

  @@unique([sequenceId, position])
  @@map("sequence_steps")
}

/// A person in a sequence: the truth the runner reads (FR-CRMS-5). One per (sequence, person).
model SequenceEnrolment {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String               @map("workspace_id") @db.Uuid
  sequenceId            String               @map("sequence_id") @db.Uuid
  personId              String               @map("person_id") @db.Uuid
  dealId                String?              @map("deal_id") @db.Uuid
  status                EnrolmentStatus      @default(active)
  stepIndex             Int                  @default(0) @map("step_index")
  /// When the next step runs; null while a step's send is out (`waitingOutboundId`) or once ended.
  nextRunAt             DateTime?            @map("next_run_at") @db.Timestamptz
  waitingOutboundId     String?              @unique @map("waiting_outbound_id") @db.Uuid
  heldReason            String?              @map("held_reason")
  stopReason            EnrolmentStopReason? @map("stop_reason")
  stopDetail            String?              @map("stop_detail")
  enrolledBy            Json                 @map("enrolled_by")
  /// No country was known at enrolment (D-251): enrolled and flagged; stopped if one later falls in a
  /// blocked region.
  countryUnknownAtEnrol Boolean              @default(false) @map("country_unknown_at_enrol")
  /// The member who enrolled the person (#144): the sender of every step's send — the pool mailbox
  /// only carries it. An API key's enrolment is its creator's.
  enrolledByMemberId    String               @map("enrolled_by_member_id") @db.Uuid
  enrolledAt            DateTime             @default(now()) @map("enrolled_at") @db.Timestamptz
  finishedAt            DateTime?            @map("finished_at") @db.Timestamptz
  stoppedAt             DateTime?            @map("stopped_at") @db.Timestamptz
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sequence         Sequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  person           Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  deal             Opportunity?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  enrolledByMember WorkspaceMember @relation("EnrolmentEnroller", fields: [enrolledByMemberId], references: [id])
  waitingSend      MailOutbound?   @relation("EnrolmentWaitingSend", fields: [waitingOutboundId], references: [id], onDelete: SetNull)
  sends            MailOutbound[]  @relation("EnrolmentSends")
  trackingHits     TrackingHit[]
  tasks            Task[]

  @@unique([sequenceId, personId])
  @@index([status, nextRunAt])
  @@index([workspaceId, personId])
  @@map("sequence_enrolments")
}

// ─────────────────────────────────────────────────────────────────────────────
// The Twenty importer (P4-4, doc 48 §11): the connection to a Twenty workspace, the runs that read
// it, and the links that make a run repeatable — one row per Twenty record, saying what it became.
// docs/design-notes/P4-4.md.
// ─────────────────────────────────────────────────────────────────────────────

/// The Twenty workspace an import reads: its REST base URL and an API key, sealed with `SecretBox`.
/// One per workspace; absent until an admin connects one.
model TwentyImportSettings {
  workspaceId         String    @id @map("workspace_id") @db.Uuid
  baseUrl             String    @map("base_url")
  apiKeyCiphertext    String    @map("api_key_ciphertext")
  apiKeyLast4         String    @map("api_key_last4")
  configuredById      String?   @map("configured_by_id") @db.Uuid
  /// #185: how often the importer runs its `changes` mode on its own — `off`, `15m`, `hourly` or `daily` (checked by the database).
  syncInterval        String    @default("off") @map("sync_interval")
  /// Scheduled runs failed in a row; the schedule backs off by it and tells the admins at the third.
  syncFailures        Int       @default(0) @map("sync_failures")
  syncLastError       String?   @map("sync_last_error")
  /// When an admin stopped syncing for good (the cutover); cleared when syncing is turned back on.
  cutoverAt           DateTime? @map("cutover_at") @db.Timestamptz
  /// The accounts option as last chosen at a start (#184): the role Twenty members who are not here get; null for off. A scheduled run (#185) uses it.
  createMembersRoleId String?   @map("create_members_role_id") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuredBy      WorkspaceMember? @relation(fields: [configuredById], references: [id], onDelete: SetNull)
  createMembersRole Role?            @relation("TwentyImportSettingsRole", fields: [createMembersRoleId], references: [id], onDelete: SetNull)

  @@map("twenty_import_settings")
}

enum TwentyImportRunStatus {
  queued
  running
  succeeded
  failed
  cancelled

  @@map("twenty_import_run_status")
}

enum TwentyImportMode {
  full
  changes
  /// #156: flags mapped records Twenty no longer returns; writes no record.
  reconcile

  @@map("twenty_import_mode")
}

/// One run of the importer. The row is the truth the worker resumes from: `phase` and `cursor`
/// say where it is, `report` what it did per object (`TwentyImportObjectReport[]` from
/// @bylinecrm/shared). At most one queued or running run per workspace (partial unique index).
model TwentyImportRun {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String                @map("workspace_id") @db.Uuid
  status              TwentyImportRunStatus @default(queued)
  mode                TwentyImportMode
  /// `changes` mode: records Twenty updated at or after this instant are read.
  since               DateTime?             @db.Timestamptz
  /// The object being read, while running; null before and after.
  phase               String?
  /// Per object, the cursor to continue from: `{ [object]: string | null }`; an object not present has not started, one mapped to `null` is done.
  cursor              Json                  @default("{}")
  report              Json                  @default("[]")
  error               String?
  cancelRequested     Boolean               @default(false) @map("cancel_requested")
  /// #185: started by the schedule, not a person.
  scheduled           Boolean               @default(false)
  startedById         String?               @map("started_by_id") @db.Uuid
  /// #184: the role the run gives accounts it creates for Twenty members who are not here; null for a run without the option.
  createMembersRoleId String?               @map("create_members_role_id") @db.Uuid
  /// #184: accounts (user and seat) this run created.
  accountsCreated     Int                   @default(0) @map("accounts_created")
  queuedAt            DateTime              @default(now()) @map("queued_at") @db.Timestamptz
  startedAt           DateTime?             @map("started_at") @db.Timestamptz
  finishedAt          DateTime?             @map("finished_at") @db.Timestamptz
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedBy         WorkspaceMember? @relation(fields: [startedById], references: [id], onDelete: SetNull)
  createMembersRole Role?            @relation(fields: [createMembersRoleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, queuedAt(sort: Desc)])
  @@map("twenty_import_runs")
}

/// What one Twenty record became here: `object` is the Twenty object (`people`, `leadLookups`, …),
/// `localType` what it maps to (`person`, `exclusion`, `member`, …) and `localId` that row. Two
/// Twenty records may map to one row (a journalist and a person with one address). `label` names
/// a local thing that has no row of its own (a message list's name on the Lists field).
model TwentyImportLink {
  workspaceId       String    @map("workspace_id") @db.Uuid
  object            String
  externalId        String    @map("external_id")
  localType         String    @map("local_type")
  localId           String    @map("local_id") @db.Uuid
  label             String?
  /// Twenty's `updatedAt` when the record was last read.
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz
  importedAt        DateTime  @default(now()) @map("imported_at") @db.Timestamptz
  /// When a reconcile pass (#156) last saw the record in Twenty; null until one has.
  checkedAt         DateTime? @map("checked_at") @db.Timestamptz
  /// Set by a reconcile pass that no longer found the record in Twenty; cleared the moment any run sees it again.
  missingSince      DateTime? @map("missing_since") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, object, externalId])
  @@index([workspaceId, localType, localId])
  @@index([workspaceId, missingSince])
  @@map("twenty_import_links")
}

/// BIGIN-1 (FR-CRMS-25): a workspace's Zoho Bigin connection. The client secret and refresh token are
/// sealed with `SecretBox` and never returned; the URLs are the data centre's OAuth server and API.
model BiginImportSettings {
  workspaceId            String    @id @map("workspace_id") @db.Uuid
  accountsUrl            String    @map("accounts_url")
  apiUrl                 String    @map("api_url")
  clientId               String    @map("client_id")
  clientSecretCiphertext String    @map("client_secret_ciphertext")
  refreshTokenCiphertext String    @map("refresh_token_ciphertext")
  refreshTokenLast4      String    @map("refresh_token_last4")
  configuredById         String?   @map("configured_by_id") @db.Uuid
  /// How often a `changes` run starts on its own: `off`, `15m`, `hourly` or `daily` (checked by the database).
  syncInterval           String    @default("off") @map("sync_interval")
  syncFailures           Int       @default(0) @map("sync_failures")
  syncLastError          String?   @map("sync_last_error")
  cutoverAt              DateTime? @map("cutover_at") @db.Timestamptz
  createMembersRoleId    String?   @map("create_members_role_id") @db.Uuid
  /// Per module, the instant a `changes` run reads from (`{ [module]: iso }`, `<module>:deleted` for deletions):
  /// advanced past what succeeded, never past the oldest record that failed.
  cursors                Json      @default("{}")
  /// The last "apply the stage mapping to imported deals": `{ status, requestedAt, finishedAt, moved, skipped, error }`.
  stageApply             Json?     @map("stage_apply")
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuredBy      WorkspaceMember? @relation(fields: [configuredById], references: [id], onDelete: SetNull)
  createMembersRole Role?            @relation("BiginImportSettingsRole", fields: [createMembersRoleId], references: [id], onDelete: SetNull)

  @@map("bigin_import_settings")
}

enum BiginImportRunStatus {
  queued
  running
  succeeded
  failed
  cancelled

  @@map("bigin_import_run_status")
}

enum BiginImportMode {
  full
  changes

  @@map("bigin_import_mode")
}

/// One run of the Bigin importer; the row is the truth the worker resumes from (`phase`, `cursor`), `report`
/// what it did per module (`BiginImportObjectReport[]`). At most one queued or running run per workspace.
model BiginImportRun {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String               @map("workspace_id") @db.Uuid
  status              BiginImportRunStatus @default(queued)
  mode                BiginImportMode
  phase               String?
  /// Per module, where the pass is: `{ since, page, highWater, oldestFailure, done }`.
  cursor              Json                 @default("{}")
  report              Json                 @default("[]")
  error               String?
  cancelRequested     Boolean              @default(false) @map("cancel_requested")
  scheduled           Boolean              @default(false)
  startedById         String?              @map("started_by_id") @db.Uuid
  createMembersRoleId String?              @map("create_members_role_id") @db.Uuid
  accountsCreated     Int                  @default(0) @map("accounts_created")
  queuedAt            DateTime             @default(now()) @map("queued_at") @db.Timestamptz
  startedAt           DateTime?            @map("started_at") @db.Timestamptz
  finishedAt          DateTime?            @map("finished_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startedBy         WorkspaceMember? @relation(fields: [startedById], references: [id], onDelete: SetNull)
  createMembersRole Role?            @relation(fields: [createMembersRoleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, queuedAt(sort: Desc)])
  @@map("bigin_import_runs")
}

/// What one Bigin record became here: `object` is the Bigin module, `externalId` its bare record id, and
/// `localType`/`localId` the row. `missingSince` is set when Bigin reports the record deleted.
model BiginImportLink {
  workspaceId       String    @map("workspace_id") @db.Uuid
  object            String
  externalId        String    @map("external_id")
  localType         String    @map("local_type")
  localId           String    @map("local_id") @db.Uuid
  /// Bigin's `Modified_Time` when the record was last read.
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz
  importedAt        DateTime  @default(now()) @map("imported_at") @db.Timestamptz
  missingSince      DateTime? @map("missing_since") @db.Timestamptz
  /// Contacts: the name and primary email Bigin had when last read (`{ name, email }`), what a reuse is detected against.
  /// Deals: the raw Bigin stage when last read (`{ stage }`), what the stage mapping is applied from.
  snapshot          Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, object, externalId])
  @@index([workspaceId, localType, localId])
  @@index([workspaceId, missingSince])
  @@map("bigin_import_links")
}

/// Which stage of the default pipeline a Bigin deal stage lands in, keyed by Bigin's stage name as Bigin spells it.
/// Applied before the name match and the won/lost heuristic; a deleted stage takes its mappings with it.
model BiginStageMapping {
  workspaceId String   @map("workspace_id") @db.Uuid
  biginStage  String   @map("bigin_stage")
  stageId     String   @map("stage_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@id([workspaceId, biginStage])
  @@index([stageId])
  @@map("bigin_stage_mappings")
}

/// A Bigin Contact edited to hold a different person (BIGIN-1): the earlier person was left as it was and the
/// Bigin id now maps to `newPersonId`. `before`/`after` are Bigin's `{ name, email }` either side of the change.
model BiginContactReuse {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  biginId          String   @map("bigin_id")
  previousPersonId String   @map("previous_person_id") @db.Uuid
  newPersonId      String   @map("new_person_id") @db.Uuid
  runId            String?  @map("run_id") @db.Uuid
  detectedAt       DateTime @default(now()) @map("detected_at") @db.Timestamptz
  before           Json
  after            Json
  /// `sync` (found as it happened) or `reconcile` (FR-CRMS-26: split after the fact from history).
  source           String   @default("sync")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, detectedAt(sort: Desc)])
  @@index([workspaceId, biginId])
  @@map("bigin_contact_reuses")
}

/// What verification found about an address (P3-5, FR-CRMS-14); `@bylinecrm/shared` says what each means.
enum EmailVerificationResult {
  valid
  invalid
  risky
  unknown

  @@map("email_verification_result")
}

/// The workspace's stored answer about an address (lower case): one per (workspace, address), found
/// again once older than the workspace's age (FR-CRMS-16) or whenever it is `unknown`.
model EmailVerification {
  workspaceId String                  @map("workspace_id") @db.Uuid
  address     String
  result      EmailVerificationResult
  /// `EmailVerificationReason` from @bylinecrm/shared.
  reason      String
  message     String
  /// The verifier that answered (`free`, or a vendor adapter's name).
  source      String
  verifiedAt  DateTime                @map("verified_at") @db.Timestamptz
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, address])
  @@map("email_verifications")
}

/// How long a result stands (FR-CRMS-16): a row is an override; no row means 90 days.
model EmailVerificationSettings {
  workspaceId       String   @id @map("workspace_id") @db.Uuid
  maxAgeDays        Int      @default(90) @map("max_age_days")
  updatedByMemberId String?  @map("updated_by_member_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy WorkspaceMember? @relation(fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@map("email_verification_settings")
}

/// How an ask went for one fact (P4-2, FR-CRMS-15): answered; looked and found nothing; could not look.
enum EnrichmentAnswerStatus {
  answered
  no_answer
  failed

  @@map("enrichment_answer_status")
}

/// One answer a source gave about one fact of a record: kept with its source and the time it was
/// asked, whether it was written to the record, and — never a zero or an empty string — `value`
/// only when answered. The record's panel reads them newest first; the re-ask age is dated from them.
model EnrichmentAnswer {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                 @map("workspace_id") @db.Uuid
  object      RecordObject
  recordId    String                 @map("record_id") @db.Uuid
  /// `EnrichmentFactKey` from @bylinecrm/shared.
  field       String
  /// `EnrichmentSource` from @bylinecrm/shared.
  source      String
  status      EnrichmentAnswerStatus
  value       String?
  rank        Int                    @default(0)
  note        String?
  applied     Boolean                @default(false)
  askedAt     DateTime               @map("asked_at") @db.Timestamptz
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, object, recordId, askedAt(sort: Desc)])
  @@index([workspaceId, askedAt])
  @@map("enrichment_answers")
}

/// Which sources a workspace asks and how long an answer stands (P4-2): a row is an override; no row
/// means every free source on and 90 days.
model EnrichmentSettings {
  workspaceId       String   @id @map("workspace_id") @db.Uuid
  reaskAfterDays    Int      @default(90) @map("reask_after_days")
  /// `EnrichmentSource` keys the workspace turned off.
  disabledSources   String[] @default([]) @map("disabled_sources")
  updatedByMemberId String?  @map("updated_by_member_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy WorkspaceMember? @relation(fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@map("enrichment_settings")
}

/// A workspace's short-link domain (P3-4, FR-CRMS-8): the host its tracked links and open pixels
/// live on, a CNAME to the API. One per workspace, and one workspace per domain. Links are rewritten
/// only while `status` is `pass`; the status is the same vocabulary as a sending domain's.
model TrackingDomain {
  workspaceId String              @id @map("workspace_id") @db.Uuid
  /// Lower case; a host names one workspace's links.
  domain      String              @unique
  status      SendingDomainStatus @default(unchecked)
  /// The last check: `{ outcome, message }`.
  lastCheck   Json?               @map("last_check")
  checkedAt   DateTime?           @map("checked_at") @db.Timestamptz
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("tracking_domains")
}

/// What a tracking token stands for: a link in the mail, or the mail's open pixel.
enum TrackingKind {
  click
  open

  @@map("tracking_kind")
}

/// One opaque token in one sent message (P3-4): a `click` token per distinct link, one `open` token
/// per send. Stored hashed, like an unsubscribe token; the public routes resolve it to its workspace
/// first and read everything else inside that workspace.
model TrackingToken {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  outboundId  String       @map("outbound_id") @db.Uuid
  kind        TrackingKind
  tokenHash   String       @unique @map("token_hash")
  /// The link's original URL; null for the open pixel.
  url         String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outbound  MailOutbound  @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  hits      TrackingHit[]

  @@index([outboundId])
  @@map("tracking_tokens")
}

/// One request to a tracking token (P3-4). A hit with a `botReason` is a scanner's: kept, so the rule
/// can be audited, and counted nowhere; every other hit is a click or an (indicative) open, announced
/// as `email.clicked` / `email.opened`. Never deleted by the app role.
model TrackingHit {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String       @map("workspace_id") @db.Uuid
  /// Null for a hit SMTP2Go reported (TRANS-1): its own tracking, not one of our tokens.
  tokenId         String?      @map("token_id") @db.Uuid
  outboundId      String       @map("outbound_id") @db.Uuid
  kind            TrackingKind
  /// TRANS-1: SMTP2Go's report of the hit, as a key that makes a redelivered webhook change nothing.
  providerEventId String?      @unique @map("provider_event_id")
  /// TRANS-1: the link SMTP2Go says was followed; our own hits read it from their token.
  url             String?
  personId        String?      @map("person_id") @db.Uuid
  sequenceStepId  String?      @map("sequence_step_id") @db.Uuid
  enrolmentId     String?      @map("enrolment_id") @db.Uuid
  happenedAt      DateTime     @map("happened_at") @db.Timestamptz
  userAgent       String?      @map("user_agent")
  /// `TrackingBotReason` from @bylinecrm/shared; null for a person's hit.
  botReason       String?      @map("bot_reason")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token     TrackingToken?     @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  outbound  MailOutbound       @relation(fields: [outboundId], references: [id], onDelete: Cascade)
  person    Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  step      SequenceStep?      @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)
  enrolment SequenceEnrolment? @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)

  @@index([outboundId, kind])
  @@index([sequenceStepId, kind])
  @@index([tokenId])
  @@map("tracking_hits")
}

// ─────────────────────────────────────────────────────────────────────────────
// Calendar sync (CAL-1): meetings with people outside the workspace, from each member's Google
// Calendar, read through their personal mailbox's connection. They count towards the member's KPIs,
// and every outside attendee is a person — a lead the member owns.
// ─────────────────────────────────────────────────────────────────────────────

/// A meeting as Google reports it.
enum CalendarEventStatus {
  confirmed
  tentative
  cancelled

  @@map("calendar_event_status")
}

/// Where a meeting reached the CRM from (CAL-2): a member's Google Calendar, or a booking on Slotline.
enum MeetingSource {
  google_calendar
  slotline

  @@map("meeting_source")
}

/// An attendee's answer to the invitation.
enum CalendarResponseStatus {
  needs_action
  accepted
  tentative
  declined

  @@map("calendar_response_status")
}

/// A meeting, once per workspace however many members' calendars hold it, keyed by `identityKey`:
/// Google's iCalendar UID, and for one occurrence of a recurring meeting that occurrence's original
/// start as well. Only meetings with someone outside the workspace are kept. Never its description.
model CalendarEvent {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String              @map("workspace_id") @db.Uuid
  identityKey      String              @map("identity_key")
  /// Shared by every occurrence of a recurring meeting: a series is booked once.
  icalUid          String              @map("ical_uid")
  title            String              @default("")
  location         String?
  conferenceUrl    String?             @map("conference_url")
  startsAt         DateTime            @map("starts_at") @db.Timestamptz
  endsAt           DateTime            @map("ends_at") @db.Timestamptz
  allDay           Boolean             @default(false) @map("all_day")
  status           CalendarEventStatus
  /// Lower case (the database checks).
  organizerAddress String?             @map("organizer_address")
  /// Who the meeting counts for as booked: its organiser when they are a member whose calendar holds
  /// it, else the member whose calendar it was found in first.
  hostMemberId     String              @map("host_member_id") @db.Uuid
  /// When the meeting was put in the calendar: Google's creation time.
  bookedAt         DateTime            @map("booked_at") @db.Timestamptz
  /// Booked through Slotline (CAL-2) once any Slotline booking is this meeting; else found in a calendar.
  bookedVia        MeetingSource       @default(google_calendar) @map("booked_via")
  /// The Slotline booking's current uid, for a link to it; null for a meeting Slotline never saw.
  slotlineUid      String?             @map("slotline_uid")
  cancelledAt      DateTime?           @map("cancelled_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  host         WorkspaceMember            @relation(fields: [hostMemberId], references: [id])
  copies       CalendarEventCopy[]
  participants CalendarEventParticipant[]

  @@unique([workspaceId, identityKey])
  @@index([workspaceId, startsAt])
  @@index([workspaceId, hostMemberId, bookedAt])
  @@map("calendar_events")
}

/// One member's copy of a meeting: from their Google Calendar (Google's id for it there, unique per mailbox —
/// sync's dedupe key), or from Slotline (CAL-2: no mailbox; the booking's iCalendar UID, unique per workspace
/// among Slotline copies), with that member's own answer.
model CalendarEventCopy {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String                 @map("workspace_id") @db.Uuid
  eventId         String                 @map("event_id") @db.Uuid
  source          MeetingSource          @default(google_calendar)
  /// The member's Google mailbox the copy was read through; null for a Slotline copy (the database checks).
  mailboxId       String?                @map("mailbox_id") @db.Uuid
  /// The mailbox's owner when the copy was stored: the member the meeting counts for as held.
  memberId        String                 @map("member_id") @db.Uuid
  providerEventId String                 @map("provider_event_id")
  responseStatus  CalendarResponseStatus @map("response_status")
  isOrganizer     Boolean                @default(false) @map("is_organizer")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     CalendarEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mailbox   Mailbox?        @relation(fields: [mailboxId], references: [id], onDelete: Restrict)
  member    WorkspaceMember @relation(fields: [memberId], references: [id])

  @@unique([mailboxId, providerEventId])
  @@index([eventId])
  @@index([workspaceId, memberId])
  @@map("calendar_event_copies")
}

/// One attendee of one meeting, matched to a person and/or a member when it can be.
model CalendarEventParticipant {
  id                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String                 @map("workspace_id") @db.Uuid
  eventId                  String                 @map("event_id") @db.Uuid
  /// Lower case (the database checks).
  address                  String
  displayName              String                 @default("") @map("display_name")
  responseStatus           CalendarResponseStatus @map("response_status")
  isOrganizer              Boolean                @default(false) @map("is_organizer")
  personId                 String?                @map("person_id") @db.Uuid
  memberId                 String?                @map("member_id") @db.Uuid
  /// Set when calendar sync created the person for this attendee: the member the new lead went to.
  leadCreatedForMemberId   String?                @map("lead_created_for_member_id") @db.Uuid
  /// CAL-3: an attendee who may or may not be a lead (the member was invited by someone outside, or they are at a
  /// free-mail domain) is suggested to this member instead of being made a person; they add or dismiss it.
  leadSuggestedForMemberId String?                @map("lead_suggested_for_member_id") @db.Uuid
  /// When the member said "not a lead": that address is not suggested to them again.
  leadDismissedAt          DateTime?              @map("lead_dismissed_at") @db.Timestamptz
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event            CalendarEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person           Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  member           WorkspaceMember? @relation("CalendarParticipantMember", fields: [memberId], references: [id], onDelete: SetNull)
  leadCreatedFor   WorkspaceMember? @relation("CalendarParticipantLeadFor", fields: [leadCreatedForMemberId], references: [id], onDelete: SetNull)
  leadSuggestedFor WorkspaceMember? @relation("CalendarParticipantLeadSuggestedFor", fields: [leadSuggestedForMemberId], references: [id], onDelete: SetNull)

  @@unique([eventId, address])
  @@index([workspaceId, address])
  @@index([workspaceId, personId])
  @@index([workspaceId, leadCreatedForMemberId, createdAt])
  @@index([workspaceId, leadSuggestedForMemberId, address])
  @@map("calendar_event_participants")
}

/// Where a mailbox's calendar sync stands: the last run, the last full read of the window, why it stopped.
model CalendarSyncState {
  mailboxId    String         @id @map("mailbox_id") @db.Uuid
  workspaceId  String         @map("workspace_id") @db.Uuid
  status       MailSyncStatus @default(idle)
  lastSyncedAt DateTime?      @map("last_synced_at") @db.Timestamptz
  /// The last run that read the whole window rather than only what changed since the run before.
  windowReadAt DateTime?      @map("window_read_at") @db.Timestamptz
  /// `{ code, message, at }` while the last run failed or was skipped; null after a clean run.
  lastError    Json?          @map("last_error")
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   Mailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("calendar_sync_states")
}

/// The workspace's Slotline booking site (CAL-2): bookings on it reach the CRM as a signed webhook. The hook
/// URL names the workspace by an unguessable token — looked up by its SHA-256, and held encrypted so an admin
/// can read the URL again; the secret the deliveries are signed with is the one entered in Slotline, encrypted.
model SlotlineSettings {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String    @unique @map("workspace_id") @db.Uuid
  /// Where the booking site is, for links to a booking: `https://bookings.example.com`.
  baseUrl                String    @map("base_url")
  hookTokenHash          String    @unique @map("hook_token_hash")
  hookTokenCiphertext    String    @map("hook_token_ciphertext")
  secretCiphertext       String    @map("secret_ciphertext")
  configuredById         String    @map("configured_by_id") @db.Uuid
  lastDeliveryAt         DateTime? @map("last_delivery_at") @db.Timestamptz
  /// How the last delivery went: `stored`, `cancelled`, `ignored`, `unmatched`, `ping`, `bad_signature`.
  lastDeliveryResult     String?   @map("last_delivery_result")
  /// Bookings whose organiser is no member (by sign-in address or personal mailbox), and the last such address.
  unmatchedOrganizers    Int       @default(0) @map("unmatched_organizers")
  lastUnmatchedOrganizer String?   @map("last_unmatched_organizer")
  /// The catch-up (Slotline doesn't retry a failed delivery): the key of Slotline's admin route
  /// `GET /api/admin/bookings/changes` (its `SLOTLINE_ADMIN_API_KEY`), sealed; none, no catch-up.
  catchUpKeyCiphertext   String?   @map("catch_up_key_ciphertext")
  /// Slotline's own `until` of the last complete pass: the next one reads changes after it.
  catchUpThrough         DateTime? @map("catch_up_through") @db.Timestamptz
  lastCatchUpAt          DateTime? @map("last_catch_up_at") @db.Timestamptz
  /// `ok` (with how many bookings were read), or why the pass failed.
  lastCatchUpResult      String?   @map("last_catch_up_result")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuredBy WorkspaceMember @relation(fields: [configuredById], references: [id])

  @@map("slotline_settings")
}

/// #192: what a member is told about their tasks.
enum NotificationKind {
  /// Someone else assigned the task to them (a sequence's task step included).
  task_assigned
  /// The task came due, and was not due already when it was made.
  task_due
  /// OWN-1: someone proposed handing a record to them; their proposal was decided; a manager moved a record to / from them.
  transfer_proposed
  transfer_accepted
  transfer_declined
  transfer_received
  transfer_taken
  /// GUARD-1: a member was blocked three times in a day from mailing others' leads (to reviewers).
  guardrail_repeat_blocks
  /// REP-1: a sender-reputation finding (to the mailbox's owner; at `high` to reviewers too).
  guardrail_alert
  /// INV-1: an invoice on a deal waits for finance (to holders of `invoice:verify`).
  invoice_needs_review
  /// INV-1: a refund left a deal's verified invoices short of its amount (to holders of `invoice:verify`).
  invoice_coverage_lost
  /// GUARD-2: a member mailed another member's lead or a customer (to the owner, managers and admins).
  guardrail_poach_suspected
  /// CADENCE-1: a lead of theirs missed its cadence; it rotates after the grace (to the owner).
  cadence_warning
  /// CADENCE-1: a lead was rotated to the next rep (to managers; the two owners hear `transfer_*`).
  cadence_rotated

  @@map("notification_kind")
}

/// #192: one thing a member is told, about one task or (OWN-1) one transfer, once: (member, kind, task) and
/// (member, kind, transfer) are unique, so an event delivered again or a sweep run twice tells nobody twice.
/// Exactly one of `taskId` / `transferId` is set (the database checks). Each member reads only their own.
model Notification {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  memberId         String           @map("member_id") @db.Uuid
  kind             NotificationKind
  taskId           String?          @map("task_id") @db.Uuid
  transferId       String?          @map("transfer_id") @db.Uuid
  /// GUARD-1: the guardrail event, for a `guardrail_*` kind. Exactly one of task, transfer, guardrail event.
  guardrailEventId String?          @map("guardrail_event_id") @db.Uuid
  /// INV-1: the invoice, for an `invoice_*` kind.
  invoiceId        String?          @map("invoice_id") @db.Uuid
  /// CADENCE-1: the lapse, for `cadence_warning`.
  cadenceLapseId   String?          @map("cadence_lapse_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  readAt           DateTime?        @map("read_at") @db.Timestamptz

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member         WorkspaceMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  task           Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  transfer       OwnershipTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  guardrailEvent GuardrailEvent?    @relation(fields: [guardrailEventId], references: [id], onDelete: Cascade)
  invoice        DealInvoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cadenceLapse   CadenceLapse?      @relation(fields: [cadenceLapseId], references: [id], onDelete: Cascade)

  @@unique([memberId, kind, taskId])
  @@unique([memberId, kind, transferId])
  @@unique([memberId, kind, guardrailEventId])
  @@unique([memberId, kind, invoiceId])
  @@unique([memberId, kind, cadenceLapseId])
  @@index([memberId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Ownership transfers (OWN-1, FR-CRMS-17): the one way a record changes hands.
// ─────────────────────────────────────────────────────────────────────────────

enum TransferStatus {
  proposed
  accepted
  declined
  cancelled
  /// A holder of `record:transfer` moved the record without asking; completed at once.
  forced

  @@map("transfer_status")
}

/// One record offered, or moved, from one member to another. `moved` is every record that changed owner
/// with it (`RecordTarget[]`), written when it completes; the history a record's drawer shows.
model OwnershipTransfer {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String         @map("workspace_id") @db.Uuid
  object             RecordObject
  recordId           String         @map("record_id") @db.Uuid
  /// The owner before; null when the record had none.
  fromMemberId       String?        @map("from_member_id") @db.Uuid
  toMemberId         String         @map("to_member_id") @db.Uuid
  proposedByMemberId String         @map("proposed_by_member_id") @db.Uuid
  decidedByMemberId  String?        @map("decided_by_member_id") @db.Uuid
  status             TransferStatus @default(proposed)
  reason             String?
  /// What a declining receiver said.
  note               String?
  moved              Json           @default("[]")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  decidedAt          DateTime?      @map("decided_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  from       WorkspaceMember? @relation("TransferFrom", fields: [fromMemberId], references: [id], onDelete: SetNull)
  to         WorkspaceMember  @relation("TransferTo", fields: [toMemberId], references: [id])
  proposedBy WorkspaceMember  @relation("TransferProposedBy", fields: [proposedByMemberId], references: [id])
  decidedBy  WorkspaceMember? @relation("TransferDecidedBy", fields: [decidedByMemberId], references: [id], onDelete: SetNull)

  notifications Notification[]
  cadenceLapses CadenceLapse[]

  // One open proposal per record — the partial unique index `ownership_transfers_open_record_key` in the migration.
  @@index([workspaceId, object, recordId, createdAt(sort: Desc)])
  @@index([moved(ops: JsonbPathOps)], type: Gin, map: "ownership_transfers_moved_idx")
  @@index([workspaceId, toMemberId, status])
  @@index([workspaceId, fromMemberId, status])
  @@map("ownership_transfers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Guardrails (GUARD-1, FR-CRMS-21): what the recipient guard refused, warned of, or let a manager through.
// ─────────────────────────────────────────────────────────────────────────────

enum GuardrailKind {
  suppressed
  excluded_customer
  excluded_account_managed
  owned_by_other
  in_negotiation
  cold_to_known
  /// Three blocks on owned addresses by one member in a UTC day.
  repeat_blocks
  /// GUARD-1b: a CSV export (the export audit).
  record_export
  /// REP-1: a send refused (or a pool send deferred) by a mailbox's daily / hourly budget.
  send_budget
  /// REP-1: sync saw a mailbox over its daily new-recipient budget.
  volume_anomaly
  /// REP-1: near-identical 1:1 bodies (simhash) to many distinct recipients in 24h.
  bulk_pattern
  /// REP-1: one normalised subject to many distinct new recipients in 24h.
  subject_repeat
  /// REP-1: a reply saying "unsubscribe" / "remove me".
  negative_reply
  /// REP-1: a sequence send or enrolment from a pool mailbox on the primary domain.
  primary_domain
  /// REP-2: a pool send's recipient failed (or barely passed) the verification gate.
  recipient_quality
  /// REP-2: a mailbox paused for new recipients by the reply-rate floor.
  reply_rate
  /// REP-2: a sending domain's Postmaster spam rate reached the warn line or the kill switch.
  spam_rate
  /// TRANS-1: a pool mailbox paused because SMTP2Go rejected its last sends for a reason on our side.
  rejected_sends
  /// GUARD-2: mail that left (Gmail sync or a CRM send) to another member's lead, or to a customer on the exclusions.
  poach_suspected
  pooled_customer

  @@map("guardrail_kind")
}

enum GuardrailOutcome {
  blocked
  warned
  /// An exempt sender (a holder of `record:transfer`) was let through; kept for the audit.
  allowed
  /// REP-1: a pool send held back by a budget; the sequence tries again.
  deferred

  @@map("guardrail_outcome")
}

enum GuardrailSeverity {
  low
  medium
  high

  @@map("guardrail_severity")
}

enum GuardrailPath {
  send
  reply
  scheduled_send
  sequence_enrol
  sequence_step
  repeat_blocks
  export
  /// REP-1: measured from Gmail sync.
  sync
  /// REP-1: the pool's gate as a send is claimed.
  pool_send

  @@map("guardrail_path")
}

/// One thing the recipient guard did (GUARD-1): the audit a manager reads and marks legitimate. History: the
/// app role never deletes a row. GUARD-2 and REP-1/2 add their kinds and paths here.
model GuardrailEvent {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String            @map("workspace_id") @db.Uuid
  kind                 GuardrailKind
  outcome              GuardrailOutcome
  severity             GuardrailSeverity
  path                 GuardrailPath
  /// Who tried.
  actorMemberId        String?           @map("actor_member_id") @db.Uuid
  /// Whose lead it was (`owned_by_other`, `in_negotiation`).
  ownerMemberId        String?           @map("owner_member_id") @db.Uuid
  personId             String?           @map("person_id") @db.Uuid
  companyId            String?           @map("company_id") @db.Uuid
  /// Lower case.
  address              String?
  /// What the guard told the sender.
  message              String
  /// Machine facts: the exclusion's source, the deal in negotiation, the day's count.
  detail               Json              @default("{}")
  notifiedMemberIds    String[]          @default([]) @map("notified_member_ids") @db.Uuid
  /// One event per key per workspace (`repeat_blocks:<member>:<day>`); null for most.
  dedupeKey            String?           @map("dedupe_key")
  legitimateAt         DateTime?         @map("legitimate_at") @db.Timestamptz
  legitimateByMemberId String?           @map("legitimate_by_member_id") @db.Uuid
  legitimateReason     String?           @map("legitimate_reason")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor         WorkspaceMember? @relation("GuardrailActor", fields: [actorMemberId], references: [id], onDelete: SetNull)
  owner         WorkspaceMember? @relation("GuardrailOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  legitimateBy  WorkspaceMember? @relation("GuardrailReviewer", fields: [legitimateByMemberId], references: [id], onDelete: SetNull)
  person        Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  company       Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, actorMemberId, createdAt])
  @@index([workspaceId, kind, actorMemberId, createdAt])
  @@map("guardrail_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Invoices on a deal (INV-1, FR-CRMS-19): verified by NewswireOS before they count.
// ─────────────────────────────────────────────────────────────────────────────

enum InvoiceGateway {
  stripe
  paypal
  crypto_onchain
  bank_wire
  /// A NewswireOS invoice number (`INV-202610-000067`), resolved by NewswireOS to its payment.
  newswireos_invoice

  @@map("invoice_gateway")
}

enum InvoiceStatus {
  verifying
  verified
  invalid
  needs_review
  invalidated

  @@map("invoice_status")
}

/// A gateway reference on a deal. One payment is one deal: `(workspace, gateway, reference)` is unique.
model DealInvoice {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String          @map("workspace_id") @db.Uuid
  opportunityId       String          @map("opportunity_id") @db.Uuid
  gateway             InvoiceGateway
  /// As entered, trimmed.
  reference           String
  /// The reference as NewswireOS names it (an invoice's payment intent, a normalised hash); refunds match on either.
  canonicalReference  String?         @map("canonical_reference")
  /// For a NewswireOS invoice number: the rail NewswireOS resolved it to (`canonicalReference` is the id there).
  resolvedGateway     InvoiceGateway? @map("resolved_gateway")
  /// What the payment must be: the deal's amount by default, less for a partial payment.
  amountMinor         BigInt          @map("amount_minor")
  /// How much of it has been refunded (NewswireOS's running total). Only the net counts toward the deal.
  refundedAmountMinor BigInt          @default(0) @map("refunded_amount_minor")
  currency            String          @db.Char(3)
  /// An optional receipt, stored as an ordinary attachment on the deal.
  attachmentId        String?         @map("attachment_id") @db.Uuid
  status              InvoiceStatus   @default(verifying)
  /// NewswireOS's reason code (`AMOUNT_MISMATCH`, `PROVIDER_ERROR`, …), ours (`NO_LINK`), or a person's (`MANUAL`).
  reasonCode          String?         @map("reason_code")
  /// A person's words when they verified or rejected it by hand.
  note                String?
  verifiedAt          DateTime?       @map("verified_at") @db.Timestamptz
  invalidatedAt       DateTime?       @map("invalidated_at") @db.Timestamptz
  /// What NewswireOS answered (the facts of the payment), or what the webhook said took it back.
  verificationPayload Json            @default("{}") @map("verification_payload")
  createdById         String?         @map("created_by_id") @db.Uuid
  decidedById         String?         @map("decided_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity   Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy     WorkspaceMember? @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy     WorkspaceMember? @relation("InvoiceDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@unique([workspaceId, gateway, reference])
  @@index([workspaceId, opportunityId])
  @@map("deal_invoices")
}

/// The workspace's NewswireOS link (INV-1), an admin's to set: where to verify, with which token, and the
/// hook NewswireOS posts refunds and chargebacks to.
model NewswireosSettings {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @unique @map("workspace_id") @db.Uuid
  /// `https://app.newswireos.example`
  baseUrl             String    @map("base_url")
  apiTokenCiphertext  String    @map("api_token_ciphertext")
  hookTokenHash       String    @unique @map("hook_token_hash")
  hookTokenCiphertext String    @map("hook_token_ciphertext")
  /// Null until the admin pastes the secret NewswireOS mints for the hook; deliveries are refused till then.
  secretCiphertext    String?   @map("secret_ciphertext")
  configuredById      String    @map("configured_by_id") @db.Uuid
  lastDeliveryAt      DateTime? @map("last_delivery_at") @db.Timestamptz
  /// `applied`, `unmatched`, `ignored`, `ping`, `bad_signature`.
  lastDeliveryResult  String?   @map("last_delivery_result")
  /// PNW-765: push completed ownership transfers to NewswireOS (`crm:ownership_write`). Off until an admin turns it on.
  pushOwnership       Boolean   @default(false) @map("push_ownership")
  /// PNW-766: push won deals to NewswireOS (`crm:client_write`), which makes their contacts clients. Off until an admin turns it on.
  pushDealWon         Boolean   @default(false) @map("push_deal_won")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuredBy WorkspaceMember @relation(fields: [configuredById], references: [id])

  @@map("newswireos_settings")
}

/// PNW-765: one completed ownership transfer pushed to NewswireOS (`POST /api/v1/crm/ownership-changed`), keyed on
/// the `transfer.completed` event (its outbox id is the push's `event_id`, so NewswireOS dedupes a redelivery).
model NewswireosOwnershipDelivery {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  /// The `transfer.completed` outbox event's id: the push's `event_id`.
  eventId       String    @map("event_id") @db.Uuid
  transferId    String    @map("transfer_id") @db.Uuid
  /// `person` or `company`.
  recordType    String    @map("record_type")
  recordId      String    @map("record_id") @db.Uuid
  /// The body sent, exactly.
  payload       Json
  /// `pending`, `retrying`, `delivered`, `not_ready` (NewswireOS answered 404), `failed` or `skipped` (push turned off).
  status        String    @default("pending")
  attempts      Int       @default(0)
  matched       Boolean?
  /// NewswireOS's per-client outcome: `[{customer_id, reason_code}]` (`REASSIGNED`, `UNCHANGED`, `AGENCY_CLIENT`).
  customers     Json      @default("[]")
  reasonCode    String?   @map("reason_code")
  httpStatus    Int?      @map("http_status")
  lastError     String?   @map("last_error")
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventId])
  @@index([workspaceId, createdAt])
  @@map("newswireos_ownership_deliveries")
}

/// PNW-766: one won deal pushed to NewswireOS (`POST /api/v1/crm/deal-won`), keyed on the `deal.won` event (its
/// outbox id is the push's `event_id`, so NewswireOS answers a redelivery as it answered the first).
model NewswireosDealWonDelivery {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  /// The `deal.won` outbox event's id: the push's `event_id`.
  eventId          String    @map("event_id") @db.Uuid
  opportunityId    String    @map("opportunity_id") @db.Uuid
  /// The deal's contact and company as sent: where NewswireOS's ids are kept once it answers.
  personId         String    @map("person_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  /// The body sent, exactly.
  payload          Json
  /// `pending`, `retrying`, `delivered`, `not_ready` (NewswireOS answered 404), `failed` or `skipped` (push turned off).
  status           String    @default("pending")
  attempts         Int       @default(0)
  /// NewswireOS's answer: the client (null for `NOT_A_CLIENT`), a colleague's parent client, the reason and the AM's.
  customerId       String?   @map("customer_id")
  parentCustomerId String?   @map("parent_customer_id")
  reasonCode       String?   @map("reason_code")
  amReasonCode     String?   @map("am_reason_code")
  httpStatus       Int?      @map("http_status")
  lastError        String?   @map("last_error")
  lastAttemptAt    DateTime? @map("last_attempt_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventId])
  @@index([workspaceId, createdAt])
  @@map("newswireos_deal_won_deliveries")
}

/// PNW-766: one NewswireOS timeline event received on the hook (`client.created`, `order.paid`, `invoice.paid`,
/// `distribution.completed`, `am.assigned`), matched or not. Keyed on the delivery's id: a redelivery writes nothing.
model NewswireosTimelineEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// `x-webhook-id` (the body's `id` when the header is missing).
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  occurredAt  DateTime? @map("occurred_at") @db.Timestamptz
  /// The body as received.
  payload     Json
  /// The record it was put on, and by which of `byline_contact_id`, `byline_company_id`, `email`, `domain`. Null: unmatched.
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id") @db.Uuid
  matchedBy   String?   @map("matched_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventId])
  @@index([workspaceId, createdAt])
  @@map("newswireos_timeline_events")
}

/// The workspace's BylineAI link (BYL-1): the secret BylineAI's WEBHOOK connector signs lead deliveries with
/// (encrypted, never shown back) and the members a lead at an unowned company is dealt to in turn.
model BylineSettings {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @unique @map("workspace_id") @db.Uuid
  /// Null while only the API (BYL-2) is linked: deliveries are then refused as for an unlinked workspace.
  secretCiphertext    String?   @map("secret_ciphertext")
  /// BYL-2: BylineAI's address, `https://byline.example`, and the API key the CRM asks it with (sealed).
  baseUrl             String?   @map("base_url")
  apiKeyCiphertext    String?   @map("api_key_ciphertext")
  /// BYL-2: whether email verification asks BylineAI (its Reacher pool) instead of the free layer alone.
  verifyWithByline    Boolean   @default(false) @map("verify_with_byline")
  /// Dealt to in this order; empty: such a lead waits unowned in the Leads queue.
  roundRobinMemberIds String[]  @default([]) @map("round_robin_member_ids") @db.Uuid
  /// Leads dealt so far; the next goes to the member at this position (modulo the list).
  roundRobinCursor    Int       @default(0) @map("round_robin_cursor")
  configuredById      String    @map("configured_by_id") @db.Uuid
  lastDeliveryAt      DateTime? @map("last_delivery_at") @db.Timestamptz
  /// `ingested`, `duplicate`, `rejected` or `bad_signature`.
  lastDeliveryResult  String?   @map("last_delivery_result")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configuredBy WorkspaceMember @relation(fields: [configuredById], references: [id])

  @@map("byline_settings")
}

/// A BylineAI lead the workspace took in (BYL-1), by BylineAI's `lead_id`: a redelivery is answered `duplicate`.
model BylineLead {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  leadId      String   @map("lead_id")
  personId    String?  @map("person_id") @db.Uuid
  /// `byline:<source_key>`, as the person's source says.
  source      String
  /// The lead's phone as BylineAI sent it, when it was neither E.164 nor dialled digits with a country: kept, not dropped.
  phoneRaw    String?  @map("phone_raw")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  person    Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, leadId])
  @@map("byline_leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cadence and round-robin rotation (CADENCE-1): docs/design-notes/CADENCE-1.md.
// ─────────────────────────────────────────────────────────────────────────────

/// A workspace's rotation. No row means the defaults: off, intake off.
model RotationSettings {
  workspaceId       String    @id @map("workspace_id") @db.Uuid
  enabled           Boolean   @default(false)
  /// When rotation was last switched on: lapses are measured from here, so an old backlog never rotates at once.
  enabledAt         DateTime? @map("enabled_at") @db.Timestamptz
  /// Days past a missed cadence before the owner is warned.
  warnAfterDays     Int       @default(0) @map("warn_after_days")
  /// Days after the warning, still untouched, before the lead rotates.
  graceDays         Int       @default(7) @map("grace_days")
  /// Whether new unowned leads are dealt from the rotation.
  intakeEnabled     Boolean   @default(false) @map("intake_enabled")
  /// `prefer`, `require` or `ignore` a connected (or delegated) mailbox in who is dealt to.
  mailboxPreference String    @default("prefer") @map("mailbox_preference")
  /// A member holding this many open deals is skipped; null: no cap.
  openLeadCap       Int?      @map("open_lead_cap")
  /// The round-robin pointer: leads dealt so far. Read under `FOR UPDATE`.
  cursor            Int       @default(0)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("rotation_settings")
}

/// A member's place in the rotation, when it differs from the default (in unless an admin or a manager).
model RotationMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  memberId    String    @unique @map("member_id") @db.Uuid
  /// Null: the default for their role.
  included    Boolean?
  paused      Boolean   @default(false)
  /// When a pause ends by itself; the hourly job unpauses.
  resumeAt    DateTime? @map("resume_at") @db.Timestamptz
  /// How many turns they take in one round (1–5).
  weight      Int       @default(1)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("rotation_members")
}

/// One missed cadence of one deal under one owner: warned once, then resolved by a touch or rotated once. At most
/// one open (unresolved) per deal — the partial unique index `cadence_lapses_open_key` in the migration.
model CadenceLapse {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  opportunityId String    @map("opportunity_id") @db.Uuid
  ownerMemberId String    @map("owner_member_id") @db.Uuid
  stageName     String    @map("stage_name")
  cadenceDays   Int       @map("cadence_days")
  lastTouchAt   DateTime  @map("last_touch_at") @db.Timestamptz
  dueAt         DateTime  @map("due_at") @db.Timestamptz
  warnedAt      DateTime  @map("warned_at") @db.Timestamptz
  rotateAt      DateTime  @map("rotate_at") @db.Timestamptz
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz
  /// `touched`, `closed`, `owner_changed`, `out_of_scope` or `rotated`.
  resolution    String?
  transferId    String?   @map("transfer_id") @db.Uuid
  /// Why a due rotation waits (`no_eligible_member`); retried every hour.
  blockedReason String?   @map("blocked_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity   Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  owner         WorkspaceMember    @relation(fields: [ownerMemberId], references: [id], onDelete: Cascade)
  transfer      OwnershipTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([workspaceId, rotateAt])
  @@index([opportunityId])
  @@map("cadence_lapses")
}

/// Workspaces that share one set of leads: a primary email one has as a customer or prospect (the point
/// of contact of an open or won deal) cannot be saved in another; a cold lead may be saved in both, and
/// a person in the trash holds nothing. Kept by the `people_lead_pool_claim` trigger.
model LeadPool {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspaces Workspace[]
  addresses  LeadPoolAddress[]

  @@map("lead_pools")
}

/// A live person's primary email in a pooled workspace, cold or not. Written only by the trigger and `link-lead-pool`.
model LeadPoolAddress {
  personId    String @id @map("person_id") @db.Uuid
  poolId      String @map("pool_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  email       String

  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  pool      LeadPool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([poolId, email])
  @@index([workspaceId])
  @@map("lead_pool_addresses")
}
