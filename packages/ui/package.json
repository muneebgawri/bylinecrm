{
    "name": "@bylinecrm/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "description": "BylineCRM design system: tokens, Tailwind theme, components. Consumed from source by Vite apps.",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./toaster": {
            "types": "./src/components/toast/Toaster.tsx",
            "default": "./src/components/toast/Toaster.tsx"
        },
        "./styles.css": "./src/styles.css",
        "./tokens.css": "./src/tokens.css",
        "./theme.css": "./src/theme.css",
        "./popover": {
            "types": "./src/components/popover/Popover.tsx",
            "default": "./src/components/popover/Popover.tsx"
        }
    },
    "scripts": {
        "lint": "eslint \"src/**/*.{ts,tsx}\" \".storybook/**/*.{ts,tsx}\" \"gates/**/*.{ts,mjs}\" --max-warnings 0",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "storybook": "storybook dev -p 6006 --no-open",
        "build-storybook": "storybook build --quiet",
        "test:a11y": "playwright test -c gates/playwright.config.ts --project a11y",
        "test:layout": "playwright test -c gates/playwright.config.ts --project layout",
        "test:visual": "playwright test -c gates/playwright.config.ts --project visual",
        "test:visual:update": "playwright test -c gates/playwright.config.ts --project visual --update-snapshots",
        "visual:baseline": "node ../../scripts/visual-baseline.mjs --job visual-baseline --artifact visual-baselines --dir packages/ui/__snapshots__"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "dependencies": {
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dialog": "^1.2.0",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-popover": "^1.2.0",
        "@radix-ui/react-select": "^2.3.8",
        "@radix-ui/react-slot": "^1.4.0",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-toast": "^1",
        "@radix-ui/react-toggle-group": "^1.1.20",
        "@radix-ui/react-tooltip": "^1.2.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.53.0",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@bylinecrm/eslint-config": "workspace:*",
        "@playwright/test": "^1.64.0",
        "@storybook/react-vite": "^10.6.1",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.2",
        "axe-playwright": "^2.2.2",
        "eslint": "^9.39.4",
        "jsdom": "^28.1.0",
        "playwright": "^1.64.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sirv-cli": "^3.0.1",
        "storybook": "^10.6.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^8.3.4",
        "vitest": "^4.1.11"
    }
}
