# Copy to .env. Every variable is required; the API refuses to boot on a missing one.
DATABASE_URL=postgresql://bylinecrm:bylinecrm@127.0.0.1:5441/bylinecrm
# The restricted role every tenant query runs as; created by `pnpm --filter api db:setup`.
RLS_DATABASE_URL=postgresql://bylinecrm_app:bylinecrm_app@127.0.0.1:5441/bylinecrm
REDIS_URL=redis://127.0.0.1:6391
PORT=3300
WEB_PORT=3301
# The API's public URL (OIDC redirect URIs are built from it; https: makes cookies Secure) and the web app's.
APP_URL=http://localhost:3300
WEB_URL=http://localhost:3301
# Optional: Google sign-in (identity only). Set both or neither.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: JSON array of OIDC issuers, e.g. [{"key":"newswireos","issuerUrl":"https://…","clientId":"…","clientSecret":"…"}]
# OIDC_ISSUERS=
# Where `pnpm mock:api` serves the frozen contract (apps/api/openapi.json) for UI work.
MOCK_API_PORT=3310
