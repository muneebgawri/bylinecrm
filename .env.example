# Copy to .env. Every variable is required; the API refuses to boot on a missing one.
DATABASE_URL=postgresql://bylinecrm:bylinecrm@127.0.0.1:5441/bylinecrm
# The restricted role every tenant query runs as; created by `pnpm --filter api db:setup`.
RLS_DATABASE_URL=postgresql://bylinecrm_app:bylinecrm_app@127.0.0.1:5441/bylinecrm
REDIS_URL=redis://127.0.0.1:6391
PORT=3300
WEB_PORT=3301
# The API's public URL (OIDC redirect URIs are built from it; https: makes cookies Secure) and the web app's.
APP_URL=http://localhost:3300
WEB_URL=http://localhost:3301
# Optional: Google sign-in (identity only). Set both or neither.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional: JSON array of OIDC issuers, e.g. [{"key":"newswireos","issuerUrl":"https://…","clientId":"…","clientSecret":"…"}]
# OIDC_ISSUERS=
# Where `pnpm mock:api` serves the frozen contract (apps/api/openapi.json) for UI work.
MOCK_API_PORT=3310

# Attachment bytes (P1-1b). Relative to the repo root; git-ignored. An S3 driver replaces the path later, not the variable.
FILE_STORAGE_ROOT=.data/attachments

# Secrets at rest (P1-5): 32 random bytes, base64 — `openssl rand -base64 32`. Webhook signing secrets are sealed with it.
SECRETS_KEY=
# Webhooks (P1-5): run the delivery worker in this process (1) or leave it to a worker process (0).
WEBHOOK_WORKER=1
# Allow webhook endpoints on private/loopback addresses — local receivers only; never in production.
WEBHOOK_ALLOW_PRIVATE_TARGETS=1
# Mail sync (P2-2): run the Gmail sync worker in this process (1) or leave it to a worker process (0).
MAIL_SYNC_WORKER=1
# Sending (P2-3): run the Gmail send worker in this process (1) or leave it to a worker process (0).
MAIL_SEND_WORKER=1
# Per-statement query events on the tenant client (P1-4a) — a test instrument; the test suites set it themselves. Keep 0.
DB_QUERY_EVENTS=0

# Who may sign up (P0-14): closed (default — nobody; platform admins create workspaces and invite owners),
# invite (sign-up needs a platform sign-up invitation) or open (anyone). Local development uses open.
SIGNUP_MODE=open
# Platform admins: comma-separated addresses, matched against a signed-in user's VERIFIED email on every
# request. Empty means none — then, in closed mode, nobody can create a workspace through the API.
# PLATFORM_ADMIN_EMAILS=
