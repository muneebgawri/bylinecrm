{
    "$schema": "https://turbo.build/schema.json",
    "agentGuidance": false,
    "globalDependencies": [".env"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "lint": {},
        "test": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build-storybook": {
            "dependsOn": ["^build"],
            "outputs": ["storybook-static/**"]
        },
        "test:a11y": {
            "dependsOn": ["build-storybook"],
            "cache": false
        },
        "test:visual": {
            "dependsOn": ["build-storybook"],
            "cache": false
        }
    }
}
