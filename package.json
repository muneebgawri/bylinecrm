{
    "name": "bylinecrm",
    "version": "0.0.0",
    "private": true,
    "description": "BylineCRM — a decoupled, multi-tenant CRM service.",
    "packageManager": "pnpm@9.15.0",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "test": "turbo test --concurrency=1",
        "typecheck": "turbo typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "scan:licences": "node scripts/licence-scan.mjs",
        "scan:identifiers": "node scripts/identifier-scan.mjs",
        "mock:api": "node --env-file=.env scripts/mock-api.mjs",
        "prepare": "husky",
        "storybook": "pnpm --filter @bylinecrm/ui storybook",
        "build-storybook": "turbo build-storybook",
        "test:a11y": "turbo test:a11y",
        "test:visual": "turbo test:visual",
        "test:deploy": "bash deploy/staging/test/release-preflight.test.sh",
        "images:check": "node scripts/check-image-refs.mjs",
        "test:scripts": "node --test scripts/check-image-refs.test.mjs scripts/lib/wait-for-run.test.mjs"
    },
    "devDependencies": {
        "@bylinecrm/eslint-config": "workspace:*",
        "@stoplight/prism-cli": "^5.14.2",
        "eslint": "^9.39.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "pg": "^8.16.3",
        "prettier": "^3.9.9",
        "turbo": "^2.11.7"
    },
    "lint-staged": {
        "**/*.{ts,tsx,mts,mjs}": [
            "prettier --write",
            "eslint --fix --no-warn-ignored --max-warnings 0 --flag v10_config_lookup_from_file"
        ],
        "**/*.{json,yml,yaml,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@bylinecrm/shared": "workspace:*"
    }
}
